    format Date_loaded date9.;
    Time          = timepart(Distribution_date);
    format Time time9.;
    Delivery_code = UPCASE(Delivery_code);
  run;
%end;
%else %do;
  /* F02 fallback: Distribution_date is already a plain SAS date */
  %put WARNING: Distribution_date treated as plain date (not datetime).;
  %put WARNING: Time will be set to 0 (midnight). Verify this is correct.;
  data APNS_sends_campaigns (keep=cust_no ucn mucn product_code Date_loaded
                                  Time Drop_reason brand Delivery_code);
    set APNS.apn_sends_and_feedback;
