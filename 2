/* ============================================================
   SECTION 0: DIAGNOSTIC HELPER MACRO
   F01/F02/F03/F04 - Run before any filtering to confirm the
   source tables are healthy and product codes actually match.
   If this fires warnings, the sends/drops tables WILL be empty.
   ============================================================ */

%macro diag_source_table(lib_ds=, date_col=, is_datetime=1, label=);
  %put NOTE: =====================================================;
  %put NOTE: DIAGNOSTIC: &label (&lib_ds);
  %put NOTE: =====================================================;

  /* Does the table/view exist at all? */
  %if %sysfunc(exist(&lib_ds)) = 0 %then %do;
    %put ERROR: DIAG - &lib_ds does not exist or view is broken.;
    %put ERROR: Check the APNS libname and underlying physical path.;
    %return;
  %end;

  /* Row count and raw date range with NO filters */
  proc sql noprint;
    select count(*)  into :_d_rows    trimmed from &lib_ds;
    %if &is_datetime = 1 %then %do;
      select min(datepart(&date_col)) into :_d_mindt trimmed from &lib_ds;
      select max(datepart(&date_col)) into :_d_maxdt trimmed from &lib_ds;
    %end;
    %else %do;
      select min(&date_col) into :_d_mindt trimmed from &lib_ds;
      select max(&date_col) into :_d_maxdt trimmed from &lib_ds;
    %end;
  quit;

  %put NOTE: DIAG &label - Total rows (no filter): &_d_rows;
  %put NOTE: DIAG &label - Date range            : &_d_mindt to &_d_maxdt;

  %if &_d_rows = 0 %then %do;
    %put ERROR: DIAG - &lib_ds is completely empty. No filter will fix this.;
    %put ERROR: Check the underlying data feed / ETL for &label;
    %return;
  %end;

  /* F01/F02: Check how many rows match product_codes BEFORE date filter */
  proc sql noprint;
    select count(*) into :_d_prod_rows trimmed
    from &lib_ds
    where upcase(strip(product_code)) in
      (select upcase(strip(value))
       from (values
         %let _i = 1;
         /* Build a values list from the macro variable - cannot use &product_codes
            directly in a nested select, so we use a pass-through approach */
         ("dummy")  /* placeholder - see inline check below */
       ));
  quit;
  /* Simplified product match check using actual macro var */
  proc sql noprint;
    select count(*) into :_d_prod_rows trimmed
    from &lib_ds
    where upcase(strip(product_code)) in
      (%sysfunc(tranwrd(%upcase(&product_codes),%str( ),%str())));
  quit;

  %put NOTE: DIAG &label - Rows matching product_codes (no date filter): &_d_prod_rows;

  %if &_d_prod_rows = 0 %then %do;
    %put ERROR: DIAG - ZERO rows match product_codes in &lib_ds.;
    %put ERROR: Root cause is almost certainly one of:;
    %put ERROR:   1) product_code values in source have different case or whitespace;
    %put ERROR:   2) product_code column has trailing spaces / different length;
    %put ERROR:   3) The product codes in the macro var are wrong;
    %put ERROR: Run: proc sql%str(;) select distinct product_code from &lib_ds%str(;) quit%str(;);
    %put ERROR: and compare manually to the product_codes macro variable.;
  %end;

%mend;


