proc sql;
  create table adobe_leads as
  select count(*) as adobe_leads,
         product_code, sub_segment, campaign_name, date_to_adobe, optimize
  from   campaigns_to_adobe_step
  group by product_code, sub_segment, campaign_name, date_to_adobe, optimize
  order by date_to_adobe;
quit;

proc sql;
  create table leads_summary as
  select sum(adobe_leads) as Leads_Total,
         product_code, campaign_name, date_to_adobe, optimize
  from   adobe_leads
  group by product_code, campaign_name, date_to_adobe, optimize;
quit;

proc sql;
  create table adobe_summary_client as
  select count(product_code) as Client_Sent,
         product_code, date_loaded, drop_reason
  from   adobe_to_clients_final
  group by product_code, date_loaded, drop_reason;
quit;

proc sql;
  create table optimize_adobe_sum as
  select *
  from   leads_summary a
  left join adobe_summary_client b
    on  a.product_code = b.product_code
  /* FIX: Adobe loads happen AFTER the optimise date (not before).
     Original had the range backwards: between date_loaded and date_loaded-5
     which always evaluated to an empty or negative range. */
  where b.date_loaded between a.date_to_adobe and a.date_to_adobe + 5
     or b.date_loaded is null
  order by date_to_adobe, date_loaded desc;
quit;

data optimize_adobe_sum_2;
  set optimize_adobe_sum;
  day_diff = intck('day', date_to_adobe, date_loaded);
run;

proc sql;
  create table optimize_adobe_sum_3 as
  select *
  from   optimize_adobe_sum_2
  group  by product_code, date_to_adobe
  having intck('day', date_to_adobe, date_loaded) =
         min(intck('day', date_to_adobe, date_loaded));
quit;


/* ============================================================
   SECTION 11: RENAME COLUMNS FOR FINAL JOIN
   ============================================================ */

data campaigns_to_adobe_renamed;
  set campaigns_to_adobe_step;
  rename Drop_Reason  = Drop_reason_to_adobe;
  rename mucn         = mucn_to_adobe;
  rename product_code = product_code_to_adobe;
run;

data adobe_to_clients_step2 (drop=success drop);
  set adobe_to_clients_final;
  /* Delivery_code logic: non-empty = Loaded, TEST = TEST, else = drop_reason */
  if      strip(upcase(delivery_code)) = "TEST" then Adobe  = "TEST";
  else if strip(delivery_code)        ne ""      then Adobe  = "Loaded";
  else                                                Adobe  = drop_reason;

  if      strip(upcase(delivery_code)) = "TEST" then Client = "TEST";
  else if strip(delivery_code)        ne ""      then Client = "Sent";
  else                                                Client = drop_reason;

  /* Prefer cust_no; fall back to UCN when cust_no is missing */
  if strip(cust_no) = "" then cust_no = UCN;
run;

proc sql;
  create table adobe_delivery_tes as
  select distinct Cust_no, date_loaded, product_code, "TEST" as testindicator
  from   adobe_to_clients_step2
  where  strip(upcase(delivery_code)) = "TEST";
quit;

proc sql;
  create table adobe_final as
  select a.*, b.testindicator
  from   adobe_to_clients_step2 a
  left join adobe_delivery_tes  b
    on  a.cust_no      = b.Cust_no
    and a.date_loaded  = b.date_loaded
    and a.product_code = b.product_code;
quit;

/* FIX: Original condition was broken:
     if testindicator ne "TEST" or testindicator = ""  then testindicator = "Actual"
   The "ne TEST OR = blank" logic is always true when testindicator IS "TEST" because
   "TEST" ne "TEST" is false but "TEST" = "" is also false - however padding issues
   in the original string literals caused erratic results.
   Simplified to: if not TEST -> Actual. */
data adobe_final_table_clients;
  set adobe_final;
  if strip(testindicator) ne "TEST" then testindicator = "Actual";
  if strip(testindicator)  = "TEST" then do;
    Adobe  = "TEST";
    Client = "TEST";
  end;
  rename cust_no = cust_no2;
run;


/* ============================================================
   SECTION 12: FINAL JOIN - OPTIMISE + ADOBE
   FIX: The original BETWEEN clause had the range backwards:
        a.date_to_adobe BETWEEN b.date_loaded AND b.date_loaded - 5
   This means date_to_adobe had to be between a date and 5 days
   BEFORE that date - a range that is always empty unless both
   dates are equal. The correct logic is: Adobe's load date must
   fall within 5 days AFTER the optimise date.
   ============================================================ */

proc sql;
  create table joining as
  select *
  from   campaigns_to_adobe_renamed a
  left join adobe_final_table_clients b
    on  a.cust_no              = b.cust_no2
    and a.product_code_to_adobe = b.product_code
    /* FIX: adobe date_loaded must be on or after date_to_adobe, within 5 days */
    and b.date_loaded between a.date_to_adobe and a.date_to_adobe + 5;
quit;

/* CHECK: Log join match rate */
proc sql noprint;
  select count(*)                    into :_join_total   trimmed from joining;
  select count(cust_no2)             into :_join_matched trimmed from joining where cust_no2 ne "";
quit;
%put NOTE: Join total rows   : &_join_total;
%put NOTE: Join matched rows : &_join_matched;

data APNS_DATA (drop=Time product_code mucn ucn mucn_to_adobe
                     success_to_adobe drop_to_adobe);
  set joining;
  /* Flag records sent to Optimise but not yet seen in Adobe */
  if strip(Cust_no2) = "" and strip(Optimize) = "Sent" then do;
    if intck('day', date_to_adobe, today()) <= 5
      then Adobe = "Sending to Adobe";
    else      Adobe = "Not loaded into Adobe within 5 days";
  end;
  date_Diff = intck('day', date_to_adobe, date_loaded);
run;

proc sort data=APNS_DATA;
  by descending date_loaded Date_to_adobe;
run;

/* Deduplicate: keep only the row with the earliest adobe load date per customer/product/date */
proc sql;
  create table APNS_Data_Final as
  select a.*
  from   APNS_DATA a
  inner join (
    select cust_no, product_code_to_adobe, date_to_adobe,
           min(date_loaded) as min_date_loaded format date9.
    from   APNS_DATA
    where  date_to_adobe ne date_loaded
       or  date_loaded is null
    group by cust_no, product_code_to_adobe, date_to_adobe
  ) as b
    on  a.date_to_adobe        = b.date_to_adobe
    and a.cust_no               = b.cust_no
    and a.product_code_to_adobe = b.product_code_to_adobe
    /* Include unmatched rows (date_loaded null) to preserve "Sending to Adobe" records */
    and (a.date_loaded = b.min_date_loaded or a.date_loaded is null);
quit;

data APNS_DATA;
  set APNS_Data_Final;
  drop min_date_loaded;
run;

/* CHECK: Row count after deduplication */
proc sql noprint;
  select count(*)           into :_final_rows     trimmed from APNS_DATA;
  select max(date_to_adobe) into :_final_max_date trimmed from APNS_DATA;
quit;
%put NOTE: APNS_DATA after dedup - rows    : &_final_rows;
%put NOTE: APNS_DATA after dedup - max date: &_final_max_date;


/* ============================================================
   SECTION 13: LOAD TO PRODUCTION - WITH FULL SAFETY GATES
   Checks (in order):
     1. Work table exists
     2. Row count > 0
     3. Max date in new data is NOT earlier than max date in prod
        (date regression guard - prevents overwriting good data
         with stale output caused by broken join logic)
   ============================================================ */

%macro Loadtable(Table);

  %if %sysfunc(exist(&table.)) %then %do;

    /* CHECK 1: row count */
    proc sql noprint;
      select count(*) into :new_row_count trimmed from &Table.;
    quit;

    %if &new_row_count = 0 %then %do;
      %put ERROR: =====================================================;
      %put ERROR: &Table. has ZERO rows - aborting production load.;
      %put ERROR: STI_PBI.&Table. has NOT been updated.;
      %put ERROR: Check campaign config, date extraction and joins.;
      %put ERROR: =====================================================;
      data _null_; abort return 1; run;
    %end;

    /* CHECK 2: date regression guard */
    proc sql noprint;
      select max(date_to_adobe) into :_prod_max_date trimmed
      from STI_PBI.&Table.;

      select max(date_to_adobe) into :_new_max_date trimmed
      from &Table.;
    quit;

    %if %sysevalf(&_new_max_date < &_prod_max_date) %then %do;
      %put ERROR: =====================================================;
      %put ERROR: DATE REGRESSION DETECTED in &Table.;
      %put ERROR: New max date  : &_new_max_date;
      %put ERROR: Prod max date : &_prod_max_date;
      %put ERROR: The new data is OLDER than what is already in prod.;
      %put ERROR: STI_PBI.&Table. has NOT been updated.;
      %put ERROR: Most likely cause: join range in Section 12.;
      %put ERROR: =====================================================;
      data _null_; abort return 1; run;
    %end;

    /* All checks passed - load to prod */
    %put NOTE: &Table. passed all checks (&new_row_count rows, max date &_new_max_date) - loading to production.;
    proc sql;
      drop table STI_PBI.&Table.;
      create table STI_PBI.&Table. as
      select * from &Table.;
    quit;
    %put NOTE: STI_PBI.&Table. updated successfully.;

  %end;
  %else %do;
    %put ERROR: Work table &Table. does not exist - cannot load to production.;
    data _null_; abort return 1; run;
  %end;

%mend;

%Loadtable(APNS_DATA);


/* ============================================================
   SECTION 14: CAPTURE POST-RUN STATE
   ============================================================ */

proc sql outobs=1;
  create table datetime_new as
  select  date_to_adobe            as Date format date9.,
          time_created_to_adobe    as time format time9.
  from    STI_PBI.APNS_DATA
  where   time_created_to_adobe
              in (select max(time_created_to_adobe)
                  from STI_PBI.APNS_DATA
                  where date_to_adobe in
                      (select max(date_to_adobe)
                       from STI_PBI.APNS_DATA));
run;

proc sql noprint;
  select count(cust_no) into :New_records trimmed from STI_PBI.APNS_DATA;
quit;

proc sql noprint;
  select date format date9.,
         time format time9.
  into   :New_date trimmed,
         :New_time trimmed
  from   datetime_new;
quit;

%let Diff_Records = %sysevalf(&New_records - &Old_records);

%put NOTE: Post-run record count : &New_records;
%put NOTE: Post-run max date     : &New_date;
%put NOTE: Post-run max time     : &New_time;
%put NOTE: Record difference     : &Diff_Records;


/* ============================================================
   SECTION 15: EMAIL NOTIFICATION
   Conditions (evaluated top-to-bottom, first match wins):
     A. Date regression  - new max date is earlier than old max date
     B. No update        - date and time both unchanged
     C. Updated          - date OR time changed (normal success case)
     D. Table missing    - STI_PBI.APNS_DATA does not exist (failsafe)
   ============================================================ */

%macro EMAIL;

  /* --------------------------------------------------------
     A. DATE REGRESSION - new data is older than what was
        already in production. This should have been caught
        by the Loadtable gate, but included here as a
        belt-and-braces notification safety net.
     -------------------------------------------------------- */
  %if %sysevalf(&New_date < &Old_date) %then %do;

    FILENAME EML EMAIL
      to      = "Morris.Nkomo@fnb.co.za"
      cc      = "dlfnbstioperationalanalytics@fnb.co.za"
      from    = 'dlfnbstioperationalanalytics@fnb.co.za'
      subject = "WARNING: APNS Date Regression Detected";
    DATA _NULL_;
      FILE EML;
      PUT "Hi,";
      PUT " ";
      PUT "WARNING: The APNS script completed but the max date in the";
      PUT "production table is now EARLIER than it was before the run.";
      PUT "This indicates a date regression - the join logic may be";
      PUT "returning stale data. The table may have been overwritten";
      PUT "with older records. Please investigate immediately.";
      PUT " ";
      PUT "Max Date before run : &Old_date (&Old_time)";
      PUT "Max Date after run  : &New_date (&New_time)";
      PUT "Records before run  : &Old_records";
      PUT "Records after run   : &New_records";
      PUT "Record difference   : &Diff_Records";
      PUT " ";
      PUT "Likely cause: join BETWEEN range in Section 12.";
      PUT "Check the log for further detail.";
      PUT " ";
      PUT "The APN Dashboard should NOT be refreshed until investigated.";
      PUT " ";
      PUT "Kind Regards";
      PUT "Morris";
    RUN;

  %end;

  /* --------------------------------------------------------
     B. NO UPDATE - dates and times are identical before/after
     -------------------------------------------------------- */
  %else %if &Old_date = &New_date and &Old_time = &New_time %then %do;

    FILENAME EML EMAIL
      to   = "Morris.Nkomo@fnb.co.za"
      cc   = "dlfnbstioperationalanalytics@fnb.co.za"
      from = 'dlfnbstioperationalanalytics@fnb.co.za'
      subject = "INFO: APNS Script Ran - No Table Update";
    DATA _NULL_;
      FILE EML;
      PUT "Hi,";
      PUT " ";
      PUT "The APNS script ran but no new data was loaded.";
      PUT "The production table is unchanged. Please check the";
      PUT "log for any warnings or failures.";
      PUT " ";
      PUT "Max Date before run : &Old_date (&Old_time)";
      PUT "Max Date after run  : &New_date (&New_time)";
      PUT "Records before run  : &Old_records";
      PUT "Records after run   : &New_records";
      PUT "Record difference   : &Diff_Records";
      PUT " ";
      PUT "The APN Dashboard does not require refreshing.";
      PUT " ";
      PUT "Kind Regards";
      PUT "Morris";
    RUN;

  %end;

  /* --------------------------------------------------------
     C. SUCCESSFUL UPDATE - date or time has moved forward
     -------------------------------------------------------- */
  %else %if &Old_date ne &New_date or &Old_time ne &New_time %then %do;

    FILENAME EML EMAIL
      to      = "Morris.Nkomo@fnb.co.za"
      cc      = "dlfnbstioperationalanalytics@fnb.co.za"
      from    = 'dlfnbstioperationalanalytics@fnb.co.za'
      subject = "SUCCESS: APNS Script Ran - Table Updated";
    DATA _NULL_;
      FILE EML;
      PUT "Hi,";
      PUT " ";
      PUT "The APNS script ran successfully and the table was updated.";
      PUT " ";
      PUT "Max Date before run : &Old_date (&Old_time)";
      PUT "Max Date after run  : &New_date (&New_time)";
      PUT "Records before run  : &Old_records";
      PUT "Records after run   : &New_records";
      PUT "New records added   : &Diff_Records";
      PUT " ";
      PUT "The APN Dashboard can be refreshed.";
      PUT " ";
      PUT "Kind Regards";
      PUT "Morris";
    RUN;

  %end;

  /* --------------------------------------------------------
     D. TABLE MISSING - failsafe, should not be reached if
        the early-abort at Section 1 fired correctly
     -------------------------------------------------------- */
  %else %if %sysfunc(exist(STI_PBI.APNS_DATA)) = 0 %then %do;

    FILENAME EML EMAIL
      to      = "Morris.Nkomo@fnb.co.za"
      cc      = "dlfnbstioperationalanalytics@fnb.co.za"
      from    = 'dlfnbstioperationalanalytics@fnb.co.za'
      subject = "WARNING: APNS_DATA Table Missing";
    DATA _NULL_;
      FILE EML;
      PUT "Good Day,";
      PUT " ";
      PUT "Kindly note that the STI_PBI.APNS_DATA table is missing.";
      PUT "Currently investigating the problem.";
      PUT " ";
      PUT "Kind Regards,";
      PUT "Morris";
    RUN;

  %end;

%mend email;

