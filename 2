/* Quick check - run this standalone */
proc sql;
  select distinct product_code
  from APNS.apn_sends_and_feedback
  where datepart(Distribution_date) >= '01JAN2024'd
  order by product_code;
quit;

proc sql;
  select count(*) as total_rows,
         min(datepart(Distribution_date)) as min_date format date9.,
         max(datepart(Distribution_date)) as max_date format date9.,
         count(distinct product_code)     as distinct_products
  from APNS.apn_sends_and_feedback;
quit;
