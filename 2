/*==============================================================
  FILE: OCR_Aged_Debug.sas
  PURPOSE: Troubleshoot aged claims logic only.
  Run this standalone to verify the cutoff date and counts.
==============================================================*/

/*--- Set run date (change this to test different dates) ---*/
%let rd = %sysfunc(today(), yymmddn8.);

/*--- Convert to SAS date and calculate 3-month cutoff ---*/
%let sas_rd       = %sysfunc(inputn(&rd., yymmddn8.));
%let aged_cutoff  = %sysfunc(intnx(month, &sas_rd., -3, B));

%put NOTE: Run date (raw)     = &rd.;
%put NOTE: Run date (SAS num) = &sas_rd.;
%put NOTE: Run date (formatted) = %sysfunc(putn(&sas_rd., date9.));
%put NOTE: Aged cutoff (SAS num) = &aged_cutoff.;
%put NOTE: Aged cutoff (formatted) = %sysfunc(putn(&aged_cutoff., date9.));
%put NOTE: ----------------------------------------------------;
%put NOTE: Claims with ReportedMonth BEFORE &aged_cutoff. will be flagged.;
%put NOTE: e.g. if today is April 2026, cutoff = 01JAN2026;
%put NOTE: So December 2025 claims WILL be flagged. Correct.;

/*--------------------------------------------------------------
  Step 1: Show what ReportedMonth values exist in your data
  so you can see if the format is date vs YYYYMM number etc.
--------------------------------------------------------------*/
proc sql;
  create table work.debug_month_values as
  select distinct
      ReportedMonth,
      put(ReportedMonth, date9.)   as ReportedMonth_Date9   length=12,
      put(ReportedMonth, yymmn6.)  as ReportedMonth_YYMMN6  length=7,
      put(ReportedMonth, best12.)  as ReportedMonth_Numeric length=12
  from work.MotorClaims_Final
  order by ReportedMonth;
quit;

title "DEBUG: Distinct ReportedMonth values and formats";
proc print data=work.debug_month_values noobs; run;
title;

/*--------------------------------------------------------------
  Step 2: Show the cutoff as the same formats so you can compare
--------------------------------------------------------------*/
data work.debug_cutoff;
  aged_cutoff_raw     = &aged_cutoff.;
  aged_cutoff_date9   = put(&aged_cutoff., date9.);
  aged_cutoff_yymmn6  = put(&aged_cutoff., yymmn6.);
  aged_cutoff_numeric = put(&aged_cutoff., best12.);
  sas_rd_raw          = &sas_rd.;
  sas_rd_date9        = put(&sas_rd., date9.);
run;

title "DEBUG: Cutoff date in various formats";
proc print data=work.debug_cutoff noobs; run;
title;

/*--------------------------------------------------------------
  Step 3: Apply the filter and show what gets caught
--------------------------------------------------------------*/
proc sql;
  create table work.debug_aged_claims as
  select
      ClaimCode,
      ReportedMonth,
      put(ReportedMonth, date9.)  as ReportedMonth_Fmt length=12,
      Current_Estimate_OCR,
      ClaimHandler,
      case when ReportedMonth < &aged_cutoff. then 'AGED' else 'OK' end as Flag length=5
  from work.MotorClaims_Final
  order by ReportedMonth;
quit;

title "DEBUG: All claims with AGED flag (ReportedMonth < cutoff = aged)";
proc print data=work.debug_aged_claims noobs; run;
title;

/*--------------------------------------------------------------
  Step 4: Count — this is what the main job uses
--------------------------------------------------------------*/
proc sql;
  select
      count(distinct ClaimCode) as Total_Claims,
      count(distinct case when ReportedMonth < &aged_cutoff.
                          then ClaimCode end) as Aged_Claims,
      put(&aged_cutoff., date9.) as Cutoff_Date length=12
  from work.MotorClaims_Final;
quit;

title "DEBUG: Aged claim count vs total";
proc print; run;
title;
