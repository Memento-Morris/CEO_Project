/*=====================================================================
  OBR VIEW GENERATION PIPELINE
  ------------------------------------------------------------
  Generates three deliverables from RET.AgentEarn / TLEarn /
  ManagementEarn tables:

    1. Agent_OBR_Pack_<month>.xlsx    - per-agent reflection sheets
    2. TL_Coaching_Pack_<month>.xlsx  - team roster + coaching priorities
    3. Manager_Overview_Pack_<month>.xlsx - team-of-teams + payout summary

  Author: Morris | Growth Analytics
  Depends on: RET libname pointing to RetentionsOBR folder
=====================================================================*/

%LET RPT_MONTH  = '30JUN2026'D;
%LET RPT_LABEL  = Jun2026;
%LET OUT_PATH   = /home/f8884560/OBR_Views;

LIBNAME RET '/data/fnbins/fnbinsurance/Collections/Data/ST Retentions/RetentionsOBR/';

/*---------------------------------------------------------------------
  STEP 1 - STACK + STANDARDISE THE THREE TABLES
---------------------------------------------------------------------*/
DATA AgentEarn_all;
    SET RET.AgentEarn_: INDSNAME=src;
    LENGTH source_ds $41;
    source_ds = src;
    IF Desk = 'Emails' THEN Desk = 'Email';
RUN;

DATA TLEarn_all;
    SET RET.TLEarn_: INDSNAME=src;
    source_ds = src;
RUN;

DATA MgmtEarn_all;
    SET RET.ManagementEarn_: INDSNAME=src;
    WHERE _N_ IS NOT MISSING AND Name IS NOT MISSING;
    source_ds = src;
RUN;

/*---------------------------------------------------------------------
  STEP 2 - COMPUTE DERIVED FIELDS
  Rating band and next-tier thresholds, plus contribution per component.
---------------------------------------------------------------------*/
PROC FORMAT;
    VALUE ratingband
        LOW  - < 2.0  = 'SIR'
        2.0  - < 3.0  = 'IR'
        3.0  - < 4.0  = 'ME'
        4.0  - < 4.7  = 'EE'
        4.7  - HIGH   = 'Exceptional';

    VALUE ratingfull
        LOW  - < 2.0  = 'Significant Improvement Required'
        2.0  - < 3.0  = 'Improvement Required'
        3.0  - < 4.0  = 'Meets Expectation'
        4.0  - < 4.7  = 'Exceeds Expectation'
        4.7  - HIGH   = 'Exceptional';
RUN;

DATA AgentEarn_scored;
    SET AgentEarn_all;

    /* Standard weightings */
    Effe_MaxContrib = 5 * 0.15 * 0.8;   /* 0.60 */
    Save_MaxContrib = 5 * 0.30 * 0.8;   /* 1.20 */
    FC_MaxContrib   = 5 * 0.30 * 0.8;   /* 1.20 */
    GWP_MaxContrib  = 5 * 0.25 * 0.8;   /* 1.00 */
    Comp_MaxContrib = 5 * 0.10 * 0.2;   /* 0.10 */
    Effo_MaxContrib = 5 * 0.45 * 0.2;   /* 0.45 */
    QA_MaxContrib   = 5 * 0.45 * 0.2;   /* 0.45 */

    /* Actual contribution = points * weight */
    Effe_Contrib = EffeScore * 0.15 * 0.8;
    Save_Contrib = SaveScore * 0.30 * 0.8;
    FC_Contrib   = FCScore   * 0.30 * 0.8;
    GWP_Contrib  = GWPScore  * 0.25 * 0.8;
    Comp_Contrib = CompScore * 0.10 * 0.2;
    Effo_Contrib = EffoScore * 0.45 * 0.2;
    QA_Contrib   = QAScore   * 0.45 * 0.2;

    /* Points lost per component - the coaching lens */
    Effe_Lost = Effe_MaxContrib - Effe_Contrib;
    Save_Lost = Save_MaxContrib - Save_Contrib;
    FC_Lost   = FC_MaxContrib   - FC_Contrib;
    GWP_Lost  = GWP_MaxContrib  - GWP_Contrib;
    Comp_Lost = Comp_MaxContrib - Comp_Contrib;
    Effo_Lost = Effo_MaxContrib - Effo_Contrib;
    QA_Lost   = QA_MaxContrib   - QA_Contrib;

    /* Rating labels */
    LENGTH Rating $12 RatingFull $32;
    Rating     = PUT(OverallScore, ratingband.);
    RatingFull = PUT(OverallScore, ratingfull.);

    /* Next-tier threshold */
    IF      OverallScore < 2.0 THEN NextThresh = 2.0;
    ELSE IF OverallScore < 3.0 THEN NextThresh = 3.0;
    ELSE IF OverallScore < 4.0 THEN NextThresh = 4.0;
    ELSE IF OverallScore < 4.7 THEN NextThresh = 4.7;
    ELSE                            NextThresh = .;
    IF NOT MISSING(NextThresh) THEN GapToNext = NextThresh - OverallScore;

    /* Desk grouping for earn rate rules */
    LENGTH DeskGroup $10;
    IF Desk IN ('Commercial - I','Commercial - O') THEN DeskGroup = 'Commercial';
    ELSE DeskGroup = Desk;

    /* Next-tier earn rate */
    IF NOT MISSING(NextThresh) THEN DO;
        IF NextThresh < 3.0 THEN NextRate = 0;
        ELSE IF NextThresh < 4.0 THEN DO;
            IF DeskGroup = 'Inbound' THEN NextRate = 0.05;
            ELSE NextRate = 0.08;
        END;
        ELSE IF NextThresh < 4.7 THEN DO;
            IF DeskGroup = 'Inbound' THEN NextRate = 0.06;
            ELSE NextRate = 0.09;
        END;
        ELSE DO;
            IF DeskGroup = 'Inbound' THEN NextRate = 0.08;
            ELSE NextRate = 0.10;
        END;

        PotentialUplift = (NextRate - EarnRate) * CollectedGWP;
    END;
RUN;

/*---------------------------------------------------------------------
  STEP 3 - BUILD THE THREE DELIVERABLES
---------------------------------------------------------------------*/

/* Filter to reporting month */
DATA AgentEarn_now;
    SET AgentEarn_scored;
    WHERE CampaignMonth = &RPT_MONTH;
RUN;

/*--- 3a. AGENT PACK - one sheet per agent -----------------*/
PROC SORT DATA=AgentEarn_now OUT=AgentEarn_srt;
    BY Name Product Desk;
RUN;

/* Summary table for cover sheet */
PROC SQL;
    CREATE TABLE AgentSummary AS
    SELECT Name AS Agent,
           Agent AS Fnumber,
           COUNT(*) AS Rows,
           MAX(OverallScore) AS BestScore,
           MAX(Rating) AS Rating,
           SUM(Earn) AS TotalEarn FORMAT=NLMNY16.2
    FROM AgentEarn_now
    GROUP BY Name, Agent
    ORDER BY BestScore DESC;
QUIT;

ODS EXCEL FILE="&OUT_PATH/Agent_OBR_Pack_&RPT_LABEL..xlsx"
    OPTIONS(SHEET_INTERVAL='NONE'
            EMBEDDED_TITLES='YES'
            FLOW='TABLES');

/* Cover sheet */
ODS EXCEL OPTIONS(SHEET_NAME='Summary');
TITLE1 "AGENT OBR PACK - %SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))";
TITLE2 "One reflection pack per agent - see individual sheets";
PROC PRINT DATA=AgentSummary NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
    VAR Agent Fnumber Rows BestScore Rating TotalEarn;
RUN;
TITLE;

/* Per-agent scorecard grid */
%MACRO agent_sheet(agent_fnum, agent_name);
    ODS EXCEL OPTIONS(SHEET_NAME="%SUBSTR(&agent_name,1,%SYSFUNC(MIN(28,%LENGTH(&agent_name))))");

    TITLE1 "OBR RECEIPT - &agent_name";
    TITLE2 "Employee ID: &agent_fnum   |   Period: %SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))";

    /* This month summary */
    PROC PRINT DATA=AgentEarn_now NOOBS LABEL
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
        WHERE Agent = "&agent_fnum";
        VAR Product Desk OverallScore RatingFull EarnRate CollectedGWP Earn;
        FORMAT OverallScore 5.2 EarnRate PERCENT8.0
               CollectedGWP Earn NLMNY16.2;
        LABEL OverallScore = 'Overall Score'
              RatingFull   = 'Rating'
              EarnRate     = 'Earn Rate'
              CollectedGWP = 'Collected GWP'
              Earn         = 'Earn (share)';
    RUN;

    /* Scorecard breakdown - top row */
    PROC SQL NOPRINT;
        SELECT Product, Desk INTO :top_prod, :top_desk
        FROM AgentEarn_now
        WHERE Agent = "&agent_fnum"
        ORDER BY OverallScore DESC;
    QUIT;

    /* Scorecard grid */
    DATA scorecard_&agent_fnum.;
        SET AgentEarn_now;
        WHERE Agent = "&agent_fnum" AND Product = "&top_prod" AND Desk = "&top_desk";
        LENGTH RowLabel $22;
        RowLabel = 'Target';
        c_Effe = '100%'; c_Save = '50%/32%'; c_FC = '80%'; c_GWP = 'R160k/R120k';
        c_Comp = '0'; c_Effo = '90%'; c_QA = '90%'; c_Score = ''; c_Rating = '';
        OUTPUT;
        RowLabel = 'Weighting';
        c_Effe = '15%'; c_Save = '30%'; c_FC = '30%'; c_GWP = '25%';
        c_Comp = '10%'; c_Effo = '45%'; c_QA = '45%'; c_Score = ''; c_Rating = '';
        OUTPUT;
        RowLabel = 'Actual Result';
        c_Effe = PUT(Effectiveness, PERCENT9.2);
        c_Save = PUT(SaveRatio, PERCENT9.2);
        c_FC   = PUT(FirstCollPerc, PERCENT9.2);
        c_GWP  = CATS('R ', PUT(RetainedGWP, COMMA14.2));
        c_Comp = PUT(Complaints, BEST.);
        c_Effo = PUT(EffortScore, PERCENT9.2);
        c_QA   = PUT(QA, PERCENT9.2);
        c_Score = ''; c_Rating = '';
        OUTPUT;
        RowLabel = 'Points (1-5)';
        c_Effe = PUT(EffeScore, 1.);
        c_Save = PUT(SaveScore, 1.);
        c_FC   = PUT(FCScore,   1.);
        c_GWP  = PUT(GWPScore,  1.);
        c_Comp = PUT(CompScore, 1.);
        c_Effo = PUT(EffoScore, 1.);
        c_QA   = PUT(QAScore,   1.);
        c_Score = PUT(OverallScore, 5.2);
        c_Rating = RatingFull;
        OUTPUT;
        RowLabel = 'Contribution to Score';
        c_Effe = PUT(Effe_Contrib, 4.2);
        c_Save = PUT(Save_Contrib, 4.2);
        c_FC   = PUT(FC_Contrib,   4.2);
        c_GWP  = PUT(GWP_Contrib,  4.2);
        c_Comp = PUT(Comp_Contrib, 4.2);
        c_Effo = PUT(Effo_Contrib, 4.2);
        c_QA   = PUT(QA_Contrib,   4.2);
        c_Score = PUT(OverallScore, 5.2);
        c_Rating = '';
        OUTPUT;
        KEEP RowLabel c_:;
    RUN;

    TITLE3 "SCORECARD - &top_prod / &top_desk";
    PROC REPORT DATA=scorecard_&agent_fnum. NOWD
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
        COLUMN RowLabel c_Effe c_Save c_FC c_GWP c_Comp c_Effo c_QA c_Score c_Rating;
        DEFINE RowLabel / DISPLAY ' ' STYLE=[FONTWEIGHT=BOLD BACKGROUND=#F5E6DC];
        DEFINE c_Effe   / DISPLAY 'Effectiveness';
        DEFINE c_Save   / DISPLAY 'Save Ratio';
        DEFINE c_FC     / DISPLAY '1st Coll %';
        DEFINE c_GWP    / DISPLAY 'GWP Retained';
        DEFINE c_Comp   / DISPLAY 'Complaints';
        DEFINE c_Effo   / DISPLAY 'Effort Score';
        DEFINE c_QA     / DISPLAY 'QA';
        DEFINE c_Score  / DISPLAY 'Score';
        DEFINE c_Rating / DISPLAY 'Rating';
    RUN;

    /* Where you lost points - sorted by biggest gap */
    DATA reflect_&agent_fnum.;
        SET AgentEarn_now;
        WHERE Agent = "&agent_fnum" AND Product = "&top_prod" AND Desk = "&top_desk";
        LENGTH Component $18 CoachingNote $40;
        Component = 'Effectiveness'; Points = EffeScore; Earned = Effe_Contrib;
        MaxPossible = Effe_MaxContrib; Gap = Effe_Lost; OUTPUT;
        Component = 'Save Ratio';    Points = SaveScore; Earned = Save_Contrib;
        MaxPossible = Save_MaxContrib; Gap = Save_Lost; OUTPUT;
        Component = '1st Collection';Points = FCScore;   Earned = FC_Contrib;
        MaxPossible = FC_MaxContrib;   Gap = FC_Lost;   OUTPUT;
        Component = 'GWP Retained';  Points = GWPScore;  Earned = GWP_Contrib;
        MaxPossible = GWP_MaxContrib;  Gap = GWP_Lost;  OUTPUT;
        Component = 'Complaints';    Points = CompScore; Earned = Comp_Contrib;
        MaxPossible = Comp_MaxContrib; Gap = Comp_Lost; OUTPUT;
        Component = 'Effort Score';  Points = EffoScore; Earned = Effo_Contrib;
        MaxPossible = Effo_MaxContrib; Gap = Effo_Lost; OUTPUT;
        Component = 'QA';            Points = QAScore;   Earned = QA_Contrib;
        MaxPossible = QA_MaxContrib;   Gap = QA_Lost;   OUTPUT;
        KEEP Component Points Earned MaxPossible Gap;
    RUN;

    DATA reflect_&agent_fnum.;
        SET reflect_&agent_fnum.;
        LENGTH CoachingNote $40;
        IF Points >= 5      THEN CoachingNote = 'Maxed. Hold this.';
        ELSE IF Points >= 4 THEN CoachingNote = 'Strong. One more push for max.';
        ELSE IF Points >= 3 THEN CoachingNote = 'On target. Room to improve.';
        ELSE IF Points >= 2 THEN CoachingNote = 'Below target. Focus area.';
        ELSE                     CoachingNote = 'Critical. Address first.';
    RUN;

    PROC SORT DATA=reflect_&agent_fnum.; BY DESCENDING Gap; RUN;

    TITLE3 'WHERE YOU STAND';
    PROC PRINT DATA=reflect_&agent_fnum. NOOBS LABEL
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
        VAR Component Points Earned MaxPossible Gap CoachingNote;
        FORMAT Earned MaxPossible Gap 4.2;
        LABEL Component='Component' Points='Your Points'
              Earned='You Earned' MaxPossible='Max Possible'
              Gap='Gap' CoachingNote='Coaching Note';
    RUN;

    /* Trend view */
    PROC SQL;
        CREATE TABLE trend_&agent_fnum. AS
        SELECT CampaignMonth FORMAT=MONYY7. AS Month,
               MAX(OverallScore) AS BestScore FORMAT=5.2,
               PUT(MAX(OverallScore), ratingband.) AS Rating LENGTH=12,
               SUM(CollectedGWP) AS TotalGWP FORMAT=NLMNY16.2,
               SUM(Earn)         AS TotalEarn FORMAT=NLMNY16.2
        FROM AgentEarn_scored
        WHERE Agent = "&agent_fnum"
        GROUP BY CampaignMonth
        ORDER BY CampaignMonth;
    QUIT;

    TITLE3 'YOUR TREND (4 MONTHS)';
    PROC PRINT DATA=trend_&agent_fnum. NOOBS LABEL
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
    RUN;

    TITLE;
%MEND;

/* Loop over agents */
PROC SQL NOPRINT;
    SELECT DISTINCT CATS("%NRSTR(%agent_sheet)","(",Agent,",",Name,")")
    INTO :AgentSheetCalls SEPARATED BY ';'
    FROM AgentEarn_now;
QUIT;
&AgentSheetCalls.;

ODS EXCEL CLOSE;

/*---------------------------------------------------------------------
  3b. TL COACHING PACK
---------------------------------------------------------------------*/
ODS EXCEL FILE="&OUT_PATH/TL_Coaching_Pack_&RPT_LABEL..xlsx"
    OPTIONS(SHEET_INTERVAL='NONE' EMBEDDED_TITLES='YES');

/* TL scorecard */
ODS EXCEL OPTIONS(SHEET_NAME='My Scorecard');
PROC SQL NOPRINT;
    SELECT Name INTO :tl_name FROM TLEarn_all
    WHERE CampaignMonth = &RPT_MONTH;
QUIT;

TITLE1 "TL SCORECARD - &tl_name";
TITLE2 "%SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))";

PROC PRINT DATA=TLEarn_all NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#2C3E50 COLOR=WHITE FONTWEIGHT=BOLD];
    WHERE CampaignMonth = &RPT_MONTH;
    VAR SLRetail SLCommercial TAT EffortScore QA TeamEngagement
        RetailSR RetailPA CommSR CommPA GWP_AVG FC_AVG Comp_AVG
        OpsScore CustScore OverallScore EarnRate Earn;
    FORMAT SLRetail SLCommercial EffortScore QA TeamEngagement
           RetailSR RetailPA CommSR CommPA FC_AVG PERCENT9.2
           GWP_AVG Earn NLMNY16.2
           OpsScore CustScore OverallScore 5.2
           EarnRate PERCENT8.0;
RUN;

/* Team roster - worst first */
ODS EXCEL OPTIONS(SHEET_NAME='Team Roster');

PROC SQL;
    CREATE TABLE roster AS
    SELECT Name,
           Desk,
           MAX(EffeScore)    AS Effe,
           MAX(SaveScore)    AS Save,
           MAX(FCScore)      AS FC,
           MAX(GWPScore)     AS GWP,
           MAX(CompScore)    AS Comp,
           MAX(EffoScore)    AS Effort,
           MAX(QAScore)      AS QA,
           MAX(OverallScore) AS Score FORMAT=5.2,
           PUT(MAX(OverallScore),ratingband.) AS Rating LENGTH=12,
           SUM(Earn)         AS TotalEarn FORMAT=NLMNY16.2
    FROM AgentEarn_now
    GROUP BY Name, Desk
    ORDER BY Score;   /* worst first */
QUIT;

TITLE1 "TEAM ROSTER - %SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))";
TITLE2 'Ranked worst-first by Overall Score';
PROC PRINT DATA=roster NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#2C3E50 COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

/* Component health */
ODS EXCEL OPTIONS(SHEET_NAME='Component Health');

PROC SQL;
    CREATE TABLE comp_health AS
    SELECT 'Effectiveness' AS Component LENGTH=16,
           MEAN(EffeScore) AS AvgPts FORMAT=4.2,
           SUM(5 - EffeScore) AS TotalLost FORMAT=6.2,
           SUM(EffeScore <= 2) / COUNT(*) AS PctLow FORMAT=PERCENT8.0
    FROM (SELECT Agent, MAX(EffeScore) AS EffeScore FROM AgentEarn_now GROUP BY Agent)
    UNION
    SELECT 'Save Ratio', MEAN(SaveScore), SUM(5-SaveScore), SUM(SaveScore<=2)/COUNT(*)
    FROM (SELECT Agent, MAX(SaveScore) AS SaveScore FROM AgentEarn_now GROUP BY Agent)
    UNION
    SELECT '1st Collection', MEAN(FCScore), SUM(5-FCScore), SUM(FCScore<=2)/COUNT(*)
    FROM (SELECT Agent, MAX(FCScore) AS FCScore FROM AgentEarn_now GROUP BY Agent)
    UNION
    SELECT 'GWP Retained', MEAN(GWPScore), SUM(5-GWPScore), SUM(GWPScore<=2)/COUNT(*)
    FROM (SELECT Agent, MAX(GWPScore) AS GWPScore FROM AgentEarn_now GROUP BY Agent)
    UNION
    SELECT 'Complaints', MEAN(CompScore), SUM(5-CompScore), SUM(CompScore<=2)/COUNT(*)
    FROM (SELECT Agent, MAX(CompScore) AS CompScore FROM AgentEarn_now GROUP BY Agent)
    UNION
    SELECT 'Effort Score', MEAN(EffoScore), SUM(5-EffoScore), SUM(EffoScore<=2)/COUNT(*)
    FROM (SELECT Agent, MAX(EffoScore) AS EffoScore FROM AgentEarn_now GROUP BY Agent)
    UNION
    SELECT 'QA', MEAN(QAScore), SUM(5-QAScore), SUM(QAScore<=2)/COUNT(*)
    FROM (SELECT Agent, MAX(QAScore) AS QAScore FROM AgentEarn_now GROUP BY Agent)
    ORDER BY AvgPts;
QUIT;

TITLE1 'COMPONENT HEALTH - Points lost by component';
TITLE2 'Lower avg = broader issue';
PROC PRINT DATA=comp_health NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#2C3E50 COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

/* Coaching priorities: below 3.0 and close-to-next-tier */
ODS EXCEL OPTIONS(SHEET_NAME='Coaching Priorities');

PROC SQL;
    CREATE TABLE below_threshold AS
    SELECT Name, Desk, OverallScore FORMAT=5.2,
           Rating,
           3.0 - OverallScore AS GapToME FORMAT=5.2,
           CASE WHEN DeskGroup = 'Inbound' THEN 0.05 ELSE 0.08 END * CollectedGWP AS EstUplift FORMAT=NLMNY16.2
    FROM AgentEarn_now
    WHERE OverallScore < 3
    ORDER BY OverallScore;
QUIT;

TITLE1 'AGENTS BELOW EARN THRESHOLD (Score < 3.0)';
PROC PRINT DATA=below_threshold NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#2C3E50 COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

PROC SQL;
    CREATE TABLE close_to_next AS
    SELECT Name, Desk, OverallScore FORMAT=5.2,
           NextThresh, GapToNext FORMAT=5.2,
           EarnRate, NextRate,
           EarnRate * CollectedGWP AS CurrentEarn FORMAT=NLMNY16.2,
           NextRate * CollectedGWP AS PotentialEarn FORMAT=NLMNY16.2,
           PotentialUplift FORMAT=NLMNY16.2
    FROM AgentEarn_now
    WHERE GapToNext < 0.5 AND NOT MISSING(NextThresh)
    ORDER BY GapToNext;
QUIT;

TITLE1 'CLOSE TO NEXT TIER (worth pushing)';
PROC PRINT DATA=close_to_next NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#2C3E50 COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

ODS EXCEL CLOSE;

/*---------------------------------------------------------------------
  3c. MANAGER OVERVIEW PACK
---------------------------------------------------------------------*/
ODS EXCEL FILE="&OUT_PATH/Manager_Overview_Pack_&RPT_LABEL..xlsx"
    OPTIONS(SHEET_INTERVAL='NONE' EMBEDDED_TITLES='YES');

/* Manager scorecard */
ODS EXCEL OPTIONS(SHEET_NAME='My Scorecard');
PROC SQL NOPRINT;
    SELECT Name INTO :mgr_name FROM MgmtEarn_all
    WHERE CampaignMonth = &RPT_MONTH;
QUIT;

TITLE1 "MANAGER SCORECARD - &mgr_name";
TITLE2 "%SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))";
PROC PRINT DATA=MgmtEarn_all NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#1A2E4A COLOR=WHITE FONTWEIGHT=BOLD];
    WHERE CampaignMonth = &RPT_MONTH;
    VAR CollPerc_12m GWP_AVG FC_AVG SCA_AVG SCT_AVG Comp_AVG QACoaching
        OpScore CustScore OverallScore EarnRate GWP_COLL Earn;
    FORMAT CollPerc_12m FC_AVG QACoaching PERCENT9.2
           GWP_AVG GWP_COLL Earn NLMNY16.2
           OpScore CustScore OverallScore SCA_AVG SCT_AVG Comp_AVG 5.2
           EarnRate PERCENT8.2;
RUN;

/* Team of teams */
ODS EXCEL OPTIONS(SHEET_NAME='Team of Teams');
TITLE1 "TEAM OF TEAMS - %SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))";
PROC PRINT DATA=roster NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#1A2E4A COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

/* Payout summary */
ODS EXCEL OPTIONS(SHEET_NAME='Payout Summary');

PROC SQL;
    CREATE TABLE payout_desk AS
    SELECT Desk,
           COUNT(DISTINCT Agent) AS Agents,
           SUM(CollectedGWP) AS TotalGWP FORMAT=NLMNY16.2,
           SUM(Earn) AS TotalEarn FORMAT=NLMNY16.2
    FROM AgentEarn_now
    GROUP BY Desk
    ORDER BY TotalEarn DESC;
QUIT;

TITLE1 'PAYOUT BY DESK';
PROC PRINT DATA=payout_desk NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#1A2E4A COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

PROC SQL;
    CREATE TABLE payout_rating AS
    SELECT Rating,
           COUNT(DISTINCT Agent) AS People,
           SUM(CollectedGWP) AS TotalGWP FORMAT=NLMNY16.2,
           SUM(Earn) AS TotalEarn FORMAT=NLMNY16.2
    FROM AgentEarn_now
    GROUP BY Rating
    ORDER BY CASE Rating
        WHEN 'SIR' THEN 0
        WHEN 'IR'  THEN 1
        WHEN 'ME'  THEN 2
        WHEN 'EE'  THEN 3
        WHEN 'Exceptional' THEN 4 END;
QUIT;

TITLE1 'PAYOUT BY RATING';
PROC PRINT DATA=payout_rating NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#1A2E4A COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

/* Trend (4 months) */
ODS EXCEL OPTIONS(SHEET_NAME='Trend (4 months)');

PROC SQL;
    CREATE TABLE monthly_trend AS
    SELECT CampaignMonth FORMAT=MONYY7. AS Month,
           COUNT(DISTINCT Agent) AS Agents,
           MEAN(OverallScore) AS AvgScore FORMAT=5.2,
           SUM(CollectedGWP) AS TotalGWP FORMAT=NLMNY16.2,
           SUM(Earn) AS TotalEarn FORMAT=NLMNY16.2
    FROM AgentEarn_scored
    GROUP BY CampaignMonth
    ORDER BY CampaignMonth;
QUIT;

TITLE1 'MONTHLY BOOK ROLL-UP';
PROC PRINT DATA=monthly_trend NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#1A2E4A COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

/* Agent score matrix across months */
PROC TRANSPOSE DATA=AgentEarn_scored OUT=agent_matrix (DROP=_NAME_)
    PREFIX=M_;
    BY Name;
    ID CampaignMonth;
    VAR OverallScore;
RUN;

TITLE1 'AGENT SCORE TREND';
PROC PRINT DATA=agent_matrix NOOBS LABEL
    STYLE(HEADER)=[BACKGROUND=#1A2E4A COLOR=WHITE FONTWEIGHT=BOLD];
RUN;

ODS EXCEL CLOSE;

/*=====================================================================
  END OF PIPELINE
=====================================================================*/
