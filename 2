        environments. Guard the drop with a conditional check.
   ============================================================ */

data adobe_to_clients_step;
  set Adobe_recent_drops
      APNS_sends_campaigns;
run;

/* F14: Build drop list only for columns that actually exist */
%macro safe_drop(ds=, vars=);
  %local _droplist _v _cnt;
  %let _droplist = ;
  %let _cnt = %sysfunc(countw(&vars));
  %do _j = 1 %to &_cnt;
    %let _v = %scan(&vars, &_j);
    %if %varexist(&ds, &_v) %then %let _droplist = &_droplist &_v;
  %end;
  %if %length(&_droplist) > 0 %then drop &_droplist%str(;);
%mend;

%macro varexist(ds, var);
  %local dsid rc;
  %let dsid = %sysfunc(open(&ds));
  %if &dsid %then %do;
    %let rc = %sysfunc(varnum(&dsid, &var));
    %let dsid = %sysfunc(close(&dsid));
    %if &rc > 0 %then 1;
    %else 0;
  %end;
  %else 0;
%mend;

data adobe_to_clients_final;
  set adobe_to_clients_step;
  if drop_reason  = "" then success = 1; else success = 0;
  if drop_reason ne "" then drop    = 1; else drop    = 0;
  /* F14: drop only columns that exist */
  %safe_drop(ds=adobe_to_clients_step, vars=etl_source_data etl_date daymonth)
run;


/* ============================================================
