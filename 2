%macro iterate_week_drop(count);
  proc sql noprint;
    select count(distinct memname) into :count trimmed
    from uppend_weeek_campaigns;
  quit;

  %if &count = 0 %then %do;
    %put WARNING: iterate_week_drop - no weekly tables found, skipping.;
    %goto exit_week_drop;
  %end;

  proc datasets library=work nolist; delete TABLESdropweek_:; quit;

  %do i = 1 %to &count.;
    data TABLESdropweek_&i;
      set APN_DROP.&&tableweek&i.
          (keep=CUST_NO Product_Code Drop_Reason sub_segment
                Campaign_Name Brand MUCN);
      length _memname_ $50 _date_raw_ $8 _time_raw_ $4;
      _memname_ = "&&tableweek&i..";
      if index(_memname_,'_') > 0 then do;
        _date_raw_ = scan(_memname_, -2, '_');
        _time_raw_ = scan(_memname_, -1, '_');
        Date_to_adobe = input(_date_raw_, YYMMDD8.);
        Time_created_to_adobe = input(cats(substr(_time_raw_,1,2),':',
                                           substr(_time_raw_,3,2),':00'),
                                      HHMMSS8.);
      end;
      else do;
        _date_raw_ = substr(_memname_, 16, 8);
        Date_to_adobe = input(_date_raw_, YYMMDD10.);
        Time_created_to_adobe = input(substr("&&timetablewk&i..",9,8), HHMMSS.);
      end;
      format Date_to_adobe date9.;
      format Time_created_to_adobe time9.;
      rename CUST_NO = cust_no
             MUCN    = mucn
             Brand   = brand;
      drop _memname_ _date_raw_ _time_raw_;
    run;
  %end;

  %exit_week_drop:
%mend;
%iterate_week_drop(count)


