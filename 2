/* ============================================================
   SECTION 3: TABLE DISCOVERY
   Finds all matching campaign tables across archive + live.
   Deduplicates so archive and live overlap is handled cleanly.
   ============================================================ */

%macro discover(libref=, outds=);
  proc sql;
    create table &outds as
    select memname, crdate
    from dictionary.tables
    where libname = upcase("&libref.")
      and (
          memname like 'CMA09319%' or
          memname like 'CMA09320%' or
          memname like 'CMA10184%' or
          memname like 'CMA10251%' or
          memname like 'CMA10252%'
      )
    order by memname;
  quit;
%mend;

%discover(libref=Pass6,    outds=PASS_TABLES_ARCH)
%discover(libref=APN_Pass, outds=PASS_TABLES_LIVE)
%discover(libref=Drop6,    outds=DROP_TABLES_ARCH)
%discover(libref=APN_Drop, outds=DROP_TABLES_LIVE)

data PASS_TABLES;
  set PASS_TABLES_ARCH (in=a)
      PASS_TABLES_LIVE (in=b);
  Source = ifc(a, 'Archive', 'Live');
run;

data DROP_TABLES;
  set DROP_TABLES_ARCH (in=a)
      DROP_TABLES_LIVE (in=b);
  Source = ifc(a, 'Archive', 'Live');
run;

/* Prefer Live over Archive when the same table exists in both */
proc sort data=PASS_TABLES; by memname descending Source; run;
proc sort data=PASS_TABLES nodupkey; by memname; run;

proc sort data=DROP_TABLES; by memname descending Source; run;
proc sort data=DROP_TABLES nodupkey; by memname; run;

/* Push to macro variables */
data _null_;
  set PASS_TABLES;
  call symputx(cats('pass_tbl_',  _n_), memname);
  call symputx(cats('pass_src_',  _n_), Source);
  call symputx(cats('pass_crd_',  _n_), put(datepart(crdate), date9.));
run;

data _null_;
  set DROP_TABLES;
  call symputx(cats('drop_tbl_',  _n_), memname);
  call symputx(cats('drop_src_',  _n_), Source);
  call symputx(cats('drop_crd_',  _n_), put(datepart(crdate), date9.));
run;

proc sql noprint;
  select count(*) into :pass_count trimmed from PASS_TABLES;
  select count(*) into :drop_count trimmed from DROP_TABLES;
quit;

%put Pass tables found: &pass_count;
%put Drop tables found: &drop_count;


/* ============================================================
   SECTION 4: DATE/TIME EXTRACTION MACRO
   Centralises the table-name parsing used in both pass/drop
   loops so the logic only lives in one place.

   Logic (same as the proven second script):
     - If table name contains '_': date = scan(-2,'_') as YYMMDD8
                                   time = scan(-1,'_') as HHMMSS
     - Otherwise               : date = substr(name,16,8) as YYMMDD10
                                   time = missing (.)
   ============================================================ */

%macro extract_datetime(tname=, date_var=Batch_Date, time_var=Batch_Time);
  case
    when index("&tname.", '_') > 0
      then input(scan("&tname.", -2, '_'), YYMMDD8.)
    else input(substr("&tname.", 16, 8), YYMMDD10.)
  end as &date_var. format=date9. label="Batch Date",

  case
    when index("&tname.", '_') > 0
      then input(
             cats(
               substr(scan("&tname.",-1,'_'),1,2), ':',
               substr(scan("&tname.",-1,'_'),3,2), ':00'
             ), HHMMSS8.)
    else .
  end as &time_var. format=time9. label="Batch Time"
%mend;


/* ============================================================
   SECTION 5: CAMPAIGN LABEL ASSIGNMENT MACRO
   ============================================================ */

%macro assign_campaign(ds=);
  data &ds.;
    set &ds.;
    length Campaign_Label $40;
    select (substr(product_code, 1, 8));
      when ('CMA09319') Campaign_Label = 'Instruct APN (AIP)';
      when ('CMA09320') Campaign_Label = 'Device Insurance';
      when ('CMA10184') Campaign_Label = 'eBucks Flight VP';
      when ('CMA10251') Campaign_Label = 'Start the Year Right - CAR';
      when ('CMA10252') Campaign_Label = 'Start the Year Right - LOC';
      otherwise         Campaign_Label = substr(product_code, 1, 8);
    end;
  run;
%mend;


/* ============================================================
   SECTION 6: READ ALL PASSED (OPTIMISE) RECORDS
   One row per customer. Keeps cust_no, mucn, product_code,
   sub_segment, campaign_name, batch date/time, source table.
   ============================================================ */

%macro read_passed;
  %do i = 1 %to &pass_count.;

    %local libref;
    %if %upcase(&&pass_src_&i.) = ARCHIVE %then %let libref = Pass6;
    %else %let libref = APN_Pass;

    proc sql noprint;
      select count(*) into :nobs trimmed
      from &libref..&&pass_tbl_&i.;
    quit;

    %if &nobs. > 0 %then %do;
      data _passed_&i.;
        length mucn         $28
               product_code $29
               Source_Table $50
               Source       $10;
        set &libref..&&pass_tbl_&i.
            (keep=CUST_NO MUCN Product_Code sub_segment Campaign_Name);
        Optimise_Status = 'Passed';
        Drop_Reason     = '';
        %extract_datetime(tname=&&pass_tbl_&i., date_var=Batch_Date, time_var=Batch_Time);
        Source_Table    = "&&pass_tbl_&i.";
        Source          = "&&pass_src_&i.";
        format Batch_Date date9. Batch_Time time9.;
      run;
    %end;

  %end;

  data ALL_OPTIMISE_PASSED;
    set _passed_:;
  run;

  proc datasets library=work nolist; delete _passed_:; quit;
%mend;
%read_passed;


/* ============================================================
   SECTION 7: READ ALL DROPPED (OPTIMISE) RECORDS
   Same structure as passed, but includes Drop_Reason.
   ============================================================ */

%macro read_dropped;
  %do i = 1 %to &drop_count.;

    %local libref;
    %if %upcase(&&drop_src_&i.) = ARCHIVE %then %let libref = Drop6;
    %else %let libref = APN_Drop;

    proc sql noprint;
      select count(*) into :nobs trimmed
      from &libref..&&drop_tbl_&i.;
    quit;

    %if &nobs. > 0 %then %do;
      data _dropped_&i.;
        length mucn         $28
               product_code $29
               Drop_Reason  $100
               Source_Table $50
               Source       $10;
        set &libref..&&drop_tbl_&i.
            (keep=CUST_NO MUCN Product_Code Drop_Reason sub_segment Campaign_Name);
        Optimise_Status = 'Dropped';
        %extract_datetime(tname=&&drop_tbl_&i., date_var=Batch_Date, time_var=Batch_Time);
        Source_Table    = "&&drop_tbl_&i.";
        Source          = "&&drop_src_&i.";
        format Batch_Date date9. Batch_Time time9.;
      run;
    %end;

  %end;

  data ALL_OPTIMISE_DROPPED;
    set _dropped_:;
  run;

  proc datasets library=work nolist; delete _dropped_:; quit;
%mend;
%read_dropped;


/* ============================================================
   SECTION 8: COMBINE OPTIMISE DATA
   Stack passed and dropped into one customer-level table.
   Derive Brand from first 3 chars of mucn.
   ============================================================ */

data ALL_OPTIMISE;
  set ALL_OPTIMISE_PASSED
      ALL_OPTIMISE_DROPPED;
  length Brand $3;
  Brand = substr(mucn, 1, 3);
run;

%assign_campaign(ds=ALL_OPTIMISE);

proc sql;
  select count(*) as Total_Optimise_Records
  from ALL_OPTIMISE;
quit;


/* ============================================================
   SECTION 9: ADOBE SENDS
   Reads APN_SENDS_AND_FEEDBACK.
   NOTE: We attempt to match on cust_no first. The view also
   carries ucn (numeric) -- we bring both through so Section 11
   can try both join keys and we can see which one matches.
   ============================================================ */

data ADOBE_SENDS;
  length product_code $29;
  set APNS.APN_SENDS_AND_FEEDBACK
      (keep=CUST_NO MUCN product_code Distribution_date
            Delivery_code date_received);
  where product_code in (&product_codes.);
  length Brand          $3
         Adobe_Status   $50
         Delivery_code  $20;
  Brand          = substr(mucn, 1, 3);
  Date_Loaded    = datepart(Distribution_date);
  Time_Loaded    = timepart(Distribution_date);
  Delivery_code  = upcase(Delivery_code);
  Date_Opened    = datepart(date_received);
  Opened_Flag    = (date_received is not missing);
  Adobe_Status   = 'Sent';
  format Date_Loaded date9. Time_Loaded time9. Date_Opened date9.;
  rename CUST_NO = cust_no_adobe;
  drop Distribution_date date_received;
run;

proc sql;
  select count(*) as Total_Adobe_Sends from ADOBE_SENDS;
quit;


/* ============================================================
   SECTION 10: ADOBE DROP-OFFS
   Reads ADOBE_DROP_OFFS_DATA.
   ucn is the customer identifier here (not cust_no).
   We carry it as cust_no_adobe to align with ADOBE_SENDS.
   ============================================================ */

data ADOBE_DROPOFFS;
  length product_code  $29
         Drop_Reason   $100
         mucn          $28;
  set APNS.ADOBE_DROP_OFFS_DATA
      (keep=ucn MUCN product_code Date_loaded Drop_Reason);
  where product_code in (&product_codes.);
  length Brand        $3
         Adobe_Status $50;
  Brand          = substr(mucn, 1, 3);
  Date_Loaded    = datepart(Date_loaded);
  Time_Loaded    = timepart(Date_loaded);
  Opened_Flag    = 0;
  Date_Opened    = .;
  Delivery_code  = '';
  Adobe_Status   = 'Adobe Drop: ' || strip(Drop_Reason);
  cust_no_adobe  = ucn;   /* ucn is the customer id in this view */
  format Date_Loaded date9. Time_Loaded time9.;
  drop Date_loaded ucn;
run;

proc sql;
  select count(*) as Total_Adobe_Dropoffs from ADOBE_DROPOFFS;
quit;


/* ============================================================
   SECTION 11: COMBINE ALL ADOBE DATA
   ============================================================ */

data ALL_ADOBE;
  set ADOBE_SENDS
      ADOBE_DROPOFFS;
run;

%assign_campaign(ds=ALL_ADOBE);


/* ============================================================
   SECTION 12: JOIN OPTIMISE TO ADOBE  (DETAIL TABLE)
   Join key : cust_no (Optimise) = cust_no_adobe (Adobe)
            + product_code
            + Adobe date within 60 days of Optimise batch date
              (60-day window confirmed in original FIX 5 --
               Adobe loads observed up to 46 days after batch)

   Adobe_Label logic:
     'Sending to Adobe'              -- Passed, no Adobe match yet,
                                        within 60 days of batch
     'Not loaded into Adobe (>60d)'  -- Passed, no match, over 60 days
     'Dropped by Optimise'           -- Dropped, never reaches Adobe
     Actual Adobe_Status             -- Matched row from Adobe
   ============================================================ */

proc sql;
  create table APNS_DATA_DETAIL_RAW as
  select
    a.CUST_NO,
    a.Campaign_Label,
    a.product_code,
    a.Brand,
    a.sub_segment,
    a.Campaign_Name,
    a.Optimise_Status,
    a.Drop_Reason          as Optimise_Drop_Reason,
    a.Batch_Date,
    a.Batch_Time,
    a.Source,
    a.Source_Table,
    b.cust_no_adobe,
    b.Date_Loaded,
    b.Time_Loaded,
    b.Delivery_code,
    b.Adobe_Status,
    b.Opened_Flag,
    b.Date_Opened,
    intck('day', a.Batch_Date, b.Date_Loaded) as Days_to_Adobe
  from ALL_OPTIMISE a
  left join ALL_ADOBE b
    on  a.CUST_NO      = b.cust_no_adobe
    and a.product_code = b.product_code
    and (b.Date_Loaded between a.Batch_Date and a.Batch_Date + 60);
quit;


/* ============================================================
   SECTION 13: DERIVE FINAL ADOBE LABEL + DEDUPLICATE
   Where a customer matched multiple Adobe rows (e.g. a send
   and a later open), keep the most recent Date_Loaded row.
   ============================================================ */

proc sort data=APNS_DATA_DETAIL_RAW;
  by CUST_NO product_code Batch_Date descending Date_Loaded;
run;

proc sort data=APNS_DATA_DETAIL_RAW nodupkey
  out=APNS_DATA_DETAIL_DEDUP;
  by CUST_NO product_code Batch_Date;
run;

data APNS_DATA_DETAIL;
  length Adobe_Label   $50
         Optimize      $100   /* matches original: drop reason or "Sent"         */
         Adobe         $50    /* matches original: Loaded/TEST/reason/Sending/etc */
         Client        $50    /* matches original: Sent/TEST/drop reason          */
         Test_Indicator $6;
  set APNS_DATA_DETAIL_DEDUP;

  /* ── Adobe_Label (new, richer column) ── */
  if Optimise_Status = 'Dropped' then
    Adobe_Label = 'Dropped by Optimise';
  else if not missing(cust_no_adobe) then
    Adobe_Label = Adobe_Status;
  else if intck('day', Batch_Date, today()) <= 60 then
    Adobe_Label = 'Sending to Adobe';
  else
    Adobe_Label = 'Not loaded into Adobe (>60d)';

  /* ── Optimize (original column) ── */
  if Optimise_Status = 'Dropped' then Optimize = Optimise_Drop_Reason;
  else                                 Optimize = 'Sent';

  /* ── Adobe (original column) ── */
  if upcase(Delivery_code) = 'TEST'      then Adobe = 'TEST';
  else if not missing(cust_no_adobe)     then Adobe = Adobe_Status;
  else if intck('day', Batch_Date, today()) <= 60
                                         then Adobe = 'Sending to Adobe';
  else                                        Adobe = 'Not loaded into Adobe within 60 days';

  /* ── Client (original column) ── */
  if upcase(Delivery_code) = 'TEST'      then Client = 'TEST';
  else if not missing(cust_no_adobe)     then Client = 'Sent';
  else                                        Client = Adobe_Status;

  /* ── Test indicator ── */
  if upcase(Delivery_code) = 'TEST' then Test_Indicator = 'TEST';
  else                                   Test_Indicator = 'Actual';

  drop cust_no_adobe;
run;

proc sql;
  select count(*) as APNS_DATA_DETAIL_rows from APNS_DATA_DETAIL;
quit;


/* ============================================================
   SECTION 14: SUMMARY TABLE FOR POWER BI
   Dimensions: Campaign + Product Code + Batch Date + Drop Reason
   Measures  : counts per Adobe label + open rate
   ============================================================ */

proc sql;
  create table APNS_DATA_SUMMARY as
  select
    Campaign_Label,
    product_code,
    Batch_Date,
    Optimize,          /* original column - matches existing PBI decomp tree */
    Adobe,             /* original column - matches existing PBI decomp tree */
    Client,            /* original column - matches existing PBI decomp tree */
    Optimise_Status,
    Optimise_Drop_Reason,
    Adobe_Label,
    Test_Indicator,
    count(*)                                        as Record_Count
                                                    label = "Record Count",
    sum(Opened_Flag)                                as Total_Opened
                                                    label = "Total Opened",
    sum(case when Adobe_Label = 'Sending to Adobe'
             then 1 else 0 end)                     as Sending_to_Adobe
                                                    label = "Sending to Adobe",
    sum(case when Adobe_Label contains 'Not loaded'
             then 1 else 0 end)                     as Not_Loaded
                                                    label = "Not Loaded",
    min(Date_Loaded)                                as First_Date_Loaded
                                                    format = date9.
                                                    label = "First Date Loaded to Adobe",
    max(Date_Loaded)                                as Last_Date_Loaded
                                                    format = date9.
                                                    label = "Last Date Loaded to Adobe",
    min(Days_to_Adobe)                              as Min_Days_to_Adobe
                                                    label = "Min Days Optimise to Adobe",
    max(Days_to_Adobe)                              as Max_Days_to_Adobe
                                                    label = "Max Days Optimise to Adobe",
    mean(Days_to_Adobe)                             as Avg_Days_to_Adobe
                                                    format = 8.1
                                                    label = "Avg Days Optimise to Adobe",

    /* Pre-calculated open rate:
       Only meaningful for Sent records (Optimise_Status = Passed
       and Adobe_Label = Sent). Dropped and not-yet-loaded records
       are excluded from the denominator via the CASE. */
    case
      when sum(case when Adobe_Label = 'Sent' then 1 else 0 end) > 0
        then sum(Opened_Flag) /
             sum(case when Adobe_Label = 'Sent' then 1 else 0 end) * 100
      else .
    end                                             as Open_Rate
                                                    format = 8.2
                                                    label = "Open Rate (%)"
  from APNS_DATA_DETAIL
  group by
    Campaign_Label,
    product_code,
    Batch_Date,
    Optimize,
    Adobe,
    Client,
    Optimise_Status,
    Optimise_Drop_Reason,
    Adobe_Label,
    Test_Indicator
  order by
    Campaign_Label,
    product_code,
    Batch_Date;
quit;

proc sql;
  select count(*) as APNS_DATA_SUMMARY_rows from APNS_DATA_SUMMARY;
quit;


/* ============================================================
   SECTION 15: DIAGNOSTIC - VALIDATE JOIN MATCH RATES
   Run this before promoting to production to confirm the
   cust_no join key is working. If Adobe_matched = 0 for
   Passed records, the identifier mapping needs revisiting.
   ============================================================ */

proc sql;
  title "Join Diagnostic - Match Rates by Campaign and Optimise Status";
  select
    Campaign_Label,
    Optimise_Status,
    count(*)                                            as Total,
    sum(case when Adobe_Label not in
              ('Sending to Adobe',
               'Not loaded into Adobe (>60d)',
               'Dropped by Optimise')
             then 1 else 0 end)                         as Adobe_Matched,
    calculated Adobe_Matched / calculated Total * 100   as Match_Pct
                                                        format = 8.1
                                                        label = "Match %"
  from APNS_DATA_DETAIL
  group by Campaign_Label, Optimise_Status
  order by Campaign_Label, Optimise_Status;
  title;
quit;

proc sql;
  title "Adobe Label Distribution";
  select
    Adobe_Label,
    count(*) as Count,
    count(*) / sum(count(*)) over () * 100 as Pct format=8.1
  from APNS_DATA_DETAIL
  group by Adobe_Label
  order by Count desc;
  title;
quit;


/* ============================================================
   SECTION 16: LOAD TO PRODUCTION - ZERO ROW SAFETY GATE
   ============================================================ */

%macro LoadTable(Table=, Target=);
  %if %sysfunc(exist(&Table.)) %then %do;

    proc sql noprint;
      select count(*) into :row_count trimmed from &Table.;
    quit;

    %if &row_count. = 0 %then %do;
      %put ERROR: =======================================================;
      %put ERROR: &Table. has ZERO rows. Production load ABORTED.;
      %put ERROR: STI_PBI.&Target. has NOT been updated.;
      %put ERROR: Check diagnostics in Section 15 above.;
      %put ERROR: =======================================================;
      %abort cancel;
    %end;
    %else %do;
      %put NOTE: &Table. has &row_count. rows. Loading to STI_PBI.&Target.;
      proc sql;
        drop table STI_PBI.&Target.;
        create table STI_PBI.&Target. as
        select * from &Table.;
      quit;
      %put NOTE: STI_PBI.&Target. loaded successfully.;
    %end;

  %end;
  %else %do;
    %put ERROR: Work table &Table. does not exist. Cannot load.;
    %abort cancel;
  %end;
%mend;

%LoadTable(Table=APNS_DATA_DETAIL,  Target=APNS_DATA_DETAIL);
%LoadTable(Table=APNS_DATA_SUMMARY, Target=APNS_DATA_SUMMARY);


