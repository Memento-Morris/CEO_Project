%macro build_campaign_filter(libref, outds);
  proc sql;
    create table &outds as
    select *
    from dictionary.tables
    where libname = "%upcase(&libref.)"
      and (
        %do i = 1 %to &camp_count.;
          %if &i > 1 %then or;
          memname like "&&camp_&i..%"
        %end;
      );
  quit;

  /* CHECK: Warn if no tables found for a given library */
  proc sql noprint;
    select count(distinct memname) into :_found_count trimmed
    from &outds;
