proc sql;
    select distinct adobe_processed_status,
           count(*) as freq
    from APNS.apn_sends_and_feedback
    where product_code in (&product_list.)
    group by adobe_processed_status
    order by freq desc;
quit;

proc sql;
    select distinct distribution_status,
           adobe_processed_status,
           count(*) as freq
    from APNS.apn_sends_and_feedback
    where product_code in (&product_list.)
    group by distribution_status, adobe_processed_status
    order by freq desc;
quit;

proc sql outobs=20;
    select distinct substr(status_description, 1, 100) as status_desc_sample,
           count(*) as freq
    from APNS.apn_sends_and_feedback
    where product_code in (&product_list.)
    group by calculated status_desc_sample
    order by freq desc;
quit;
