/* Check what distinct values distribution_status actually holds */
proc sql;
    select distinct distribution_status,
           count(*) as freq
    from STI_PBI.APN_POT
    group by distribution_status
    order by freq desc;
quit;
proc sql;
    select distinct distribution_status,
           count(*) as freq
    from STI_PBI.APN_POT
    where Client = "Sent to Client"
    group by distribution_status
    order by freq desc;
quit;
