/* F02: Detect whether Distribution_date is datetime or date */
proc sql noprint;
  select type, length, format
  into   :_dist_type   trimmed,
         :_dist_length trimmed,
         :_dist_fmt    trimmed
  from dictionary.columns
  where libname = 'APNS'
    and memname = 'APN_SENDS_AND_FEEDBACK'
    and upcase(name) = 'DISTRIBUTION_DATE';
quit;

%put NOTE: Distribution_date - type=&_dist_type length=&_dist_length format=&_dist_fmt;

/* Determine if it is a datetime (length >= 8 and format contains DT or DATETIME) */
%let _is_datetime = 1;
%if %index(%upcase(&_dist_fmt), DATETIME) = 0 and
    %index(%upcase(&_dist_fmt), DT)       = 0 and
    &_dist_length < 8 %then %let _is_datetime = 0;

%put NOTE: Treating Distribution_date as datetime: &_is_datetime (1=yes, 0=plain date);

