proc contents data=campaigns_to_adobe_renamed;
  var cust_no;
run;

proc contents data=adobe_final_table_clients;
  var cust_no2;
run;

proc sql;
  select distinct product_code_to_adobe from campaigns_to_adobe_renamed;
quit;

proc sql;
  select distinct product_code from adobe_final_table_clients;
quit;

proc sql;
