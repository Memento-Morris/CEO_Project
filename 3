from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side

wb = Workbook()
ws = wb.active
ws.title = "Campaign Targets"
ws.sheet_view.showGridLines = False

DARK_BLUE  = "1B3A6B"
MID_BLUE   = "2E6DB4"
LIGHT_BLUE = "D6E4F7"
WHITE      = "FFFFFF"
GREY_LIGHT = "F2F4F7"
INPUT_YELLOW = "FFF8E1"

def fill(hex): return PatternFill("solid", fgColor=hex)
def hdr_font(size=10, color=WHITE): return Font(name="Arial", size=size, bold=True, color=color)
def body_font(size=10, bold=False, color="000000"): return Font(name="Arial", size=size, bold=bold, color=color)
s = Side(style="thin", color="CCCCCC")
bdr = Border(left=s, right=s, top=s, bottom=s)
center = Alignment(horizontal="center", vertical="center", wrap_text=True)
left   = Alignment(horizontal="left",   vertical="center", wrap_text=True)

# Column widths
col_widths = {
    "A": 22,  # Campaign_Name
    "B": 16,  # Campaign_Code
    "C": 18,  # Product_Code
    "D": 14,  # Channel
    "E": 14,  # Sub_Segment
    "F": 10,  # Brand
    "G": 12,  # Month
    "H": 16,  # Expected_Leads
    "I": 18,  # Expected_Conversion_Pct
    "J": 14,  # Existing_to_Bank
    "K": 14,  # New_to_Bank
}
for col, w in col_widths.items():
    ws.column_dimensions[col].width = w

# Title row
ws.merge_cells("A1:K1")
c = ws["A1"]
c.value     = "APN Campaign Targets — Product Team Input"
c.font      = hdr_font(13)
c.fill      = fill(DARK_BLUE)
c.alignment = center
ws.row_dimensions[1].height = 32

# Instruction row
ws.merge_cells("A2:K2")
c = ws["A2"]
c.value     = ("Fill in one row per Campaign / Channel / Month combination. "
               "Leave Expected_Leads blank if not applicable for that channel/month. "
               "This file is loaded into Power BI as the Targets source.")
c.font      = body_font(9, False, "444444")
c.fill      = fill(GREY_LIGHT)
c.alignment = left
ws.row_dimensions[2].height = 28

# Headers
headers = [
    "Campaign_Name",
    "Campaign_Code",
    "Product_Code",
    "Channel",
    "Sub_Segment",
    "Brand",
    "Month",
    "Expected_Leads",
    "Expected_Conversion_Pct",
    "Existing_to_Bank",
    "New_to_Bank",
]
for ci, hdr in enumerate(headers):
    c = ws.cell(row=3, column=1+ci, value=hdr)
    c.font      = hdr_font(10)
    c.fill      = fill(MID_BLUE)
    c.alignment = center
    c.border    = bdr
ws.row_dimensions[3].height = 28

# Example rows so the product team understands the format
examples = [
    ["Start the year right - Car Insurance","CMA10251","CMA10251V01M01","APN","ENTRY BANKING","FNB","2026-04","",  "", "", ""],
    ["Start the year right - Car Insurance","CMA10251","CMA10251V01M01","APN","MIDDLE",       "FNB","2026-04","",  "", "", ""],
    ["Start the year right - Car Insurance","CMA10251","CMA10251V01M01","SMS","ENTRY BANKING","FNB","2026-04","",  "", "", ""],
    ["Start the year right - Law on Call",  "CMA10252","CMA10252V01M01","APN","MIDDLE",       "FNB","2026-03","",  "", "", ""],
]

for ri, row_data in enumerate(examples):
    row = 4 + ri
    for ci, val in enumerate(row_data):
        c = ws.cell(row=row, column=1+ci, value=val)
        # first 6 cols = campaign info (light blue), last 5 = numbers to fill (yellow)
        c.fill      = fill(LIGHT_BLUE) if ci < 6 else fill(INPUT_YELLOW)
        c.font      = body_font(10, False, "000080" if ci >= 6 else "1B3A6B")
        c.alignment = left
        c.border    = bdr
    ws.row_dimensions[row].height = 20

# Blank input rows (20 more for the team to fill in)
for ri in range(20):
    row = 8 + ri
    for ci in range(11):
        c = ws.cell(row=row, column=1+ci)
        c.fill      = fill(LIGHT_BLUE) if ci < 6 else fill(INPUT_YELLOW)
        c.alignment = left
        c.border    = bdr
        c.font      = body_font(10)
    ws.row_dimensions[row].height = 20

# Colour legend at bottom
legend_row = 30
ws.merge_cells(f"A{legend_row}:K{legend_row}")
c = ws.cell(row=legend_row, column=1,
            value="COLOUR GUIDE:   Blue = campaign info (copy from PPTX)     Yellow = numbers to fill in     Month format = YYYY-MM  e.g. 2026-04")
c.font      = body_font(9, False, "444444")
c.fill      = fill(GREY_LIGHT)
c.alignment = left
ws.row_dimensions[legend_row].height = 20

ws.freeze_panes = "A4"
ws.sheet_properties.tabColor = "1B3A6B"

wb.save("/mnt/user-data/outputs/APN_Campaign_Targets.xlsx")
print("done")
EOF
