   ============================================================ */

proc sql;
create table joining as
select *
from campaigns_to_adobe_renamed a
left join adobe_final_table_clients b
  on  a.cust_no               = b.cust_no2
  and a.product_code_to_adobe  = b.product_code
  /* FIX #1: BETWEEN requires lower bound first - was inverted (empty range) */
  and (a.date_to_adobe between b.date_loaded - 5 and b.date_loaded);
quit;

data APNS_DATA (drop=Time product_code mucn ucn mucn_to_adobe
                     success_to_adobe drop_to_adobe);
  set joining;
  if Cust_no2 = "" and Optimize = "Sent"
    then Adobe = "Not loaded into Adobe within 5 days";
  /* FIX #2: Missing date check uses . (numeric missing), not ""d */
  if cust_no2 = "" and Optimize = "Sent"
    and intck('day', date_to_adobe, today()) <= 5
    and Date_loaded = .
    then Adobe = "Sending to Adobe";
  date_Diff = intck('day', date_to_adobe, date_loaded);
run;

proc sort data=APNS_DATA;
  by descending date_loaded Date_to_adobe;
run;

proc sql;
create table APNS_Data_Final as
select *
from APNS_DATA a
inner join (
  select cust_no, product_code_to_adobe, date_to_adobe,
         min(date_loaded) as min_date_loaded format date9.
  from APNS_DATA
  where date_to_adobe ne date_loaded
  group by cust_no, product_code_to_adobe, date_to_adobe) as b
  on  a.date_to_adobe          = b.date_to_adobe
  and a.date_loaded             = b.min_date_loaded
  and a.cust_no                 = b.cust_no
  and a.product_code_to_adobe   = b.product_code_to_adobe;
quit;

data APNS_DATA;
  set APNS_Data_Final;
  drop min_date_loaded;
run;


/* ============================================================
   SECTION 13: LOAD TO PRODUCTION - WITH ZERO-ROW SAFETY GATE
   ============================================================ */

%macro Loadtable(Table);
  %if %sysfunc(exist(&table.)) %then %do;

    proc sql noprint;
      select count(*) into :new_row_count trimmed
      from &Table.;
    quit;

    %if &new_row_count = 0 %then %do;
      %put ERROR: =====================================================;
      %put ERROR: &Table. has ZERO rows - aborting production load.;
      %put ERROR: STI_PBI.&Table. has NOT been updated.;
      %put ERROR: Check campaign config, date extraction and joins.;
      %put ERROR: =====================================================;
      /* FIX #4: %abort cancel is the correct way to stop job in macro context */
      %abort cancel;
    %end;
    %else %do;
      %put NOTE: &Table. has &new_row_count rows - loading to production.;
      proc sql;
        drop table STI_PBI.&Table.;
        create table STI_PBI.&Table. as
        select * from &Table.;
      quit;
    %end;

  %end;
  %else %do;
    %put ERROR: Work table &Table. does not exist - cannot load to production.;
  %end;
%mend;

%Loadtable(APNS_DATA);


/* ============================================================
   SECTION 14: APN OPEN RATE REPORTING
   Loops over all campaigns defined in the config above.
   For each campaign it queries reportV.APN_SENDS_AND_FEEDBACK
   using the matching rpt_XX product code and produces:
     - A summary work table  APN_RPT_&camp  (one row per campaign)
     - A combined table      APN_OPEN_RATES (all campaigns stacked)
     - A proc print          for each campaign in the log / output
   To add a new campaign: add rpt_XX in the config block above.
   ============================================================ */

%macro apn_open_rate(camp_code, prod_code, idx);

  /* Only run if the product code is populated */
  %if %length(%trim(&prod_code.)) = 0 %then %do;
    %put WARNING: No report code defined for campaign &camp_code. - skipping open rate.;
  %end;
  %else %do;

    proc sql noprint;
      /* Check source has rows for this product before querying */
      select count(*) into :_src_rows trimmed
      from reportV.APN_SENDS_AND_FEEDBACK
      where product_code = "&prod_code.";
    quit;

    %if &_src_rows = 0 %then %do;
      %put WARNING: No rows in APN_SENDS_AND_FEEDBACK for &prod_code. - skipping.;
    %end;
    %else %do;

      proc sql;
        create table APN_RPT_&idx as
        select
          "&prod_code."                                                   as Campaign_Code     length=20,
          "&camp_code."                                                   as Campaign_Prefix   length=10,
          count(PRIMARY_KEY)                                              as Total_Sent,
          sum(case when date_received is not missing then 1 else 0 end)   as Total_Opened,
          sum(case when date_received is     missing then 1 else 0 end)   as Total_Not_Opened,
          calculated Total_Opened / calculated Total_Sent * 100           as Open_Rate         format=8.2,
          "APN"                                                           as Distribution_Channel length=5
        from reportV.APN_SENDS_AND_FEEDBACK
        where product_code = "&prod_code.";
      quit;

      proc print data=APN_RPT_&idx noobs label;
        title "APN Distribution - Campaign &prod_code.";
        label
          Campaign_Code         = "Campaign Code"
          Campaign_Prefix       = "Campaign"
          Total_Sent            = "Total Sent"
          Total_Opened          = "Total Opened"
          Total_Not_Opened      = "Total Not Opened"
          Open_Rate             = "Open Rate (%)"
          Distribution_Channel  = "Channel";
      run;
      title;

    %end; /* _src_rows > 0 */
  %end;   /* prod_code not blank */

%mend apn_open_rate;


/* --- Call the macro once per campaign using the config variables --- */
%macro build_open_rate_report;

  /* Drop any leftover individual report tables from a prior run */
  proc datasets library=work nolist;
    delete APN_RPT_:;
  quit;

  %do i = 1 %to &camp_count.;
    %apn_open_rate(&&camp_&i., &&rpt_&i., &i.)
  %end;

  /* Stack all individual tables that were successfully created */
  data APN_OPEN_RATES;
    set APN_RPT_: ;
  run;

  /* Row count sanity check */
  proc sql noprint;
    select count(*) into :_rpt_rows trimmed
    from APN_OPEN_RATES;
  quit;

  %if &_rpt_rows = 0 %then
    %put WARNING: APN_OPEN_RATES has zero rows - no campaigns had feedback data.;
  %else %do;
    %put NOTE: APN_OPEN_RATES built with &_rpt_rows row(s) across all campaigns.;

    /* Summary print across all campaigns */
    proc print data=APN_OPEN_RATES noobs label;
      title "APN Open Rate Summary - All Campaigns";
      label
        Campaign_Code         = "Campaign Code"
        Campaign_Prefix       = "Campaign"
        Total_Sent            = "Total Sent"
        Total_Opened          = "Total Opened"
        Total_Not_Opened      = "Total Not Opened"
        Open_Rate             = "Open Rate (%)"
        Distribution_Channel  = "Channel";
    run;
    title;

    /* Load combined report to production */
    proc sql;
      drop table STI_PBI.APN_OPEN_RATES;
      create table STI_PBI.APN_OPEN_RATES as
      select * from APN_OPEN_RATES;
    quit;
    %put NOTE: STI_PBI.APN_OPEN_RATES loaded successfully.;

  %end;

%mend build_open_rate_report;

%build_open_rate_report;


