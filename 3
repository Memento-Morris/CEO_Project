/* Check what the conversion actually produces */
proc sql outobs=10;
select 
    a.cust_no,
    input(strip(a.cust_no), best32.) as converted_ucn,
    b.UCN
from STI_PBI.APNS_DATA a, WH_ENH.CUST b
where monotonic() <= 5;
quit;

/* Do any cust_no values exist in WH_ENH.CUST UCN? */
proc sql outobs=10;
select 
    a.cust_no,
    b.UCN
from STI_PBI.APNS_DATA a
inner join WH_ENH.CUST b
    on input(strip(a.cust_no), best32.) = b.UCN;
quit;

proc sql;
select 
    min(UCN) as min_ucn,
    max(UCN) as max_ucn
from WH_ENH.CUST;
quit;
