/* ============================================================
   APN Campaign Status Summary - FINAL
   ============================================================ */

%include "/data/fnbins/fnbinsurance/Growth_Analytics/SASCODE/DEPLOYED/Automation/STI_CA_2/Libnames.sas";

%let product_codes_filter =
    "CMA09319V01M01",
    "CMA09320V01M01",
    "CMA10184V01M01","CMA10184V02M09","CMA10184V03M17",
    "CMA10184V01M02","CMA10184V02M10","CMA10184V03M18",
    "CMA10184V01M03","CMA10184V02M11","CMA10184V03M19",
    "CMA10184V01M04","CMA10184V02M12","CMA10184V03M20",
    "CMA10184V01M05","CMA10184V02M13","CMA10184V03M21",
    "CMA10184V01M06","CMA10184V02M14","CMA10184V03M22",
    "CMA10184V01M07","CMA10184V02M15","CMA10184V03M23",
    "CMA10184V01M08","CMA10184V02M16","CMA10184V03M24",
    "CMA10252V01M01",
    "CMA10251V01M01"
;

/* ============================================================
   STEP 1: PULL AND CLASSIFY RECORDS
   Based on actual values observed:
     Adobe = 'ADB_'  -> Loaded into Adobe
     Adobe = 'Not '  -> Not Loaded (sent to Adobe but not loaded)
     Adobe = 'NO C'  -> No Content
     Adobe = 'INCO'  -> Incomplete
     Adobe = ''(blank) and optimize = 'Sent'   -> Sent (in transit)
     Drop_reason_to_adobe not blank             -> Failed/Dropped
   ============================================================ */

data apns_classified;
    set STI_PBI.APNS_DATA;
    where product_code_to_adobe in (&product_codes_filter.);

    length Status $30;

    select;
        /* Loaded into Adobe */
        when (strip(Adobe) = 'ADB_')
            Status = 'Loaded';

        /* Sent to Adobe but not yet loaded */
        when (strip(Adobe) = 'Not')
            Status = 'Not Loaded Yet';

        /* Optimise passed, awaiting Adobe */
        when (strip(Adobe) = '' and strip(optimize) = 'Sent'
              and strip(Drop_reason_to_adobe) = '')
            Status = 'Sent';

        /* Failed - has a drop reason */
        when (strip(Drop_reason_to_adobe) ne '')
            Status = 'Failed';

        /* Catch-all */
        otherwise
            Status = 'Other: ' || strip(Adobe) || ' / ' || strip(optimize);
    end;
run;


/* ============================================================
   STEP 2: SUMMARY BY CAMPAIGN + PRODUCT CODE
   ============================================================ */

proc sql;
    create table detail_summary as
    select  strip(Campaign_Name)        as Campaign_Name    label = "Campaign Name",
            product_code_to_adobe       as Product_Code     label = "Product Code",
            sum(case when Status = 'Loaded'        then 1 else 0 end)
                                        as Loaded           label = "Loaded into Adobe",
            sum(case when Status = 'Sent'          then 1 else 0 end)
                                        as Sent             label = "Sent (In Transit)",
            sum(case when Status = 'Not Loaded Yet' then 1 else 0 end)
                                        as Not_Loaded       label = "Not Loaded Yet",
            sum(case when Status = 'Failed'        then 1 else 0 end)
                                        as Failed           label = "Failed / Dropped",
            count(*)                    as Total            label = "Total Records",
            min(Date_to_adobe)          as Earliest_Date    format date9. label = "Earliest Date",
            max(Date_to_adobe)          as Latest_Date      format date9. label = "Latest Date"
    from    apns_classified
    group by Campaign_Name, product_code_to_adobe
    order by Campaign_Name, product_code_to_adobe;
quit;


/* ============================================================
   STEP 3: ROLLUP TOTALS PER CAMPAIGN
   ============================================================ */

proc sql;
    create table rollup_summary as
    select  Campaign_Name,
            "-- TOTAL"          as Product_Code      label = "Product Code",
            sum(Loaded)         as Loaded            label = "Loaded into Adobe",
            sum(Sent)           as Sent              label = "Sent (In Transit)",
            sum(Not_Loaded)     as Not_Loaded        label = "Not Loaded Yet",
            sum(Failed)         as Failed            label = "Failed / Dropped",
            sum(Total)          as Total             label = "Total Records",
            min(Earliest_Date)  as Earliest_Date     format date9. label = "Earliest Date",
            max(Latest_Date)    as Latest_Date       format date9. label = "Latest Date"
    from    detail_summary
    group by Campaign_Name
    order by Campaign_Name;
quit;


/* ============================================================
   STEP 4: STACK DETAIL + ROLLUP, SORT SO TOTALS APPEAR LAST
   ============================================================ */

data final_summary;
    set detail_summary
        rollup_summary;
run;

proc sort data=final_summary;
    by Campaign_Name descending (Product_Code = '-- TOTAL') Product_Code;
run;


/* ============================================================
   STEP 5: PRINT RESULTS
   ============================================================ */

title  "APN Campaign Status Summary";
title2 "Loaded / Sent / Not Loaded Yet / Failed";

proc print data=final_summary noobs label;
    var Campaign_Name Product_Code Loaded Sent Not_Loaded Failed Total
        Earliest_Date Latest_Date;
run;

title;
