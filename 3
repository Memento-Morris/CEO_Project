data APNS_sends_campaigns (keep=cust_no mucn product_code Date_loaded
                                Time Drop_reason brand Delivery_code);
  set APNS.apn_sends_and_feedback;
  where product_code in (&product_codes.)
    and datepart(Distribution_date) >= "&min_date."d;
  Brand         = substr(mucn, 1, 3);
  Drop_reason   = "";
  Date_loaded   = datepart(Distribution_date);
  format Date_loaded date9.;
  Time          = timepart(Distribution_date);
  format Time time9.;
  Delivery_code = UPCASE(Delivery_code);
run;


/* ============================================================
   SECTION 8: ADOBE DROP-OFFS
   FIX 1: Added cust_no = ucn.
          ADOBE_DROP_OFFS_DATA has no cust_no column. ucn is
          the numeric customer identifier in this view and maps
          directly to cust_no used in the Section 12 join.
          Without this assignment every drop-off row joined
          with cust_no2 = . producing zero right-side matches.
   ============================================================ */

data Adobe_recent_drops;
  set APNS.adobe_drop_offs_data;
  where product_code in (&product_codes.)
    and datepart(Date_loaded) >= "&min_date."d;
  cust_no       = ucn;             /* FIX 1 */
  Date_loaded   = datepart(Date_loaded);
  format Date_loaded date9.;
  Time          = timepart(Date_loaded);
  format Time time9.;
  Brand         = substr(mucn, 1, 3);
  Delivery_code = "";
run;


/* ============================================================
   SECTION 9: COMBINE ADOBE DATA
   FIX 2: Explicit length statement added before SET.
          ADOBE_DROP_OFFS_DATA defines mucn as $1000 and
          product_code / drop_reason as $1000. Without this,
          SAS inherits the wider length from the first dataset
          that defines these columns, bloating all downstream
          tables and risking garbled substr(mucn,1,3) output.
   ============================================================ */

data adobe_to_clients_step;
  length mucn         $28             /* FIX 2 */
         product_code $29             /* FIX 2 */
         drop_reason  $50;            /* FIX 2 */
  set Adobe_recent_drops
      APNS_sends_campaigns;
run;

data adobe_to_clients_final (drop=etl_source_data etl_date daymonth);
  set adobe_to_clients_step;
  if drop_reason  = "" then success = 1; else success = 0;
  if drop_reason ne "" then drop    = 1; else drop    = 0;
run;


/* ============================================================
   SECTION 10: OPTIMISE TABLE PREP FOR JOIN
   ============================================================ */

data campaigns_to_adobe_step (keep=Optimize sub_segment Drop_reason product_code
                                   cust_no Date_to_adobe Time_created_to_adobe
                                   Campaign_name mucn success_to_adobe drop_to_adobe);
  set campaigns_to_adobe;
  if drop_reason ne "" then optimize = drop_reason; else optimize = "Sent";
  if drop_reason  = "" then success_to_adobe = 1;   else success_to_adobe = 0;
  if drop_reason ne "" then drop_to_adobe = 1;      else drop_to_adobe = 0;
run;

proc sql;
create table adobe_leads as
select count(*) as adobe_leads,
       product_code, sub_segment, campaign_name, date_to_adobe, optimize
from campaigns_to_adobe_step
group by product_code, sub_segment, campaign_name, date_to_adobe, optimize
order by date_to_adobe;
quit;

proc sql;
create table leads_summary as
select sum(adobe_leads) as Leads_Total,
       product_code, campaign_name, date_to_adobe, optimize
from adobe_leads
group by product_code, campaign_name, date_to_adobe, optimize;
quit;

proc sql;
create table adobe_summary_client as
select count(product_code) as Client_Sent,
       product_code, date_loaded, drop_reason
from adobe_to_clients_final
group by product_code, date_loaded, drop_reason;
quit;

proc sql;
create table optimize_adobe_sum as
select *
from leads_summary a
left join adobe_summary_client b
  on a.product_code = b.product_code
where a.date_to_adobe <= b.date_loaded
order by date_to_adobe, date_loaded desc;
quit;

data optimize_adobe_sum_2;
  set optimize_adobe_sum;
  day_diff = intck('day', date_to_adobe, date_loaded);
run;

proc sql;
create table optimize_adobe_sum_3 as
select *
from optimize_adobe_sum_2
group by product_code, date_to_adobe
having min(intck('day', date_to_adobe, date_loaded));
quit;


/* ============================================================
   SECTION 11: RENAME COLUMNS FOR FINAL JOIN
   FIX 3: Explicit length declarations added before SET.
          SAS sets character variable length from the first
          literal it encounters in the data step. "TEST" (4
          chars) was anchoring testindicator at $4, silently
          truncating "Actual" to "Actu". The same mechanism
          was truncating long Adobe / Client strings.
          length Adobe $50 Client $50 testindicator $6 fixes
          all three. $50 also covers the longest Adobe value:
          "Not loaded into Adobe within 60 days" (37 chars).
   ============================================================ */

data campaigns_to_adobe_renamed;
  set campaigns_to_adobe_step;
  rename Drop_Reason  = Drop_reason_to_adobe;
  rename mucn         = mucn_to_adobe;
  rename product_code = product_code_to_adobe;
run;

data adobe_to_clients_step (drop=success drop);
  length Adobe         $50             /* FIX 3 */
         Client        $50             /* FIX 3 */
         testindicator $6;             /* FIX 3 */
  set adobe_to_clients_final;
  if upcase(delivery_code) = "TEST"  then Adobe  = "TEST";
  else if delivery_code ne ""        then Adobe  = "Loaded";
  else Adobe = drop_reason;

  if upcase(delivery_code) = "TEST"  then Client = "TEST";
  else if delivery_code ne ""        then Client = "Sent";
  else Client = drop_reason;
run;

proc sql;
create table adobe_delivery_tes as
select distinct Cust_no, date_loaded, product_code, "TEST" as testindicator
from adobe_to_clients_step
where delivery_code = "TEST";
quit;

proc sql;
create table adobe_final as
select a.*, b.testindicator
from adobe_to_clients_step a
left join adobe_delivery_tes b
  on  a.cust_no      = b.Cust_no
  and a.date_loaded  = b.date_loaded
  and a.product_code = b.product_code;
quit;

data adobe_final_table_clients;
  length testindicator $6;           /* FIX 3 - guard on re-assignment too */
  set adobe_final;
  if strip(testindicator) = "TEST" then do;
    testindicator = "TEST";
    Adobe  = "TEST";
    Client = "TEST";
  end;
  else testindicator = "Actual";
  rename cust_no = cust_no2;
run;


/* ============================================================
   SECTION 12: FINAL JOIN - OPTIMISE + ADOBE
   FIX 4: BETWEEN window widened from + 5 to + 60.
          Analysis confirmed Adobe loads occurring up to 46
          days after the optimise date. The original + 5
          window was silently dropping ~409k valid matches,
          causing blank Adobe values for all Sent records.
          Window set to + 60 to provide safe buffer beyond
          the confirmed 46-day maximum gap.
   ============================================================ */

proc sql;
create table joining as
select *
from campaigns_to_adobe_renamed a
left join adobe_final_table_clients b
  on  a.cust_no               = b.cust_no2
  and a.product_code_to_adobe  = b.product_code
  and (b.date_loaded between a.date_to_adobe and a.date_to_adobe + 60); /* FIX 5 */
quit;

data APNS_DATA (drop=Time product_code mucn mucn_to_adobe
                     success_to_adobe drop_to_adobe);
  set joining;
  if missing(Cust_no2) and Optimize = "Sent"
    then Adobe = "Not loaded into Adobe within 60 days";        /* FIX 5 */
  if missing(cust_no2) and Optimize = "Sent"
    and intck('day', date_to_adobe, today()) <= 60              /* FIX 5 */
    and missing(Date_loaded)
    then Adobe = "Sending to Adobe";
  date_Diff = intck('day', date_to_adobe, date_loaded);
run;

proc sort data=APNS_DATA;
  by cust_no product_code_to_adobe date_to_adobe descending date_loaded;
run;

proc sort data=APNS_DATA nodupkey
  out=APNS_Data_Final;
  by cust_no product_code_to_adobe date_to_adobe;
run;

data APNS_DATA;
  set APNS_Data_Final;
run;


/* ============================================================
   SECTION 13: LOAD TO PRODUCTION - WITH ZERO-ROW SAFETY GATE
   ============================================================ */

%macro Loadtable(Table);
  %if %sysfunc(exist(&table.)) %then %do;

    proc sql noprint;
      select count(*) into :new_row_count trimmed
      from &Table.;
    quit;

    %if &new_row_count = 0 %then %do;
      %put ERROR: =====================================================;
      %put ERROR: &Table. has ZERO rows - aborting production load.;
      %put ERROR: STI_PBI.&Table. has NOT been updated.;
      %put ERROR: Check campaign config, date extraction and joins.;
      %put ERROR: =====================================================;
      %abort cancel;
    %end;
    %else %do;
      %put NOTE: &Table. has &new_row_count rows - loading to production.;
      proc sql;
        drop table STI_PBI.&Table.;
        create table STI_PBI.&Table. as
        select * from &Table.;
      quit;
    %end;

