    Adobe  = "TEST";
    Client = "TEST";
  end;
  else if delivery_code ne "" then do;
    Adobe  = "      Loaded                                    ";
    Client = "      Sent                                              ";
  end;
  else do;
    Adobe  = drop_reason;
    Client = drop_reason;
  end;

  if cust_no = "" then cust_no = UCN;
