/*==============================================================
  FILE: OCR_03_Weekly.sas
  PURPOSE: Runs every week. Handles Motor AND Non-Motor trackers.

  FIXES APPLIED:
  1. Replaced max(RunDate) subquery for resolving previous-week
     Open_Claims / Current_OCR_Amt with WeekSequence = week_num-1.
     Reason: RunDate has no time component so same-day runs
     caused closed_this_week = 0 or -1.

  2. Option A OCR tracking: Current_Estimate_OCR = original
     flagged Estimate_OCR if claim still has a live estimate,
     zero if settled. OCR reduction comes from claims closing
     only, not from reserve movements. Ensures weekly job and
     baseline script use the same field, preventing negative
     ocr_reduced values.

  3. cumul_closed and ocr_this_week derived from live snapshot
     directly (claims with Current_Estimate_OCR > 0) rather
     than baseline_claims - open_this_week, which could go
     negative if new claims were added post-baseline.

  4. OCR_Job_Log removed entirely. Audit trail not required --
     OCR_Weekly_Tracker / NM_Weekly_Tracker plus timestamped
     emails and Excel files serve as the record of each run.

  5. FIX (was broken): PROC SQL CONNECT noprompt= string was
     wrapped in %bquote(), which caused the macro parser to
     tokenise the Driver=MSSQL keyword as a macro assignment
     (ERROR 79-322: Expecting a )) and abort the INSERT.

     Root cause: %bquote() evaluates its argument first, then
     quotes the result. The '=' sign in 'Driver=MSSQL' and the
     special characters in the password (&, !, ^) are seen by
     the macro parser BEFORE quoting takes effect, corrupting
     the token stream.

     Fix applied: The noprompt= value is built in two steps:
       a. A %let macro variable holds the static part of the
          connection string using %nrstr() to suppress all
          tokenisation at definition time.
       b. At CONNECT time the variable is resolved with
          &&conn_str. -- the double-ampersand forces a second
          resolution pass so &User. and &FNB_Login. inside the
          string are expanded correctly at run time.

     This is the only pattern that:
       - Keeps Driver= visible to the parser as a plain string.
       - Allows &User. / &FNB_Login. to resolve at run time.
       - Survives passwords with &, !, ^, %, (, ) without
         breaking the macro token stream.

  6. CC recipients commented out for testing. Uncomment when
     ready to go live.
==============================================================*/

/*--------------------------------------------------------------
  Libname -- must stay in open code.
--------------------------------------------------------------*/
%include "/data/fnbins/fnbinsurance/Growth_Analytics/SASCODE/DEPLOYED/Automation/STI_CA_2/Libnames.sas";

/*--------------------------------------------------------------
  Database libname.
  NOTE: noprompt= in LIBNAME uses its own quoting -- do NOT
  wrap in %bquote() as that masks semicolons and breaks parsing.
--------------------------------------------------------------*/
%macro logging(libname, database, schema, server);
LIBNAME &libname odbc noprompt="
  Driver=MSSQL;
  AnsiNPW=1;
  AuthenticationMethod=10;
  ApplicationUsingThreads=1;
  BulkLoadOptions=2;
  Database=&database;
  FetchTWFSasTime=1;
  HostName=&server;
  PortNumber=1433;
  UID=&User.;
  PWD=&FNB_Login."
Schema=&schema;
%mend;

%logging(STI_WER, FNB_STI_Analytics, Claims, LFE-RBPREATLDB1);

/*--------------------------------------------------------------
  Run date -- override with %let rd = 20250421; for back-testing.
--------------------------------------------------------------*/
%if not %symexist(rd) %then %do;
  %let rd = %sysfunc(today(), yymmddn8.);
%end;

/*--------------------------------------------------------------
  Stale-claims threshold (months).
  Claims with ReportedMonth older than this are shown in Chart 3.
--------------------------------------------------------------*/
%let stale_months = 3;

/*--------------------------------------------------------------
  FIX #5 -- Build the ODBC connection string once, safely.

  %nrstr() suppresses ALL macro tokenisation (& % ; = etc.) at
  the point of the %let, so Driver=MSSQL is stored as a plain
  literal. &User. and &FNB_Login. are written as &&User. and
  &&FNB_Login. (double-ampersand) so they resolve on the SECOND
  macro pass -- i.e. at CONNECT time when their values are known.

  Nothing else in this file should use %bquote() on a CONNECT
  noprompt= value.
--------------------------------------------------------------*/
%let _conn_static = %nrstr(Driver=MSSQL;AnsiNPW=1;AuthenticationMethod=10;Database=FNB_STI_Analytics;HostName=LFE-RBPREATLDB1;PortNumber=1433;UID=&&User..;PWD=&&FNB_Login..);


/*==============================================================
  MOTOR WEEKLY JOB
==============================================================*/

%global cycle_id baseline_claims baseline_ocr
        baseline_ocr_fmt baseline_claims_fmt
        prev_open prev_ocr_amt
        week_num existing_rows seq_exists
        open_this_week ocr_this_week
        cumul_closed closed_this_week ocr_reduced pct_closed
        cycle_mismatch_flag rd_yyyymm outfile
        email_open_fmt email_baseline_fmt email_ocr_fmt
        email_reduced_fmt email_closed_fmt email_cumul_fmt email_pct_fmt
        claims_over_3m claims_over_3m_fmt;

%macro ocr_weekly_main;

%put NOTE: ============================================================;
%put NOTE: MOTOR WEEKLY JOB STARTED -- rd=&rd.;
%put NOTE: ============================================================;

/*--- Resolve active cycle ---*/
proc sql noprint;
  select CycleID, BaselineClaims, BaselineOCR
  into :cycle_id trimmed, :baseline_claims trimmed, :baseline_ocr trimmed
  from STI_WER.OCR_Cycle_Control
  where Status = 'ACTIVE'
  order by BaselineDate desc;
quit;

%if &sqlobs. = 0 %then %do;
  %put ERROR: No ACTIVE cycle found in OCR_Cycle_Control.;
  %put ERROR: Run OCR_02_Baseline.sas on the 16th first.;
  %abort cancel;
%end;

%put NOTE: Active Cycle ID     = &cycle_id.;
%put NOTE: Baseline Claims     = &baseline_claims.;
%put NOTE: Baseline OCR Amount = &baseline_ocr.;

%let baseline_ocr_fmt    = %sysfunc(putn(&baseline_ocr.,    comma18.2));
%let baseline_claims_fmt = %sysfunc(putn(&baseline_claims., comma10.));

/*--- Cycle / run-date mismatch flag ---*/
%let rd_yyyymm = %sysfunc(substr(&rd., 1, 6));

%if %str(&rd_yyyymm.) ne %str(&cycle_id.) %then %do;
  %put WARNING: Run date month (&rd_yyyymm.) ne active CycleID (&cycle_id.).;
  %let cycle_mismatch_flag = Y;
%end;
%else %let cycle_mismatch_flag = N;

/*--- Next week number.
      The baseline job seeds WeekSequence=0, so existing_rows=1
      on the first weekly run, giving week_num=1 naturally.     ---*/
proc sql noprint;
  select count(*)
  into :existing_rows trimmed
  from STI_WER.OCR_Weekly_Tracker
  where CycleID = "&cycle_id.";
quit;

%let week_num = &existing_rows.;
%put NOTE: Week number (next to insert) = &week_num.;

/*--- Previous week values.
      FIX #1: Use WeekSequence = week_num - 1 instead of max(RunDate).
      max(RunDate) is ambiguous when the baseline and first weekly
      job run on the same calendar day -- both rows share the same
      RunDate so the subquery returns the current row instead of
      the prior one, causing closed_this_week = 0 or -1.
      WeekSequence is always unique within a CycleID.           ---*/
proc sql noprint;
  select Open_Claims, Current_OCR_Amt
  into :prev_open trimmed, :prev_ocr_amt trimmed
  from STI_WER.OCR_Weekly_Tracker
  where CycleID      = "&cycle_id."
    and WeekSequence = %eval(&week_num. - 1);
quit;

%if &sqlobs. = 0 %then %do;
  %put ERROR: Could not resolve Open_Claims / Current_OCR_Amt from WeekSequence=%eval(&week_num.-1).;
  %abort cancel;
%end;

%put NOTE: Previous week -- Open=&prev_open. OCR=&prev_ocr_amt. Seq=%eval(&week_num.-1);

/*--- Duplicate-run guard ---*/
proc sql noprint;
  select count(*)
  into :seq_exists trimmed
  from STI_WER.OCR_Weekly_Tracker
  where CycleID = "&cycle_id." and WeekSequence = &week_num.;
quit;

%if &seq_exists. > 0 %then %do;
  %put ERROR: Row for CycleID=&cycle_id. WeekSequence=&week_num. already exists. Aborting.;
  %abort cancel;
%end;

/*--- Max-weeks guard ---*/
%if &week_num. > 5 %then %do;
  %put ERROR: WeekSequence &week_num. exceeds maximum of 5 for CycleID=&cycle_id.. Aborting.;
  %abort cancel;
%end;

%put NOTE: Guards passed -- proceeding with Week &week_num.;

/*--- Pull snapshot: Motor + Retail ---*/
data work.snapshot;
  set STI_WER.Investigate_Claims(
    keep= ClaimCode SubClaimCode ReportMonth
          Estimate_OCR ProductTypeSplit Division ClaimHandler
  );
  if upcase(strip(ProductTypeSplit)) ne 'MOTOR'  then delete;
  if upcase(strip(Division))         ne 'RETAIL' then delete;
run;

%put NOTE: Motor snapshot extracted -- &sysnobs. rows.;

/*--- Current estimates ---*/
data work.current_est;
  set STI_WER.vw_OpsClaimsReport(
    keep= SubClaimCode Total_Estimate_OCR_ExVAT Total_Paid_ExVAT
  );
run;

%put NOTE: Current estimates extracted -- &sysnobs. rows.;

/*--- Build final claims detail.
      Option A: Current_Estimate_OCR = original flagged
      Estimate_OCR if the claim still has a live estimate
      in vw_OpsClaimsReport (Total_Estimate_OCR_ExVAT > 0),
      zero if settled/closed.
      OCR reduction comes from claims closing only -- reserve
      movements do not affect the tracked OCR amount.
      This keeps the weekly figures consistent with the baseline
      which was also seeded from Estimate_OCR.                 ---*/
proc sql;
  create table work.MotorClaims_Final as
  select
      c.ClaimCode,
      c.ReportMonth                                          as ReportedMonth,
      c.ClaimHandler,
      c.Estimate_OCR                                         as Estimate_OCR_When_Flagged,
      case
        when coalesce(a.Total_Estimate_OCR_ExVAT, 0) > 0
        then round(c.Estimate_OCR, 0.01)
        else 0
      end                                                    as Current_Estimate_OCR,
      case
        when coalesce(a.Total_Estimate_OCR_ExVAT, 0) > 0
        then 0
        else -round(c.Estimate_OCR, 0.01)
      end                                                    as OCR_Movement
  from work.snapshot c
  left join work.current_est a
      on c.SubClaimCode = a.SubClaimCode
  order by c.ReportMonth desc;
quit;

%put NOTE: MotorClaims_Final built -- &sqlobs. rows.;

/*--- Count Motor claims older than &stale_months. months ---*/
proc sql noprint;
  select count(distinct ClaimCode)
  into :claims_over_3m trimmed
  from work.MotorClaims_Final
  where ReportedMonth < intnx('month', today(), -&stale_months., 'beginning');
quit;

%let claims_over_3m_fmt = %sysfunc(putn(&claims_over_3m., comma10.));
%put NOTE: Motor claims older than &stale_months. months = &claims_over_3m.;

/*--- Weekly summary metrics.
      FIX #3: open_this_week / cumul_closed / ocr_this_week all
      derived directly from the live snapshot, not from arithmetic
      against baseline_claims. This prevents negative values when
      new claims are added to the investigation list post-baseline.

      open_this_week  = claims still with a live estimate.
      ocr_this_week   = sum of ORIGINAL flagged amounts for open
                        claims (Option A -- consistent with baseline).
      cumul_closed    = claims whose live estimate is now zero.
      closed_this_week = prev_open minus open_this_week.
      ocr_reduced     = prev_ocr_amt minus ocr_this_week.      ---*/
proc sql noprint;
  select count(distinct ClaimCode), sum(Estimate_OCR_When_Flagged)
  into :open_this_week trimmed, :ocr_this_week trimmed
  from work.MotorClaims_Final
  where Current_Estimate_OCR > 0;

  select count(distinct ClaimCode)
  into :cumul_closed trimmed
  from work.MotorClaims_Final
  where Current_Estimate_OCR = 0;
quit;

%let closed_this_week = %sysevalf(&prev_open.    - &open_this_week.);
%let ocr_reduced      = %sysevalf(&prev_ocr_amt. - &ocr_this_week.);

%if %sysevalf(&baseline_claims. > 0, boolean) %then
  %let pct_closed = %sysevalf(&cumul_closed. / &baseline_claims.);
%else
  %let pct_closed = 0;

%put NOTE: Motor metrics -- Open=&open_this_week. OCR=&ocr_this_week.;
%put NOTE: Motor metrics -- CumulClosed=&cumul_closed. ClosedThisWeek=&closed_this_week.;
%put NOTE: Motor metrics -- OCRReduced=&ocr_reduced. PctClosed=&pct_closed.;

/*--- Insert weekly row.
      FIX #5: Connection string is resolved from &&_conn_static.
      The double-ampersand triggers a second macro resolution
      pass: _conn_static was stored with %nrstr() so Driver=MSSQL
      was never tokenised, and &&User.. / &&FNB_Login.. expand
      to their run-time values on the second pass.
      No %bquote() wrapper needed or used here.                ---*/
proc sql noprint;
  connect to odbc as sqlsvr (noprompt="&&_conn_static.");

  execute (
    INSERT INTO FNB_STI_Analytics.Claims.OCR_Weekly_Tracker
      (CycleID, WeekSequence, WeekLabel, RunDate,
       Baseline_Claims, Open_Claims,
       Current_OCR_Amt, Cumul_Closed, Closed_This_Week,
       OCR_Reduced_This_Week, Pct_Claims_Closed)
    VALUES (
      "&cycle_id.", &week_num., "Week &week_num.",
      CONVERT(DATE, "&rd.", 112),
      &baseline_claims., &open_this_week., &ocr_this_week.,
      &cumul_closed., &closed_this_week., &ocr_reduced., &pct_closed.
    )
  ) by sqlsvr;

  disconnect from sqlsvr;
quit;

%if &syserr. ne 0 %then %do;
  %put ERROR: INSERT into OCR_Weekly_Tracker failed. SYSERR=&syserr.. Aborting.;
  %abort cancel;
%end;

%put NOTE: OCR_Weekly_Tracker row inserted -- Week &week_num.;

/*--- Pull full tracker for this cycle (Week 1+ only for charts) ---*/
proc sql;
  create table work.tracker_this_cycle as
  select * from STI_WER.OCR_Weekly_Tracker
  where CycleID = "&cycle_id."
    and WeekSequence >= 1
  order by WeekSequence;
quit;

/*--- Claims-by-month summary (used for Chart 3) ---*/
proc sql;
  create table work.Motor_Monthly_Count as
  select
      put(ReportedMonth, yymmn6.) as MonthLabel length=7,
      count(distinct ClaimCode)   as ClaimCount
  from work.MotorClaims_Final
  where ReportedMonth < intnx('month', today(), -&stale_months., 'beginning')
  group by ReportedMonth
  order by ReportedMonth;
quit;

/*--------------------------------------------------------------
  PNG Charts
  Chart 1: OCR trend line.
  Chart 2: Claims closed bar.
  Chart 3: Claims count by reported month.
  Week 2+ only for Charts 1 & 2; Chart 3 produced every week.
--------------------------------------------------------------*/
%let png_ocr_outfile =
  /data/fnbinsurance/Short_Term/Monitoring/MotorOCR_Trend_&rd..png;
%let png_closed_outfile =
  /data/fnbinsurance/Short_Term/Monitoring/MotorOCR_Closed_&rd..png;
%let png_monthly_outfile =
  /data/fnbinsurance/Short_Term/Monitoring/MotorOCR_Monthly_&rd..png;

%if &week_num. >= 2 %then %do;

  /* Chart 1 -- OCR Amount Trend */
  ods listing image_dpi=150
    gpath="/data/fnbinsurance/Short_Term/Monitoring";
  ods graphics on / reset=all imagename="MotorOCR_Trend_&rd."
    outputfmt=png width=800px height=400px;

  title "OCR Amount Movement -- Motor Retail (CycleID &cycle_id.)";
  footnote j=left
    "Baseline: R &baseline_ocr_fmt.  |  Claims: &baseline_claims_fmt.  |  Run: &rd.";

  proc sgplot data=work.tracker_this_cycle;
    series x=WeekLabel y=Current_OCR_Amt /
      markers
      markerattrs=(symbol=circlefilled size=10 color=CX54B9AC)
      lineattrs=(thickness=2 color=CX54B9AC);
    yaxis label="Current OCR Amount (R)" grid valuesformat=comma18.;
    xaxis label="Week" discreteorder=data;
  run;

  title; footnote;
  ods graphics off;
  ods listing close;

  /* Chart 2 -- Claims Closed Bar */
  ods listing image_dpi=150
    gpath="/data/fnbinsurance/Short_Term/Monitoring";
  ods graphics on / reset=all imagename="MotorOCR_Closed_&rd."
    outputfmt=png width=800px height=400px;

  title "Claims Closed Per Week -- Motor Retail (CycleID &cycle_id.)";

  proc sgplot data=work.tracker_this_cycle;
    vbar WeekLabel / response=Closed_This_Week
      fillattrs=(color=CX54B9AC)
      datalabel
      datalabelattrs=(size=10 weight=bold);
    yaxis label="Claims Closed This Week" grid;
    xaxis label="Week" discreteorder=data;
  run;

  title;
  ods graphics off;
  ods listing close;

  %put NOTE: Motor charts 1+2 exported for Week &week_num.;

%end;
%else %do;
  %put NOTE: Week 1 -- Motor charts 1+2 deferred to Week 2+.;
%end;

/* Chart 3 -- Claims Count by Reported Month (every week) */
ods listing image_dpi=150
  gpath="/data/fnbinsurance/Short_Term/Monitoring";
ods graphics on / reset=all imagename="MotorOCR_Monthly_&rd."
  outputfmt=png width=800px height=400px;

title "Open Claims Older Than &stale_months. Months by Reported Month -- Motor Retail (CycleID &cycle_id.)";
footnote j=left "Run: &rd.  |  Claims with report month before &stale_months. months ago";

proc sgplot data=work.Motor_Monthly_Count;
  vbar MonthLabel / response=ClaimCount
    fillattrs=(color=CX54B9AC)
    datalabel
    datalabelattrs=(size=10 weight=bold);
  yaxis label="Number of Open Claims" grid;
  xaxis label="Reported Month" discreteorder=data;
run;

title; footnote;
ods graphics off;
ods listing close;

%put NOTE: Motor chart 3 exported for Week &week_num.;

/*--------------------------------------------------------------
  Export to Excel -- Claims Detail sheet ONLY.
--------------------------------------------------------------*/
%let outfile =
  /data/fnbinsurance/Short_Term/Monitoring/MotorOCR_Tracker_&rd..xlsx;

proc template;
  define style OCR_Style;
    parent = styles.excel;
    style Header /
      background  = CX54B9AC
      color       = white
      font_weight = bold;
  end;
run;

ods excel file="&outfile."
  style = OCR_Style
  options(
    sheet_name      = "Claims Detail"
    embedded_titles = "yes"
    frozen_headers  = "yes"
    autofilter      = "yes"
    flow            = "tables"
  );
  title "Motor Retail Claims Under Investigation -- Week &week_num.";
  proc print data=work.MotorClaims_Final noobs label;
    format Estimate_OCR_When_Flagged Current_Estimate_OCR OCR_Movement comma18.2;
  run;
ods excel close;
title;

%put NOTE: Motor Excel exported -- &outfile.;

/*--------------------------------------------------------------
  Pre-format email values.
--------------------------------------------------------------*/
%let email_open_fmt     = %sysfunc(putn(&open_this_week.,   comma10.));
%let email_baseline_fmt = %sysfunc(putn(&baseline_claims.,  comma10.));
%let email_ocr_fmt      = %sysfunc(putn(&ocr_this_week.,    comma18.2));
%let email_reduced_fmt  = %sysfunc(putn(&ocr_reduced.,      comma18.2));
%let email_closed_fmt   = %sysfunc(putn(&closed_this_week., comma10.));
%let email_cumul_fmt    = %sysfunc(putn(&cumul_closed.,     comma10.));
%let email_pct_fmt      = %sysfunc(putn(%sysevalf(&pct_closed.*100), 8.1));

