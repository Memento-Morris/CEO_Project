/* ============================================================
   CAMPAIGN STATUS LOOKUP — Fixed
   Change the value below and run the whole program
   ============================================================ */

%let campaign_code = CMA08896;   /* <-- CHANGE THIS (prefix only, no version suffix) */

/* ============================================================
   Libnames
   ============================================================ */

libname Pass6    "/data/fnb/clb/archive/5_optimise/passed_phase1";
libname APN_Pass "/data/fnb/clb/prod_data/5_optimise/passed_phase1";
libname Drop6    "/data/fnb/clb/archive/5_optimise/dropped_phase1";
libname APN_Drop "/data/fnb/clb/prod_data/5_optimise/dropped_phase1";
libname APNS     "/data/fnb/clb/prod_data/7_tracking_views/Reporting_views";

/* ============================================================
   STEP 1: Get matching table names from each library
   Use %str() to prevent campaign code being read as a macro
   ============================================================ */

%let srch = %upcase(%str(&campaign_code));

proc sql noprint;
  select memname into :pass6_tables     separated by '|'
  from dictionary.tables
  where libname = "PASS6"    and index(memname, "&srch") > 0;

  select memname into :passweek_tables  separated by '|'
  from dictionary.tables
  where libname = "APN_PASS" and index(memname, "&srch") > 0;

  select memname into :drop6_tables     separated by '|'
  from dictionary.tables
  where libname = "DROP6"    and index(memname, "&srch") > 0;

  select memname into :dropweek_tables  separated by '|'
  from dictionary.tables
  where libname = "APN_DROP" and index(memname, "&srch") > 0;
quit;

%put Pass 6mo tables  : &pass6_tables;
%put Pass 7day tables : &passweek_tables;
%put Drop 6mo tables  : &drop6_tables;
%put Drop 7day tables : &dropweek_tables;

/* ============================================================
   STEP 2: Stack tables — macro handles each library separately
   Uses pipe | as separator to avoid issues with spaces in names
   ============================================================ */

%macro stack_lib(libref=, tablelist=, outds=, status=);

  %let tablelist = %sysfunc(strip(&tablelist));
  %let n = %sysfunc(countw(&tablelist, |));

  %if &n = 0 or &tablelist =  %then %do;
    %put NOTE: No &status tables found in &libref for &campaign_code — skipping.;
  %end;
  %else %do;
    data &outds;
      set
      %do i = 1 %to &n;
        &libref..%scan(&tablelist, &i, |)
      %end;
      (keep= cust_no product_code drop_reason sub_segment campaign_name brand mucn);
      length status $10;
      status = "&status";
    run;
  %end;

%mend;

%stack_lib(libref=PASS6,    tablelist=&pass6_tables,    outds=passed_6mo,   status=Passed)
%stack_lib(libref=APN_PASS, tablelist=&passweek_tables, outds=passed_week,  status=Passed)
%stack_lib(libref=DROP6,    tablelist=&drop6_tables,    outds=dropped_6mo,  status=Dropped)
%stack_lib(libref=APN_DROP, tablelist=&dropweek_tables, outds=dropped_week, status=Dropped)

/* ============================================================
   STEP 3: Combine into one dataset (only include what exists)
   ============================================================ */

%macro combine;
  data all_leads;
    set
    %if %sysfunc(exist(passed_6mo))   %then passed_6mo;
    %if %sysfunc(exist(passed_week))  %then passed_week;
    %if %sysfunc(exist(dropped_6mo))  %then dropped_6mo;
    %if %sysfunc(exist(dropped_week)) %then dropped_week;
    ;
  run;
%mend;
%combine;

/* ============================================================
   STEP 4: Reports
   ============================================================ */

title "Campaign Lookup: &campaign_code";

/* Overall summary */
title2 "Overall summary";
proc sql;
  select
    count(*)                                          as Total_Leads  format comma12.,
    sum(status = "Passed")                            as Passed       format comma12.,
    sum(status = "Dropped")                           as Dropped      format comma12.,
    put(round(sum(status="Passed")/count(*)*100,0.1), 8.1) as Pass_Rate_Pct
  from all_leads;
quit;

/* Drop reason breakdown */
title2 "Drop reason breakdown (dropped records only)";
proc sql;
  select
    coalescec(drop_reason, "(blank)")   as Drop_Reason,
    count(*)                            as Count        format comma12.,
    put(round(count(*) /
        (select count(*) from all_leads where status="Dropped") * 100, 0.1), 8.1) as Pct_of_Drops
  from all_leads
  where status = "Dropped"
  group by calculated Drop_Reason
  order by Count desc;
quit;

/* Sub-segment breakdown */
title2 "Sub-segment breakdown";
proc sql;
  select
    coalescec(sub_segment,"(unknown)")  as Sub_Segment,
    count(*)                            as Total        format comma12.,
    sum(status="Passed")                as Passed       format comma12.,
    sum(status="Dropped")               as Dropped      format comma12.,
    put(round(sum(status="Passed")/count(*)*100,0.1), 8.1) as Pass_Rate_Pct
  from all_leads
  group by calculated Sub_Segment
  order by Total desc;
quit;

/* Adobe delivery status */
title2 "Adobe delivery status";
proc sql;
  select
    coalescec(upcase(delivery_code),"(no code)")  as Delivery_Code,
    count(*)                                       as Count  format comma12.
  from APNS.apn_sends_and_feedback
  where index(upcase(product_code), upcase("&srch")) > 0
  group by calculated Delivery_Code
  order by Count desc;
quit;

title;
