       agent, TO=<agent's own email>, ATTACH=(their one file only). */
    filename myemail email
        from         = "Morris.Nkomo@fnb.co.za"
        to           = "Morris.Nkomo@fnb.co.za"
        subject      = "TEST - Agent OBR Packs - %SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))"
        attach       = &AgentAttachList
