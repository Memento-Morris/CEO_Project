/* ============================================================
   SECTION 3: CAMPAIGN TABLE DISCOVERY
   Finds all physical tables whose name starts with any of the
   configured campaign codes.
   ============================================================ */

%macro build_campaign_filter(libref=, outds=);
  proc sql noprint;
    create table &outds as
    select memname, crdate
    from dictionary.tables
    where libname = upcase("&libref")
      and (
        %do i = 1 %to &camp_count;
          %if &i > 1 %then or;
          memname like "&&camp_&i..%"
        %end;
      )
    order by memname;
  quit;
%mend;

%build_campaign_filter(libref=PASS6,    outds=monthly_campaigns)
%build_campaign_filter(libref=APN_PASS, outds=weekly_campaigns)

/* Capture distinct table names and creation dates into macro vars */
proc sql noprint;
  select distinct memname into :table1-    from monthly_campaigns order by memname;
  select crdate           into :crdate1-   from monthly_campaigns order by memname;
  select count(distinct memname) into :monthly_count trimmed from monthly_campaigns;
quit;

proc sql noprint;
