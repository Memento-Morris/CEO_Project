/* ---- per-campaign change detection (funnel numbers) ----
   checksum each campaign's Passed/Pushed/Sent/Opened, compare to the
   stored value from last run, flag changed campaigns, then persist. */
proc sql noprint;
  create table _camp_now as
  select Campaign,
         input(substr(md5(catx('|', Campaign,
                    put(Passed_Optimise,best16.), put(Pushed_to_Adobe,best16.),
                    put(Sent,best16.),            put(Opened,best16.))),1,8), pib8.)
                                                  as Checksum
  from OV_FUNNEL;
quit;

proc sql noprint;
  create table _camp_cmp as
  select n.Campaign,
         n.Checksum                          as new_chk,
         p.Checksum                          as old_chk
  from _camp_now n
  left join STI_PBI.APN_OV_CAMP_STATE p on n.Campaign = p.Campaign;
quit;

data _camp_cmp;
  set _camp_cmp;
  length Updated $8;
  if missing(old_chk)        then Updated = '';        /* new campaign: no tag */
  else if new_chk ne old_chk then Updated = 'Updated';
  else                            Updated = '';
run;

/* persist this run's checksums (full replace of the state table) */
proc sql;
  delete from STI_PBI.APN_OV_CAMP_STATE;
  insert into STI_PBI.APN_OV_CAMP_STATE (Campaign, Checksum, Run_Date)
  select Campaign, Checksum, %sysfunc(today()) from _camp_now;
quit;

