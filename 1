    SHEET="Operations OBR data";
    SERVER='lfe-rbgfs01';
    PORT=9621;
RUN;

/* Filter to Servicing division and convert OpsYM (YYYYMM) to end-of-month date */
DATA Historical_Scores;
    SET OBR_History;
    WHERE Division = 'Servicing';
    KEEP Fnumber UserName Team Score OpsYM DateVar;

    Year    = INT(OpsYM / 100);
    Month   = MOD(OpsYM, 100);
    DateVar = INTNX('month', MDY(Month, 1, Year), 0, 'E');
    FORMAT DateVar DATE9.;
RUN;

/* Join to active agent list to retain only current agents */
proc sql;
    create table Leave_Score as
    select a.*, b.EmployeeNumber as EmployeeNumber2
    from Historical_Scores a
    inner join STI_PBI.STI_Servicing_Agents b
        on a.Fnumber = b.EmployeeNumber;
quit;

/* Calculate each agent's average score over the 3 months prior to OBR month.
   FIX: Write to a temp table first to avoid recursive reference warning. */
proc sql;
    create table Leave_Score_2_tmp as
    select  UserName,
            EmployeeNumber2             as employeenumber,
            round(mean(Score), 0.01)    as three_month_score
    from Leave_Score
    where DateVar between intnx('month', &OBR_Month_start_date, -3, 'b')
                      and intnx('month', &OBR_Month_start_date, -1, 'e')
    group by UserName, EmployeeNumber2;
quit;

/* Filter to currently active agents only */
proc sql;
    create table Leave_Score_2 as
    select a.*
    from Leave_Score_2_tmp a
    where a.EmployeeNumber in (select EmployeeNumber
                               from STI_PBI.STI_Servicing_Agents
                               where Active = 1);
quit;

/* Clean up temp table */
proc sql; drop table Leave_Score_2_tmp; quit;


