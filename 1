/* SECTION 1: READ CAMPAIGN CONFIG FROM EXCEL */


proc import
    datafile = "\\INS-RBFS01\Share\FNB_Insure\Campaign Profiles\APN_Campaign_Config.xlsx"
    out      = Campaign_Config_Raw
    DBMS=excelcs 
    REPLACE;
    server= 'lfe-rbgfs01';
    PORT=9621;
run;


proc sql noprint;
    select count(*) into :config_raw_count trimmed
    from Campaign_Config_Raw;
quit;

%if &config_raw_count = 0 %then %do;
    %put ERROR: Fix 21 — Campaign_Config_Raw imported successfully but contains 0 rows.;
    %put ERROR: Check that the "Config" sheet exists and has data rows below the header.;
    %abort cancel;
%end;

%put NOTE: Fix 21 — Campaign_Config_Raw imported with &config_raw_count rows. Proceeding.;

/* Fix 6: add row_num here so all downstream loops use it instead of monotonic() */
data Campaign_Config;
    set Campaign_Config_Raw;
    where upcase(strip(Active)) = "Y"
      and strip(Campaign_Code)  ne ""
      and strip(Product_Code)   ne "";
    Campaign_Code = upcase(strip(Campaign_Code));
    Product_Code  = upcase(strip(Product_Code));

    /* Fix 7: clean up new input-file columns */
    length Input_File_Path  $500
           Input_File_Name  $200
           Input_File_Sheet $100
           Input_File_Type  $10
           Full_Input_Path  $500;
    Input_File_Path  = strip(Input_File_Path);
    Input_File_Name  = strip(Input_File_Name);
    Input_File_Sheet = strip(Input_File_Sheet);
    Input_File_Type  = upcase(strip(Input_File_Type));
    Full_Input_Path  = cats(Input_File_Path, Input_File_Name);

    /* Explicit row number — used in all macro loops (Fix 6) */
    row_num = _n_;
run;

proc sql noprint;
    select count(*) into :config_count trimmed
    from Campaign_Config;
quit;
