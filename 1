  else if upcase(delivery_code) = "TEST" then Adobe = "TEST";
  else Adobe = drop_reason;

  if upcase(delivery_code) ne "" then Client  = "      Sent                                              ";
  else if upcase(delivery_code) = "TEST" then Client = "TEST";
  else Client = drop_reason;

  if cust_no = "" then cust_no = UCN;
  else cust_no = cust_no;
