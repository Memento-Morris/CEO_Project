def code_block(text):
    lines = text.strip().split("\n")
    rows = [[Paragraph(l.replace("&","&amp;").replace("<","&lt;"), style_code)] for l in lines]
    t = Table(rows, colWidths=[17*cm])
    t.setStyle(TableStyle([
        ("BACKGROUND", (0,0), (-1,-1), CODE_BG),
        ("TOPPADDING", (0,0), (-1,-1), 1),
        ("BOTTOMPADDING", (0,0), (-1,-1), 1),
        ("LEFTPADDING", (0,0), (-1,-1), 8),
        ("RIGHTPADDING", (0,0), (-1,-1), 8),
        ("LINEABOVE", (0,0), (-1,0), 0.5, BORDER),
        ("LINEBELOW", (0,-1), (-1,-1), 0.5, BORDER),
        ("LINEBEFORE", (0,0), (0,-1), 3, BLUE),
    ]))
    return t

def spec_table(headers, rows, col_widths=None):
    if col_widths is None:
        col_widths = [17*cm/len(headers)] * len(headers)
    head_style = S("TH", fontName="Helvetica-Bold", fontSize=8, textColor=WHITE)
    cell_style = S("TD", fontName="Helvetica", fontSize=8, textColor=DARK, leading=12)
    mono_style = S("TM", fontName="Courier", fontSize=7.5, textColor=BLUE, leading=12)

    def fmt(v, is_code=False):
        s = mono_style if is_code else cell_style
        return Paragraph(str(v).replace("&","&amp;").replace("<","&lt;"), s)

    tdata = [[Paragraph(h, head_style) for h in headers]]
    for row in rows:
        tdata.append([fmt(c, i > 0) for i, c in enumerate(row)])

    t = Table(tdata, colWidths=col_widths, repeatRows=1)
    t.setStyle(TableStyle([
        ("BACKGROUND", (0,0), (-1,0), BLUE),
        ("ROWBACKGROUNDS", (0,1), (-1,-1), [WHITE, LIGHT_GRAY]),
        ("GRID", (0,0), (-1,-1), 0.4, BORDER),
        ("TOPPADDING", (0,0), (-1,-1), 5),
        ("BOTTOMPADDING", (0,0), (-1,-1), 5),
        ("LEFTPADDING", (0,0), (-1,-1), 6),
        ("RIGHTPADDING", (0,0), (-1,-1), 6),
        ("VALIGN", (0,0), (-1,-1), "TOP"),
    ]))
    return t

def visual_card(tab_color, title, rows):
    header_style = S("VH", fontName="Helvetica-Bold", fontSize=9, textColor=WHITE)
    label_style = S("VL", fontName="Helvetica-Bold", fontSize=8, textColor=DARK)
    val_style = S("VV", fontName="Courier", fontSize=8, textColor=BLUE, leading=12)

    data = [[Paragraph(title, header_style), ""]]
    for label, val in rows:
        data.append([Paragraph(label, label_style), Paragraph(val.replace("<","&lt;"), val_style)])

    t = Table(data, colWidths=[5*cm, 12*cm])
    t.setStyle(TableStyle([
        ("BACKGROUND", (0,0), (-1,0), tab_color),
        ("SPAN", (0,0), (-1,0)),
        ("ROWBACKGROUNDS", (0,1), (-1,-1), [WHITE, LIGHT_GRAY]),
        ("GRID", (0,0), (-1,-1), 0.4, BORDER),
        ("TOPPADDING", (0,0), (-1,-1), 5),
        ("BOTTOMPADDING", (0,0), (-1,-1), 5),
        ("LEFTPADDING", (0,0), (-1,-1), 6),
        ("RIGHTPADDING", (0,0), (-1,-1), 6),
        ("VALIGN", (0,0), (-1,-1), "TOP"),
    ]))
    return t

