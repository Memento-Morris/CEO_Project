SELECT 
    c.ClaimCode,
    c.ReportMonth                         AS ReportedMonth,
    c.Estimate_OCR                        AS Estimate_OCR_When_Flagged,
    ROUND(a.Total_Estimate_OCR_ExVAT, 2)  AS Current_Estimate_OCR,
    ROUND(a.Total_Estimate_OCR_ExVAT, 2) 
        - c.Estimate_OCR                  AS OCR_Movement
FROM 
    FNB_STI_Analytics.Claims.Investigate_Claims c
LEFT JOIN 
    [FNB_STI_Analytics].[Claims].[vw_OpsClaimsReport] a
    ON c.SubClaimCode = a.SubClaimCode
LEFT JOIN 
    (SELECT SubClaimCode
     FROM FNB_STI_Analytics.Claims.vw_OCR_Claim_Age 
     WHERE Investigate_Flag = 'Investigate') b
    ON c.SubClaimCode = b.SubClaimCode
WHERE 
    c.ProductTypeSplit = 'Motor'
    AND c.Division = 'Retail'
    AND ISNULL(a.Total_Estimate_OCR_ExVAT, 0) > 0
ORDER BY 
    c.ReportMonth DESC;
