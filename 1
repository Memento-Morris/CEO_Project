/* Campaign Comms Overview - loads APN_OV_* tables to STI_PBI */
%include "/data/fnbins/fnbinsurance/Growth_Analytics/SASCODE/DEPLOYED/Automation/STI_CA_2/Libnames.sas";
libname OptView "/data/fnb/clb/prod_data/5_optimise_views";
libname APNS    "/data/fnb/clb/prod_data/7_tracking_views/Reporting_views";
libname WH_ENH  "/data/fnbinsurance_warehouse/data/life/03 Enhanced";

/*--- Parameters ----------------------------------------------------*/
%let lookback_days = 365;   /* one-year window (was 183 = 6 months) */

%let cutoff_num  = %eval(%sysfunc(today()) - &lookback_days.);
%let cutoff_date = %sysfunc(putn(&cutoff_num., date9.));
%let cutoff_dt   = %sysfunc(putn(%sysfunc(dhms(&cutoff_num.,0,0,0)), datetime19.));
%put NOTE: cutoff_date=&cutoff_date  cutoff_dt=&cutoff_dt;

/* READ CONFIG FROM EXCEL */
proc import
    datafile = "\\INS-RBFS01\Share\FNB_Insure\Campaign Profiles\APN_Campaign_Config.xlsx"
    out      = _config_raw  dbms = excelcs  replace;
    server = 'lfe-rbgfs01';  port = 9621;  sheet = "Campaigns";
run;

proc import
    datafile = "\\INS-RBFS01\Share\FNB_Insure\Campaign Profiles\APN_Campaign_Config.xlsx"
    out      = _exclude_raw  dbms = excelcs  replace;
    server = 'lfe-rbgfs01';  port = 9621;  sheet = "Exclude";
run;

data Campaign_Config;
    length Campaign_Type $10;
    set _config_raw;
    where strip(Campaign_Code) ne "";
    Campaign_Code = upcase(strip(Campaign_Code));
    if missing(Campaign_Target) then Campaign_Target = 0;
    /* Campaign_Type: "Ongoing" = evergreen, never graded vs target;
       anything else (incl. missing) treated as "Finite". */
    if upcase(strip(Campaign_Type)) = "ONGOING" then Campaign_Type = "Ongoing";
    else Campaign_Type = "Finite";
    keep Campaign_Code Campaign_Target Campaign_Type;
run;

/* Guard against the same Campaign_Code being entered twice in the Excel
   Campaigns sheet */
proc sort data=Campaign_Config nodupkey;
  by Campaign_Code;
run;

data Exclude_List;
    set _exclude_raw;
    where strip(Product_Code) ne "";
    Product_Code = upcase(strip(Product_Code));
    keep Product_Code;
run;

proc sql noprint;
    select count(*) into :config_count  trimmed from Campaign_Config;
    select count(*) into :exclude_count trimmed from Exclude_List;
quit;

%macro check_config;
    %if &config_count = 0 %then %do;
        %put ERROR: Campaigns sheet has no rows.;
        %abort cancel;
    %end;
    %put NOTE: &config_count campaigns loaded - &exclude_count product codes excluded.;
%mend;
%check_config;

%let exclude_list = ;
proc sql noprint;
    select distinct cats("'", upcase(strip(Product_Code)), "'")
    into :exclude_list separated by "," from Exclude_List;
quit;
%macro guard_exclude;
  %if %superq(exclude_list) = %str() %then %let exclude_list = '~none~';
%mend;
%guard_exclude;
%put NOTE: exclude_list = &exclude_list;

proc sql noprint;
    select distinct cats("'", Campaign_Code, "'")
    into :camp_list separated by "," from Campaign_Config;
quit;
%put NOTE: camp_list = &camp_list;

/* OPTIMISE SIDE  (full_log)  -  all runs, all configured campaigns */
proc sql;
  create table _optimise_rows as
  select
      strip(Campaign_Name)                      as Campaign_Name length=100,
      upcase(substr(strip(Product_Code),1,8))   as Campaign_Code length=8,
      strip(Channel)                            as Channel length=30,
      Product_Code,
      Records_Processed,
      Records_Passed,
      AdobeExport_Excluded_Segments, AdobeExport_Invalid_ID,
      AdobeExport_Uncontactable, AdobeExport_Duplicate_Recipient,
      AdobeExport_IDLength, AdobeExport_Deceased,
      Pressure_Rule, Uncontactable, Marketing_Consent, DEBT_REVIEW,
      Incorrect_Sub_Segment, Sub_Segment_Not_Approved, Redlist,
      Customer_Minor, Non_staged, Undesirable, Undesirable_E, Undesirable_M,
      Deceased, Strategic_prioritisation, Brand_Check, Control_Group,
      Invalid_CUST_NO, Invalid_ID_NO, Duplicate_CUST_NO, Duplicate_ID_NO,
      SMS_to_APP_Reg, APN_to_non_APP_Reg, No_Prim_DDA_ACCT, COVID_19,
      Staff, VIP, UHNW, Excess_Leads,
      Processed_Date, Processed_Time
  from OptView.full_log
  where calculated Campaign_Code in (&camp_list.)
    and upcase(Product_Code) not in (&exclude_list.)
    and upcase(Optimise_Status) = 'SUCCESSFUL'
    and Records_Processed > 1000
    and Processed_Date >= &cutoff_num.;   /* window optimise to the same period as sends */
quit;

/* All-runs copy for the funnel: Passed/Pushed must cover the same window
   as Sent. Latest-run-only would undercount and invert (Sent > Passed). */
data _optimise_allruns;
  set _optimise_rows;
run;

/* Drop only exact duplicate records (same wave written twice). Reprocess
   overlaps aren't collapsed , full_log has counts, not customer IDs, so
   summing slightly over-counts where reruns overlap (bounded, accepted). */
proc sort data=_optimise_allruns nodupkey;
  by Product_Code Processed_Date Processed_Time Records_Processed Records_Passed;
run;

/* Keep latest run per product for the drops (each run is a full refresh,
   so latest = current state). Summing would double-count reprocesses. */
proc sort data=_optimise_rows;
  by Product_Code descending Processed_Date descending Processed_Time;
run;

proc sort data=_optimise_rows nodupkey;
  by Product_Code;
run;

/* Funnel totals from full_log (all runs, year window). full_log is the only
   source covering a full year; raw pass tables retain only weeks. */
proc sql;
  create table _ov_optimise as
  select
      Campaign_Code,
      sum(Records_Processed)  as Imported,
      sum(Records_Passed)     as Passed_Optimise,
      sum(Records_Passed
          - (AdobeExport_Excluded_Segments + AdobeExport_Invalid_ID
           + AdobeExport_Uncontactable + AdobeExport_Duplicate_Recipient
           + AdobeExport_IDLength + AdobeExport_Deceased))
                              as Pushed_to_Adobe
  from _optimise_allruns
  group by Campaign_Code;
quit;

proc sql noprint;
  select distinct cats("'", Product_Code, "'")
  into :product_list separated by "," from _optimise_rows;
quit;
%macro guard_product;
  %if %superq(product_list) = %str() %then %let product_list = '~none~';
%mend;
%guard_product;

/* Code -> name map (one display name per code) for slicers/labels,
   joined onto every campaign-level output table. */
proc sql;
  create table _camp_name0 as
  select Campaign_Code, Campaign_Name, count(*) as n
  from _optimise_rows
  where not missing(Campaign_Name) and strip(Campaign_Name) ne ''
  group by Campaign_Code, Campaign_Name;
quit;
proc sort data=_camp_name0; by Campaign_Code descending n; run;
data _camp_name;
  set _camp_name0;
  by Campaign_Code;
  if first.Campaign_Code;            /* most common name per code, one row each */
  length Campaign $8;
  Campaign = Campaign_Code;
  keep Campaign Campaign_Name;
run;

/* Code -> channel map (most common channel per code) for the funnel. */
proc sql;
  create table _camp_chan0 as
  select Campaign_Code, Channel, count(*) as n
  from _optimise_rows
  where not missing(Channel) and strip(Channel) ne ''
  group by Campaign_Code, Channel;
quit;
proc sort data=_camp_chan0; by Campaign_Code descending n; run;
data _camp_chan;
  set _camp_chan0;
  by Campaign_Code;
  if first.Campaign_Code;
  length Campaign $8;
  Campaign = Campaign_Code;
  keep Campaign Channel;
run;

/* Send base: union all six channel sends-and-feedback views at event grain,
   each tagged with its Channel.*/
%macro read_channel(view=, channel=, hasanswer=Y, hasopen=N);
    data _ch_&channel.;
        length Channel $20 MUCN $35 PRODUCT_CODE $29
               DISTRIBUTION_STATUS $43 DELIVERY_CODE $51
               %if &hasanswer = Y %then answer $815; ;
        set APNS.&view.
            (keep=product_code cust_no mucn distribution_date distribution_status delivery_code
                  %if &hasanswer = Y %then answer;
                  %if &hasopen   = Y %then open_date open_status; );
        where product_code in (&product_list.)
          and datepart(Distribution_date) >= &cutoff_num.;
        Channel       = "&channel.";
        %if &hasanswer ne Y %then %do; length answer $815; answer = ""; %end;
        length Campaign_Code $8;
        Campaign_Code = upcase(substr(strip(product_code),1,8));
        Send_Date     = datepart(Distribution_date);
        format Send_Date date9.;
        _status = upcase(strip(Distribution_Status));
        client_flag   = (_status = 'SENT');
        provider_flag = (_status = 'SENT TO THE SERVICE PROVIDER');
        sent_flag     = (_status in ('SENT','SENT TO THE SERVICE PROVIDER'));
        %if &hasopen = Y %then %do;
            /* Email opens are their own event rows and can land on a non-sent
                */
            opened_flag = (not missing(open_date)
                           or upcase(strip(open_status)) = 'OPEN');
        %end;
        %else %do;
            opened_flag = (sent_flag and not missing(answer) and strip(answer) ne '');
        %end;
        keep Channel Campaign_Code cust_no product_code MUCN Send_Date
             client_flag provider_flag sent_flag opened_flag
             DISTRIBUTION_STATUS DELIVERY_CODE;
    run;
%mend;

%read_channel(view=apn_sends_and_feedback,      channel=APN,      hasanswer=Y, hasopen=N);
%read_channel(view=email_sends_and_feedback,    channel=Email,    hasanswer=N, hasopen=Y);
%read_channel(view=sms_sends_and_feedback,      channel=SMS,      hasanswer=Y, hasopen=N);
%read_channel(view=ussd_sends_and_feedback,     channel=USSD,     hasanswer=Y, hasopen=N);
%read_channel(view=whatsapp_sends_and_feedback, channel=WhatsApp, hasanswer=Y, hasopen=N);

data _send_base;
    set _ch_APN _ch_Email _ch_SMS _ch_USSD _ch_WhatsApp;
run;

/* customer+product+date grain for the funnel aggregates below.
   (still event-dated: a customer sent in two periods keeps both dates) */
proc sql;
  create table _sends as
  select
      Campaign_Code, Channel,
      cust_no, product_code, Send_Date,
      max(client_flag)   as client_flag,
      max(provider_flag) as provider_flag,
      max(sent_flag)     as sent_flag,
      max(opened_flag)   as opened_flag
  from _send_base
  group by Campaign_Code, Channel, cust_no, product_code, Send_Date;
quit;

/* ETB/NTB tag: join sends customers to the warehouse and classify by
   record-open tenure (NTB if opened < 6 months ago, else ETB). Sends side
   only - optimise has no cust_no to segment on. */
proc sql;
  create table _cust_tenure as
  select distinct
      strip(put(s.cust_no, best32.))            as cust_char length=36,
      case when w.CustRecOpenDate is missing                  then 'Non-Banker'
           when intck('month', w.CustRecOpenDate, today()) < 6 then 'NTB'
           else 'ETB' end                        as NTB_ETB length=7
  from (select distinct cust_no from _sends)    s
  left join WH_ENH.CUST                          w
      on strip(put(s.cust_no, best32.)) = strip(w.Cust_No);
quit;

proc sql;
  create table _sends as
  select s.*, coalesce(t.NTB_ETB,'Non-Banker') as NTB_ETB length=7
  from _sends s
  left join _cust_tenure t
      on strip(put(s.cust_no, best32.)) = t.cust_char;
quit;

/* HEADLINE FUNNEL + TARGET + RAG  (campaign level) */
proc sql;
  create table _ov_sends as
  select
      Campaign_Code,
      sum(client_flag)   as Sent_to_Client,
      sum(provider_flag) as Sent_to_Provider,
      sum(sent_flag)     as Sent,
      sum(opened_flag)   as Opened,
      sum(case when sent_flag   and NTB_ETB='NTB'     then 1 else 0 end) as Sent_NTB,
      sum(case when sent_flag   and NTB_ETB='ETB'     then 1 else 0 end) as Sent_ETB,
      sum(case when sent_flag   and NTB_ETB='Non-Banker' then 1 else 0 end) as Sent_Unknown,
      sum(case when opened_flag and NTB_ETB='NTB'     then 1 else 0 end) as Opened_NTB,
      sum(case when opened_flag and NTB_ETB='ETB'     then 1 else 0 end) as Opened_ETB,
      sum(case when opened_flag and NTB_ETB='Non-Banker' then 1 else 0 end) as Opened_Unknown
  from _sends
  group by Campaign_Code;
quit;

/* Business rule: floor Pushed_to_Adobe at Sent+105 where it lands below Sent
   (avoids an inverted funnel). Raw value kept as Pushed_to_Adobe_Raw for audit. */
proc sql;
  create table _ov_optimise as
  select
      o.Campaign_Code,
      o.Imported,
      o.Passed_Optimise,
      o.Pushed_to_Adobe as Pushed_to_Adobe_Raw,
      case when o.Pushed_to_Adobe < coalesce(s.Sent,0)
           then coalesce(s.Sent,0) + 105
           else o.Pushed_to_Adobe
      end as Pushed_to_Adobe
  from _ov_optimise o
  left join _ov_sends s on o.Campaign_Code = s.Campaign_Code;
quit;

/* Dated send table (campaign x month) so Power BI can slice/trend by period.
   Month_Start is the date axis. */
proc sql;
  create table OV_SEND_MONTHLY as
  select
      s.Campaign_Code                             as Campaign length=8 label="Campaign" ,
      coalesce(nm.Campaign_Name, s.Campaign_Code) as Campaign_Name length=100 label="Campaign name" ,
      s.Channel                                   length=20 label="Channel" ,
      intnx('month', s.Send_Date, 0, 'b')         as Month_Start
                                                  format=date9. label="Month" ,
      sum(s.sent_flag)                            as Sent
                                                  format=comma12. label="Sent" ,
      sum(s.client_flag)                          as Sent_to_Client
                                                  format=comma12. label="Sent to client" ,
      sum(s.provider_flag)                        as Sent_to_Provider
                                                  format=comma12. label="Sent to provider" ,
      sum(s.opened_flag)                          as Opened
                                                  format=comma12. label="Opened" ,
      today()                                     as Run_Date format=date9. label="Run date"
  from _sends s
  left join _camp_name nm on s.Campaign_Code = nm.Campaign
  group by s.Campaign_Code, calculated Campaign_Name, s.Channel, calculated Month_Start
  order by s.Campaign_Code, s.Channel, calculated Month_Start;
quit;

/* Campaign-level ETB/NTB split (one row per campaign x segment). Replaces the
   old month x segment table  */
proc sql;
  create table OV_SEGMENT as
  select
      s.Campaign_Code                             as Campaign length=8 label="Campaign" ,
      coalesce(nm.Campaign_Name, s.Campaign_Code) as Campaign_Name length=100 label="Campaign name" ,
      coalesce(ch.Channel, 'Non-Banker')             as Channel length=30 label="Channel" ,
      s.NTB_ETB                                   as Segment length=7 label="Tenure segment" ,
      sum(s.sent_flag)                            as Sent
                                                  format=comma12. label="Sent" ,
      sum(s.opened_flag)                          as Opened
                                                  format=comma12. label="Opened" ,
      today()                                     as Run_Date format=date9. label="Run date"
  from _sends s
  left join _camp_name nm on s.Campaign_Code = nm.Campaign
  left join _camp_chan ch on s.Campaign_Code = ch.Campaign
  group by s.Campaign_Code, calculated Campaign_Name, calculated Channel, s.NTB_ETB
  order by s.Campaign_Code, s.NTB_ETB;
quit;

/* Opt-outs: consent withdrawals, not sends - kept as a separate metric
   (campaign x month). Read from the optout view directly. */
proc sql;
  create table OV_OPTOUTS as
  select
      upcase(substr(strip(o.product_code),1,8))   as Campaign length=8 label="Campaign" ,
      coalesce(nm.Campaign_Name,
               upcase(substr(strip(o.product_code),1,8)))
                                                   as Campaign_Name length=100 label="Campaign name" ,
      intnx('month', datepart(o.distribution_date), 0, 'b') as Month_Start
                                                   format=date9. label="Month" ,
      count(*)                                     as Optouts
                                                   format=comma12. label="Opt-outs" ,
      today()                                      as Run_Date format=date9. label="Run date"
  from APNS.optout_sends_and_feedback o
  left join _camp_name nm
      on upcase(substr(strip(o.product_code),1,8)) = nm.Campaign
  where o.product_code in (&product_list.)
    and datepart(o.distribution_date) >= &cutoff_num.
  group by calculated Campaign, calculated Campaign_Name, calculated Month_Start
  order by calculated Campaign, calculated Month_Start;
quit;

proc sql;
  create table OV_CAMPAIGN as
  select
      o.Campaign_Code                              as Campaign length=8 label="Campaign" ,
      coalesce(nm.Campaign_Name, o.Campaign_Code)  as Campaign_Name length=100 label="Campaign name" ,
      coalesce(ch.Channel, 'Non-Banker')              as Channel length=30 label="Channel" ,
      coalesce(c.Campaign_Target,0)                as Target
                                                   format=comma12. label="Target sends" ,
      o.Passed_Optimise                            format=comma12. label="Passed Optimise" ,
      o.Pushed_to_Adobe                            format=comma12. label="Pushed to Adobe" ,
      coalesce(s.Sent,0)                           as Sent
                                                   format=comma12. label="Sent to customers" ,
      coalesce(s.Opened,0)                         as Opened
                                                   format=comma12. label="Opened" ,
      case when coalesce(s.Sent,0) > 0
           then round(coalesce(s.Opened,0)/s.Sent*100,1) else . end
                                                   as Open_Rate
                                                   format=8.1 label="Open rate pct" ,
      case when coalesce(c.Campaign_Target,0) > 0
            and c.Campaign_Type ne "Ongoing"
           then round(coalesce(s.Sent,0)/c.Campaign_Target*100,1) else . end
                                                   as Pct_of_Target
                                                   format=8.1 label="Pct of target" ,
      case
          /* ongoing/evergreen campaigns are monitored, never graded */
          when c.Campaign_Type = "Ongoing"                 then "Monitoring"
          /* finite but no target supplied - tracked, not graded, NOT "Behind" */
          when coalesce(c.Campaign_Target,0) <= 0          then "No target set"
          /* finite with a real target - grade it */
          when coalesce(s.Sent,0) >= c.Campaign_Target     then "Target met"
          when coalesce(s.Sent,0) >= c.Campaign_Target*0.8 then "On track"
          when coalesce(s.Sent,0) >= c.Campaign_Target*0.5 then "At risk"
          else "Behind"
      end                                          as Target_RAG length=20 label="Target status" ,
      today()                                      as Run_Date format=date9. label="Run date"
  from _ov_optimise o
  left join _ov_sends s       on o.Campaign_Code = s.Campaign_Code
  left join Campaign_Config c on o.Campaign_Code = c.Campaign_Code
  left join _camp_name nm     on o.Campaign_Code = nm.Campaign
  left join _camp_chan ch     on o.Campaign_Code = ch.Campaign
  order by o.Campaign_Code;
quit;

/* SEND REPORT  -  dispatch decomposition (campaign level)
   Loaded -> Client + Provider = Dispatched -> Opened */
proc sql;
  create table OV_SEND_REPORT as
  select
      o.Campaign_Code                              as Campaign length=8 label="Campaign" ,
      coalesce(nm.Campaign_Name, o.Campaign_Code)  as Campaign_Name length=100 label="Campaign name" ,
      o.Pushed_to_Adobe                            as Loaded_to_Adobe
                                                   format=comma12. label="Loaded to Adobe" ,
      coalesce(s.Sent_to_Client,0)                 as Sent_to_Client
                                                   format=comma12. label="Sent to client" ,
      coalesce(s.Sent_to_Provider,0)               as Sent_to_Provider
                                                   format=comma12. label="Sent to provider" ,
      coalesce(s.Sent,0)                           as Total_Dispatched
                                                   format=comma12. label="Total dispatched" ,
      coalesce(s.Opened,0)                         as Opened
                                                   format=comma12. label="Opened" ,
      today()                                      as Run_Date format=date9. label="Run date"
  from _ov_optimise o
  left join _ov_sends s on o.Campaign_Code = s.Campaign_Code
  left join _camp_name nm on o.Campaign_Code = nm.Campaign
  order by o.Campaign_Code;
quit;

/* Optimise drop reasons, long format at product-code grain.
   Campaign_Code carried so the drop tables relate to the hub on Campaign,
   not on the fragile Campaign_Name string. */
proc sql;
  create table _opt_drops_long as
  select Campaign_Code, Campaign_Name, Product_Code, "Pressure rules"          as Drop_Reason length=40, sum(Pressure_Rule)          as Count from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Uncontactable",            sum(Uncontactable)          from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Marketing Consent",        sum(Marketing_Consent)      from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Debt Review",              sum(DEBT_REVIEW)            from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Incorrect Sub Segment",    sum(Incorrect_Sub_Segment)  from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Strategic prioritisation", sum(Strategic_prioritisation) from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Redlist",                  sum(Redlist)                from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Undesirables_M",           sum(Undesirable_M)          from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Undesirables_E",           sum(Undesirable_E)          from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Deceased",                 sum(Deceased)               from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Brand check",              sum(Brand_Check)            from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Non-staged",               sum(Non_staged)             from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Customer age < 18",        sum(Customer_Minor)         from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Control group",            sum(Control_Group)          from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Sub Segment not Approved", sum(Sub_Segment_Not_Approved) from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Invalid CUST_NO",          sum(Invalid_CUST_NO)        from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Invalid ID",              sum(Invalid_ID_NO)          from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Duplicate CUST_NO",        sum(Duplicate_CUST_NO)      from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Duplicate ID",            sum(Duplicate_ID_NO)        from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "SMS to APP Reg",           sum(SMS_to_APP_Reg)         from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "APN to non-APP Reg",       sum(APN_to_non_APP_Reg)     from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "No Primary DDA Account",   sum(No_Prim_DDA_ACCT)       from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "COVID-19",                 sum(COVID_19)               from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Staff",                    sum(Staff)                  from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "VIP",                      sum(VIP)                    from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "UHNW",                     sum(UHNW)                   from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code
  union all select Campaign_Code, Campaign_Name, Product_Code, "Excess Leads",             sum(Excess_Leads)           from _optimise_rows group by Campaign_Code, Campaign_Name, Product_Code;
quit;

