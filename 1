/* ============================================================
   FIX 17 : PRODUCT CODE FORMAT DIAGNOSTIC + JOIN STRATEGY
   -------------------------------------------------------
   The Optimise tables store the FULL product code including
   Variation and Message suffixes (e.g. CMA03787V01M01 = 13
   chars). The stakeholder input file may contain only the
   BASE code (e.g. CMA03787 = 8 chars) or the full code.

   If the two sides use different lengths every cust_no match
   will fail silently — no error, just missing funnel rows.

   This block:
     1. Classifies each distinct Product_Code in FULL_OPPORTUNITY
        as BASE_ONLY, FULL, or UNKNOWN_FORMAT.
     2. Derives the dominant format (most records) and writes it
        to &product_code_strategy (FULL | BASE).
     3. All downstream joins (orphan check, COMPLETE_FUNNEL)
        use a CASE expression to normalise the Optimise code to
        match whatever format the input file uses.
   ============================================================ */

proc sql;
    create table diag_product_code_formats as
    select distinct
        Product_Code,
        case
            when length(strip(Product_Code)) <= 8  then "BASE_ONLY"
            when length(strip(Product_Code)) = 13  then "FULL"
            else                                        "UNKNOWN_FORMAT"
        end as Code_Type    length = 20,
        count(*) as Occurrences
    from FULL_OPPORTUNITY
    group by Product_Code;
quit;

title "DIAGNOSTIC FIX 17 — Product Code Formats in Input File";
proc print data=diag_product_code_formats noobs; run;
title;

/* Derive the dominant format: whichever type has the most records */
proc sql noprint;
    select Code_Type
    into   :product_code_strategy trimmed
    from (
        select Code_Type, sum(Occurrences) as Total_Occurrences
        from diag_product_code_formats
        group by Code_Type
    )
    order by Total_Occurrences desc;   /* first row = dominant type */
quit;

/* Collapse BASE_ONLY and UNKNOWN_FORMAT to the same join approach */
%if %upcase(&product_code_strategy) ne FULL %then
    %let product_code_strategy = BASE;

%put NOTE: Fix 17 — Product code join strategy: &product_code_strategy;
%if &product_code_strategy = BASE %then %do;
    %put NOTE: Fix 17 — Input file uses BASE codes (<=8 chars). Optimise product codes;
    %put NOTE:           will be truncated to substr(product_code,1,8) in all joins.;
%end;
%else %do;
    %put NOTE: Fix 17 — Input file uses FULL codes (13 chars). Joins will match exactly.;
%end;

/* Fix 16: Identify FULL_OPPORTUNITY records that never reached Optimise at all.
   These are records in the stakeholder input file that did not appear in either
   the Optimise passed or dropped tables. Possible causes:
     - The file failed import validation before Optimise saw it
     - SharePoint or pre-Optimise screening rejected them
     - Timing: this job ran before Optimise processed the batch
   The Import_Status column (from Fix 13) helps distinguish these cases.

   Fix 17: The Optimise product code is normalised to match the join strategy
   derived from the input file's format (FULL = exact match; BASE = truncate
   the Optimise code to 8 chars so it aligns with base-only input codes).    */

proc sql;
    create table FULL_OPPORTUNITY_ORPHANS as
    select
        a.Campaign_Code,
        a.Product_Code,
        a.cust_no,
        a.unique_id,
        a.Input_File,
        a.Import_Status,
        a.flag_missing_product_code
    from FULL_OPPORTUNITY a
    left join (
        select distinct cust_no,
            /* Fix 17: normalise Optimise code to the input file's format */
            %if &product_code_strategy = BASE %then %do;
                upcase(strip(substr(product_code, 1, 8))) as product_code
            %end;
            %else %do;
                upcase(strip(product_code)) as product_code
            %end;
        from CAMPAIGNS_TO_ADOBE
    ) b
        on  a.cust_no      = b.cust_no
        and a.Product_Code = b.product_code
    where b.cust_no is missing;
quit;

proc sql noprint;
    select coalesce(count(*), 0) into :orphan_count trimmed
    from FULL_OPPORTUNITY_ORPHANS;
quit;

%put NOTE: FULL_OPPORTUNITY_ORPHANS (never reached Optimise): &orphan_count records.;

%if &orphan_count > 0 %then %do;
    title "DIAGNOSTIC FIX 16 — Full Opportunity Records That Never Reached Optimise";
    proc sql;
        select Campaign_Code,
               Product_Code,
               Import_Status,
               count(*) as Orphan_Count
        from FULL_OPPORTUNITY_ORPHANS
        group by Campaign_Code, Product_Code, Import_Status
        order by Campaign_Code;
    quit;
    title;
%end;


