/* Load APN_OV_* to STI_PBI: drop, create with explicit types, then insert
   (controls the SQL Server column types). */
%macro LoadTable(Table=, Target=, Cols=, SelectList=, AllowEmpty=N);
    %if %sysfunc(exist(&Table.)) = 0 %then %do;
        %put ERROR: Work table &Table. does not exist.; %abort cancel;
    %end;
    proc sql noprint; select count(*) into :row_count trimmed from &Table.; quit;
    %if &row_count = 0 and %upcase(&AllowEmpty) ne Y %then %do;
        %put ERROR: &Table. has ZERO rows. Load of &Target. ABORTED.; %abort cancel;
    %end;

    /* drop existing target if present */
    %if %sysfunc(exist(STI_PBI.&Target.)) %then %do;
        proc sql; drop table STI_PBI.&Target.; quit;
    %end;
    %if %sysfunc(exist(STI_PBI.&Target.)) %then %do;
        %put ERROR: STI_PBI.&Target. could not be dropped. Load ABORTED.; %abort cancel;
    %end;

    /* create with explicit SQL Server column types */
    proc sql;
        create table STI_PBI.&Target. ( &Cols. );
    quit;

    /* insert the rows */
    proc sql;
        insert into STI_PBI.&Target.
        select &SelectList. from &Table.;
    quit;

    /* honest success check */
    proc sql noprint;
        select count(*) into :ins_rows trimmed from STI_PBI.&Target.;
    quit;
    %if &sqlrc = 0 and &ins_rows > 0 %then
        %put NOTE: STI_PBI.&Target. loaded (&ins_rows rows).;
    %else %if &row_count = 0 and %upcase(&AllowEmpty) = Y %then
        %put NOTE: STI_PBI.&Target. created empty (AllowEmpty=Y).;
    %else %do;
        %put ERROR: STI_PBI.&Target. LOAD FAILED (sqlrc=&sqlrc ins_rows=&ins_rows).; %abort cancel;
    %end;
%mend;

