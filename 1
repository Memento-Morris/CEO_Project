        put "so you can review them together. In production, each agent gets only their own file.<br><br>";

        put '<table cellpadding="0" cellspacing="0" border="0" width="480" style="border-collapse:collapse;margin-bottom:10px;">';
        put '<tr><td colspan="2" style="background:#B85042;color:#ffffff;font-weight:600;padding:7px 12px;">Agent pack run-down</td></tr>';
