/* ============================================================================
   Calculating Remuneration for Servicing Advisors
   FIXED VERSION - Resolves:
     1. Data type mismatch in Leave join (confirmed both character — direct join used)
     2. Recursive CREATE TABLE warnings (temp tables used)
     3. Uninitialized variable warning on date9 format
   ============================================================================ */

%include "/data/fnbins/fnbinsurance/Growth_Analytics/SASCODE/DEPLOYED/Automation/STI_CA_2/Libnames.sas";


/* ============================================================================
   PART 1: TIME PERIOD SETUP
   ============================================================================ */

/* Load QA period reference table and derive readable month label */
data Periods;
    set sti_meta.qa_loc_periods;
    character_month = put(QA_Period, monyy7.);
run;

/* IMPORTANT: VERIFY MONTH FOR OBR
   Adjust intnx() offset if needed:
     0  = current month
    -1  = previous month
*/
/* %let OBR_Month_start_date = %SYSFUNC(intnx(month, %SYSFUNC(today()), 0, b), date9.); */

/* Hardcode OBR cycle start — used to derive the sheet name */
%let OBR_Month_start_date = '24FEB2026'd;

/* Derive the sheet name (e.g. MAR2026) from the periods table */
data _null_;
    set Periods;
    where QA_Period = &OBR_Month_start_date;
    call symput('sheet', strip(character_month));
run;

%put -------> Sheet name: &sheet;

/* -----------------------------------------------------------------------
   Hardcode OBR cycle and scorecard date boundaries
   OBR Period  : 24 Feb 2026 – 30 Mar 2026
   Scorecards  : Mondays — 02, 09, 16, 23 Mar 2026
   ----------------------------------------------------------------------- */
%let OBR_Month_start_date  = '24FEB2026'd;
%let OBR_Month_end_date    = '30MAR2026'd;
%let current_obr_period_start_date = '02MAR2026'd;
%let current_obr_period_end_date   = '30MAR2026'd;

%put OBR Start : &OBR_Month_start_date;
%put OBR End   : &OBR_Month_end_date;
%put SC Start  : &current_obr_period_start_date;
%put SC End    : &current_obr_period_end_date;


/* ============================================================================
   PART 2: 3-MONTH HISTORICAL SCORES
   ============================================================================ */

/* Import historical OBR scores from shared drive */
PROC IMPORT
    DATAFILE="\\lfe-rbgfs01\FNB_Insure\FSR STI Corporate Actuarial\Dashboards\Operational\OBR_Records\run\Input_Files\OBR PBI Input Sheet.xlsx"
    OUT=OBR_History
    DBMS=excelcs
    REPLACE;
    SHEET="Operations OBR data";
    SERVER='lfe-rbgfs01';
    PORT=9621;
RUN;

/* Filter to Servicing division and convert OpsYM (YYYYMM) to end-of-month date */
DATA Historical_Scores;
    SET OBR_History;
    WHERE Division = 'Servicing';
    KEEP Fnumber UserName Team Score OpsYM DateVar;

    Year    = INT(OpsYM / 100);
    Month   = MOD(OpsYM, 100);
    DateVar = INTNX('month', MDY(Month, 1, Year), 0, 'E');
    FORMAT DateVar DATE9.;
RUN;

/* Join to active agent list to retain only current agents */
proc sql;
    create table Leave_Score as
    select a.*, b.EmployeeNumber as EmployeeNumber2
    from Historical_Scores a
    inner join STI_PBI.STI_Servicing_Agents b
        on a.Fnumber = b.EmployeeNumber;
quit;

/* Calculate each agent's average score over the 3 months prior to OBR month.
   FIX: Write to a temp table first to avoid recursive reference warning. */
proc sql;
    create table Leave_Score_2_tmp as
    select  UserName,
            EmployeeNumber2             as employeenumber,
            round(mean(Score), 0.01)    as three_month_score
    from Leave_Score
    where DateVar between intnx('month', &OBR_Month_start_date, -3, 'b')
                      and intnx('month', &OBR_Month_start_date, -1, 'e')
    group by UserName, EmployeeNumber2;
quit;

/* Filter to currently active agents only */
proc sql;
    create table Leave_Score_2 as
    select a.*
    from Leave_Score_2_tmp a
    where a.EmployeeNumber in (select EmployeeNumber
                               from STI_PBI.STI_Servicing_Agents
                               where Active = 1);
quit;

/* Clean up temp table */
proc sql; drop table Leave_Score_2_tmp; quit;


/* ============================================================================
   PART 3: LEAVE RECORDS
   NOTE: 3-month average replaces weekly score only when leave days >= 5
   ============================================================================ */

PROC IMPORT
    DATAFILE="\\lfe-rbgfs01\FNB_Insure\FSR STI Corporate Actuarial\Dashboards\Operational\OBR_Records\Leave_Template.xlsx"
    OUT=Leave_Template
    DBMS=excelcs
    REPLACE;
    SERVER='lfe-rbgfs01';
    PORT=9621;
    SHEET="&sheet";
RUN;

/* Rename long column name */
data Leave_Template;
    set Leave_Template;
    rename 'Scorecard_Affected_Date(Which Mo'n = Score_Affected_Date;
run;

/* FIX: Removed uninitialized variable — format applied only after conditional assignment */
data Leave_Template2;
    set Leave_Template;
    length Scorecard_Day_affected2 8.;
    format Scorecard_Day_affected2 date9.;

    /* Flag scorecard date only when leave is 5+ days */
    if 'Leave Days'n >= 5 then Scorecard_Day_affected2 = Score_Affected_Date;
    else Scorecard_Day_affected2 = .;

    /* Both F_Number and EmployeeNumber are character — no cast needed */
run;


/* ============================================================================
   PART 4: WEEKLY SCORECARD SCORES
   ============================================================================ */

/* Pull most recent scorecard export per agent per Monday run date */
proc sql;
    create table Servicing_Scores_tmp as
    select *
    from STI_SC.Servicing_Scores b
    where sql_export_day = (select max(sql_export_day)
                            from STI_SC.Servicing_Scores c
                            where b.run_date = c.run_date
                              and b.EmployeeNumber = c.EmployeeNumber)
      and run_date between &current_obr_period_start_date and &current_obr_period_end_date
      and weekday(run_date) = 2   /* Monday */
      and active = 1
    order by EmployeeNumber;
quit;

/* Filter to currently active agents */
proc sql;
    create table Servicing_Scores_active as
    select a.*
    from Servicing_Scores_tmp a
    where a.EmployeeNumber in (select EmployeeNumber
                               from STI_PBI.STI_Servicing_Agents
                               where Active = 1);
quit;

proc sql; drop table Servicing_Scores_tmp; quit;

/* Drop any existing full_name to avoid carry-over from prior runs */
data Servicing_Scores_active;
    set Servicing_Scores_active;
    drop full_name;
run;

/* Attach full names from agent reference table */
proc sql;
    create table Servicing_Scores as
    select catx(' ', b.Name, b.Surname) as full_name
          ,a.*
    from Servicing_Scores_active a
    left join STI_PBI.STI_Servicing_Agents b
        on a.EmployeeNumber = b.EmployeeNumber;
quit;

proc sql; drop table Servicing_Scores_active; quit;

/* Sanity check: confirm run dates in scope */
proc sql;
    select distinct run_date
    from Servicing_Scores;
quit;


/* ============================================================================
   PART 5: MERGE SCORES + LEAVE ADJUSTMENT
   Both EmployeeNumber and F_Number are character — direct join, no cast needed
   ============================================================================ */

proc sql;
    create table Servicing_Scores_WLeave as
    select  a.*,
            b.three_month_score,
            c.Scorecard_Day_affected2
    from Servicing_Scores a
    left join Leave_Score_2 b
        on a.EmployeeNumber = b.employeenumber
    left join Leave_Template2 c
        on  a.EmployeeNumber = c.F_Number                /* both character */
        and a.run_date        = c.Scorecard_Day_affected2;
quit;

/* Hardcoded line assignment fix for known discrepancy */
data Servicing_Scores_WLeave;
    set Servicing_Scores_WLeave;
    if EmployeeNumber = 'F5485428' then line = 'Comp 1';
run;


/* ============================================================================
   PART 6: SPLIT INTO LOC AND COMP OUTPUT DATASETS
   ============================================================================ */

data LOC_Servicing_Remm   COMP_Servicing_Remm;
    set Servicing_Scores_WLeave (
        keep   = Full_Name line EmployeeNumber run_date Active scorecard
                 three_month_score Scorecard_Day_affected2
        rename = (EmployeeNumber = Employee_Number)
    );

    /* Apply leave protection: replace weekly score with 3-month average
       if agent was on significant leave AND their weekly score is lower */
    if Scorecard_Day_affected2 ne . and scorecard < three_month_score then
        scorecard = three_month_score;

    /* Route to appropriate output dataset */
    if line in ('LOC 1', 'LOC 2') then output LOC_Servicing_Remm;
    else output COMP_Servicing_Remm;
run;


/* ============================================================================
   PART 7: QUICK VALIDATION CHECKS
   ============================================================================ */

%put === LOC Servicing Remm ===;
proc sql; select count(*) as n_rows from LOC_Servicing_Remm; quit;

%put === COMP Servicing Remm ===;
proc sql; select count(*) as n_rows from COMP_Servicing_Remm; quit;

/* Check for any agents in scores but missing from 3-month history */
proc sql;
    select Employee_Number, Full_Name
    from LOC_Servicing_Remm
    where three_month_score is null
    union
    select Employee_Number, Full_Name
    from COMP_Servicing_Remm
    where three_month_score is null;
quit;
