/* ============================================================================
   PART 4: WEEKLY SCORECARD SCORES
   ============================================================================ */

/* Pull most recent scorecard export per agent per Monday run date */
proc sql;
    create table Servicing_Scores_tmp as
    select *
    from STI_SC.Servicing_Scores b
    where sql_export_day = (select max(sql_export_day)
                            from STI_SC.Servicing_Scores c
                            where b.run_date = c.run_date
                              and b.EmployeeNumber = c.EmployeeNumber)
      and run_date between &current_obr_period_start_date and &current_obr_period_end_date
      and weekday(run_date) = 2   /* Monday */
      and active = 1
    order by EmployeeNumber;
quit;

/* Filter to currently active agents */
proc sql;
    create table Servicing_Scores_active as
    select a.*
    from Servicing_Scores_tmp a
    where a.EmployeeNumber in (select EmployeeNumber
                               from STI_PBI.STI_Servicing_Agents
                               where Active = 1);
quit;

proc sql; drop table Servicing_Scores_tmp; quit;

/* Drop any existing full_name to avoid carry-over from prior runs */
data Servicing_Scores_active;
    set Servicing_Scores_active;
    drop full_name;
run;

/* Attach full names from agent reference table */
proc sql;
    create table Servicing_Scores as
    select catx(' ', b.Name, b.Surname) as full_name
          ,a.*
    from Servicing_Scores_active a
    left join STI_PBI.STI_Servicing_Agents b
        on a.EmployeeNumber = b.EmployeeNumber;
quit;

proc sql; drop table Servicing_Scores_active; quit;

/* Sanity check: confirm run dates in scope */
proc sql;
