            put "<tr><td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;"">Pushed to Adobe</td><td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;text-align:right;font-weight:600;"">&tot_pushed</td></tr>";
            put "<tr><td style=""border:1px solid #cfe0de;padding:6px 12px;"">Sent</td><td style=""border:1px solid #cfe0de;padding:6px 12px;text-align:right;font-weight:600;"">&tot_sent</td></tr>";
            put "<tr><td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;"">Opened</td><td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;text-align:right;font-weight:600;"">&tot_opened</td></tr>";
            put '</table>';

            /* ---- one table per campaign ---- */
            %do i = 1 %to &n_campaigns;
                put '<table cellpadding="0" cellspacing="0" border="0" width="560" style="border-collapse:collapse;margin-bottom:20px;">';

                put '<tr><td colspan="2" style="background:#54B9AC;color:#ffffff;padding:7px 12px;">';
                put "<strong>&&ec_dispname_&i</strong> (&&ec_name_&i) &#183; &&ec_chan_&i</td>";
                put '<td colspan="2" style="background:#54B9AC;color:#ffffff;padding:7px 12px;text-align:right;font-weight:600;">';
                put "&&ec_ctype_&i" @;
                %if %superq(ec_upd_&i) = Updated %then %do;
                    put ' <span style="font-weight:400;color:#d6f7f0;">(Updated)</span>' @;
                %end;
                put '</td></tr>';

                /* metrics: labels plain, the four value cells shaded */
                put '<tr><td style="border:1px solid #cfe0de;padding:6px 12px;">Passed Optimise</td>';
                put "<td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;text-align:right;font-weight:600;"">&&ec_passed_&i</td>";
                put '<td style="border:1px solid #cfe0de;padding:6px 12px;">Sent</td>';
                put "<td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;text-align:right;font-weight:600;"">&&ec_sent_&i</td></tr>";

                put '<tr><td style="border:1px solid #cfe0de;padding:6px 12px;">Pushed to Adobe</td>';
                put "<td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;text-align:right;font-weight:600;"">&&ec_pushed_&i</td>";
                put '<td style="border:1px solid #cfe0de;padding:6px 12px;">Opened</td>';
                put "<td style=""background:#e8f4f2;border:1px solid #cfe0de;padding:6px 12px;text-align:right;font-weight:600;"">&&ec_opened_&i</td></tr>";

                /* tenure split: NTB / ETB / Unknown with counts, %, and a coloured bar */
                put '<tr><td colspan="4" style="border:1px solid #cfe0de;padding:8px 12px;">';
                put '<div style="font-size:12px;color:#5a6b6a;margin-bottom:5px;">Tenure mix (share of Sent)</div>';

                /* the coloured bar (full width) */
                put '<table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;"><tr>';
                /* macro-var width in dq, then the &nbsp; literal in sq
                   (single quotes stop SAS reading &nbsp; as a macro reference) */
                put "<td bgcolor=""#7bc47f"" width=""&&ec_ntbw_&i.%"" style=""height:12px;line-height:12px;font-size:1px;"">" @;
                put '&nbsp;</td>' @;
                put "<td bgcolor=""#0d7a72"" width=""&&ec_etbw_&i.%"" style=""height:12px;line-height:12px;font-size:1px;"">" @;
                put '&nbsp;</td>' @;
                put "<td bgcolor=""#e8923a"" width=""&&ec_unkw_&i.%"" style=""height:12px;line-height:12px;font-size:1px;"">" @;
                put '&nbsp;</td>';
                put '</tr></table>';

                /* single-line legend: NTB n (x%) . ETB n (x%) . Unknown n (x%) */
                put '<div style="font-size:12px;color:#5a6b6a;margin-top:6px;">';
                put '<span style="display:inline-block;width:9px;height:9px;background:#7bc47f;"></span> ' @;
                put "<strong>NTB</strong> &&ec_ntb_&i (&&ec_ntbp_&i.%)  &#183;  " @;
                put '<span style="display:inline-block;width:9px;height:9px;background:#0d7a72;"></span> ' @;
                put "<strong>ETB</strong> &&ec_etb_&i (&&ec_etbp_&i.%)  &#183;  " @;
                put '<span style="display:inline-block;width:9px;height:9px;background:#e8923a;"></span> ' @;
                put "<strong>Non-Banker</strong> &&ec_unk_&i (&&ec_unkp_&i.%)";
                put '</div>';

                put '</td></tr>';

                put '</table>';
            %end;

            put 'The APN dashboard can be refreshed.<br><br>Kind Regards<br>Morris';
            put '</body></html>';
        run;
    %end;
%mend send_email;
%send_email;

