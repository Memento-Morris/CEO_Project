/* ============================================================
   SECTION 4: DATE/TIME EXTRACTION HELPER MACRO
   
   Table names follow one of two patterns:
     Pattern A: CMAnnnnn_YYYYMMDD_HHMM  (underscore-delimited date/time)
     Pattern B: CMAnnnnnYYYYMMDD...     (date embedded at position 16)
   
   This macro is called once per table inside the data steps below.
   ============================================================ */

/* Common keep list - only columns that exist in source tables */
%let keep_cols = CUST_NO Product_Code Drop_Reason sub_segment Campaign_Name Brand MUCN;


/* ============================================================
   SECTION 5: READ AND STACK ALL CAMPAIGN TABLES
   Four groups: monthly pass, monthly drop, weekly pass, weekly drop.
   Each group loops over the discovered tables, reads with a
   consistent keep list, and derives Date_to_adobe /
   Time_created_to_adobe from the table name at runtime.
   ============================================================ */

/* ----- Macro to read one group of tables ----- */
%macro read_campaign_tables(
  lib=,        /* source libname                         */
  n=,          /* number of tables (macro var holding count) */
  prefix=,     /* table name macro var prefix (table / wtable) */
  crprefix=,   /* crdate macro var prefix (crdate / wcrdate)  */
  outprefix=   /* output work dataset prefix                  */
);

  proc datasets library=work nolist;
    delete &outprefix._:;
  run; quit;

  %do i = 1 %to &&&n;

    %let _memname_ = &&&prefix&i;
    %let _crdate_  = &&&crprefix&i;

    data &outprefix._&i;
      set &lib..&_memname_
          (keep=&keep_cols);

      length _memname_ $50 _date_raw_ $8 _time_raw_ $4;
      _memname_ = "&_memname_";

      /* Pattern A: name contains underscore -> last two tokens are date and time */
      if index(_memname_, '_') > 0 then do;
        _date_raw_ = scan(_memname_, -2, '_');
        _time_raw_ = scan(_memname_, -1, '_');
        Date_to_adobe          = input(_date_raw_, YYMMDD8.);
        Time_created_to_adobe  = input(
          cats(substr(_time_raw_, 1, 2), ':', substr(_time_raw_, 3, 2), ':00'),
          HHMMSS8.
        );
      end;
      /* Pattern B: date starts at character 16, time taken from crdate */
      else do;
        _date_raw_ = substr(_memname_, 16, 8);
        Date_to_adobe          = input(_date_raw_, YYMMDD8.);
        Time_created_to_adobe  = input(substr("&_crdate_", 9, 8), HHMMSS8.);
      end;

      format Date_to_adobe         date9.
             Time_created_to_adobe time9.;

      rename CUST_NO = cust_no
             MUCN    = mucn
             Brand   = brand;

      drop _memname_ _date_raw_ _time_raw_;
    run;

  %end;

%mend;

%read_campaign_tables(lib=PASS6,    n=monthly_count, prefix=table,  crprefix=crdate,  outprefix=PASS_M)
%read_campaign_tables(lib=DROP6,    n=monthly_count, prefix=table,  crprefix=crdate,  outprefix=DROP_M)
