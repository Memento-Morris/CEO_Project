/* ============================================================================
   PART 7B: LEAVE REPLACEMENT — SUBSTITUTE TEAM AVERAGE FOR LEAVE-AFFECTED WEEKS
   ============================================================================
   WHY A NEW APPROACH:
   The simple CASE-statement fix failed because:

   1. Agents on extended leave often have NO ROW at all in Servicing_Scores for
      the affected Mondays — they were not scored because they were not working.
      There is nothing to overwrite, so the team average was never applied.

   2. Even when a row exists (scorecard = 0, earn = 0), the Scorecard_Day_affected2
      column was not reliably surviving through the %Remuneration macro chain,
      meaning the CASE condition never evaluated to true.

   THIS FIX:
   - Drives the replacement directly off Leave_Template2 (the authoritative list
     of who was on leave and on which specific Monday).
   - Calculates the clean team average per line per run_date excluding:
       (a) agents already flagged as on leave that Monday
       (b) the 7 secure chat agents who earn a fixed R3000 (would distort avg)
   - For each leave agent + affected Monday:
       UPDATE: if a row already exists, overwrite Earn_before_QA with team avg
       INSERT: if no row exists, create one so monthly aggregation picks it up
   ============================================================================ */

/* Step 1: Secure chat agents earn fixed R3000 — must be excluded from the
           team average so they do not distort what leave agents receive        */
data Secure_Chat_List;
    length Employee_Number $10;
    input Employee_Number $;
    datalines;
F5324823
F5330246
F5530563
F4903773
F8872893
F3446921
F5663393
;
run;

/* Step 2: Calculate clean team average Earn_before_QA per line per run_date.
           Only uses agents who were present that Monday AND are not SC agents. */
proc sql;
    create table Team_Avg_By_RunDate as

    select      a.line,
                a.run_date,
                round(avg(a.Earn_before_QA), 0.01) as Team_Avg_Earn,
                count(*)                            as n_agents_in_avg
    from        LOC_Servicing_Earn a
    where       a.Scorecard_Day_affected2 is null
      and       strip(a.Employee_Number) not in
                    (select strip(Employee_Number) from Secure_Chat_List)
    group by    a.line, a.run_date

    union all

    select      a.line,
                a.run_date,
                round(avg(a.Earn_before_QA), 0.01) as Team_Avg_Earn,
                count(*)                            as n_agents_in_avg
    from        COMP_Servicing_Earn a
    where       a.Scorecard_Day_affected2 is null
      and       strip(a.Employee_Number) not in
                    (select strip(Employee_Number) from Secure_Chat_List)
    group by    a.line, a.run_date;
quit;

%put === Team averages per line per run_date (used for leave replacement) ===;
proc sql;
    select line, run_date format date9., Team_Avg_Earn, n_agents_in_avg
    from Team_Avg_By_RunDate
    order by line, run_date;
quit;


/* Step 3: Build a leave replacement lookup table.
           For each leave agent + affected Monday, resolve:
             - which line they are on (from their earn table entry)
             - what team average applies for that line + run_date
           Scope is limited to Mondays within the OBR scoring window.          */
proc sql;
    create table Leave_Replacement_LOC as
    select distinct
                l.F_Number                    as Employee_Number,
                l.Scorecard_Day_affected2     as run_date,
                e.line,
                t.Team_Avg_Earn               as Earn_Replacement,
                t.n_agents_in_avg
    from        Leave_Template2 l
    /* Get the agent's line from their earn table */
    inner join  (select distinct Employee_Number, line
                 from LOC_Servicing_Earn)     e
        on  strip(l.F_Number) = strip(e.Employee_Number)
    /* Get the team average for that line + Monday */
    inner join  Team_Avg_By_RunDate           t
        on  e.line                       = t.line
        and l.Scorecard_Day_affected2    = t.run_date
    where       l.Scorecard_Day_affected2 between
                    &current_obr_period_start_date and &current_obr_period_end_date;
quit;

proc sql;
    create table Leave_Replacement_COMP as
    select distinct
                l.F_Number                    as Employee_Number,
                l.Scorecard_Day_affected2     as run_date,
                e.line,
                t.Team_Avg_Earn               as Earn_Replacement,
                t.n_agents_in_avg
    from        Leave_Template2 l
    inner join  (select distinct Employee_Number, line
                 from COMP_Servicing_Earn)    e
        on  strip(l.F_Number) = strip(e.Employee_Number)
    inner join  Team_Avg_By_RunDate           t
        on  e.line                       = t.line
        and l.Scorecard_Day_affected2    = t.run_date
    where       l.Scorecard_Day_affected2 between
                    &current_obr_period_start_date and &current_obr_period_end_date;
quit;

%put === Leave replacement lookup — LOC ===;
proc sql;
    select Employee_Number, run_date format date9., line, Earn_Replacement, n_agents_in_avg
    from Leave_Replacement_LOC
    order by Employee_Number, run_date;
quit;

%put === Leave replacement lookup — COMP ===;
proc sql;
    select Employee_Number, run_date format date9., line, Earn_Replacement, n_agents_in_avg
    from Leave_Replacement_COMP
    order by Employee_Number, run_date;
quit;


/* Step 4a: LOC — overwrite existing leave rows with team average              */
proc sql;
    create table LOC_Servicing_Earn_Updated as
    select      a.Full_Name,
                a.line,
                a.Employee_Number,
                a.run_date,
                a.Active,
                a.ScoreCard,
                a.Scorecard_Day_affected2,
                case
                    when b.Earn_Replacement is not null
                    then b.Earn_Replacement
                    else a.Earn_before_QA
                end as Earn_before_QA
    from        LOC_Servicing_Earn a
    left join   Leave_Replacement_LOC b
        on  strip(a.Employee_Number) = strip(b.Employee_Number)
        and a.run_date               = b.run_date;
quit;

/* Step 4b: LOC — insert new rows for leave agents who had NO row that Monday  */
proc sql;
    create table LOC_Leave_Inserted as
    select      coalesce(e.Full_Name, r.Employee_Number) as Full_Name,
                r.line,
                r.Employee_Number,
                r.run_date,
                1                   as Active,
                .                   as ScoreCard,
                r.run_date          as Scorecard_Day_affected2  format date9.,
                r.Earn_Replacement  as Earn_before_QA
    from        Leave_Replacement_LOC r
    left join   (select distinct Employee_Number, Full_Name
                 from LOC_Servicing_Earn)                  e
        on  strip(r.Employee_Number) = strip(e.Employee_Number)
    /* Only insert if this agent has no existing row for this run_date         */
    where not exists (
        select 1
        from LOC_Servicing_Earn x
        where strip(x.Employee_Number) = strip(r.Employee_Number)
          and x.run_date               = r.run_date
    );
quit;

data LOC_Servicing_Earn;
    set LOC_Servicing_Earn_Updated
        LOC_Leave_Inserted;
run;

proc sort data=LOC_Servicing_Earn noduprecs;
    by Employee_Number run_date;
run;


/* Step 4c: COMP — overwrite existing leave rows with team average             */
proc sql;
    create table COMP_Servicing_Earn_Updated as
    select      a.Full_Name,
                a.line,
                a.Employee_Number,
                a.run_date,
                a.Active,
                a.ScoreCard,
                a.Scorecard_Day_affected2,
                case
                    when b.Earn_Replacement is not null
                    then b.Earn_Replacement
                    else a.Earn_before_QA
                end as Earn_before_QA
    from        COMP_Servicing_Earn a
    left join   Leave_Replacement_COMP b
        on  strip(a.Employee_Number) = strip(b.Employee_Number)
        and a.run_date               = b.run_date;
quit;

/* Step 4d: COMP — insert new rows for leave agents who had NO row that Monday */
proc sql;
    create table COMP_Leave_Inserted as
    select      coalesce(e.Full_Name, r.Employee_Number) as Full_Name,
                r.line,
                r.Employee_Number,
                r.run_date,
                1                   as Active,
                .                   as ScoreCard,
                r.run_date          as Scorecard_Day_affected2  format date9.,
                r.Earn_Replacement  as Earn_before_QA
    from        Leave_Replacement_COMP r
    left join   (select distinct Employee_Number, Full_Name
                 from COMP_Servicing_Earn)                 e
        on  strip(r.Employee_Number) = strip(e.Employee_Number)
    where not exists (
        select 1
        from COMP_Servicing_Earn x
        where strip(x.Employee_Number) = strip(r.Employee_Number)
          and x.run_date               = r.run_date
    );
quit;

data COMP_Servicing_Earn;
    set COMP_Servicing_Earn_Updated
        COMP_Leave_Inserted;
run;

proc sort data=COMP_Servicing_Earn noduprecs;
