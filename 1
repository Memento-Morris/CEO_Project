    select put(sum(Pushed_to_Adobe), comma12.) into :tot_pushed   trimmed from OV_FUNNEL;
    select put(sum(Sent),            comma12.) into :tot_sent      trimmed from OV_FUNNEL;
    select put(sum(Opened),          comma12.) into :tot_opened    trimmed from OV_FUNNEL;
    select count(*)                            into :n_campaigns   trimmed from OV_FUNNEL;
    select count(*)                            into :n_met         trimmed from OV_TARGET where Target_RAG = "Target met";
quit;

/* per-campaign lines for the email body. Channel pulled from OV_FUNNEL (it
   carries the per-campaign channel), aligned to the same Campaign order. */
proc sql noprint;
    select Campaign,
           case when upcase(Channel) in ('APP PUSH NOTIFICATION','APP PUSH','PUSH')
                then 'APN' else Channel end,
           put(Passed_Optimise, comma12.),
           put(Pushed_to_Adobe, comma12.),
           put(Sent,            comma12.),
           put(Opened,          comma12.)
    into :ec_name_1    - :ec_name_99,
         :ec_chan_1    - :ec_chan_99,
         :ec_passed_1  - :ec_passed_99,
         :ec_pushed_1  - :ec_pushed_99,
         :ec_sent_1    - :ec_sent_99,
         :ec_opened_1  - :ec_opened_99
    from OV_FUNNEL
    order by Campaign;

    select Campaign,
           put(Target,        comma12.),
           put(Pct_of_Target, 8.1),
           Target_RAG
    into :et_name_1 - :et_name_99,
         :et_tgt_1  - :et_tgt_99,
         :et_pct_1  - :et_pct_99,
         :et_rag_1  - :et_rag_99
    from OV_TARGET
    order by Campaign;
quit;

/* campaign-name lookup (one display name per code) + segment counts/%s,
   ordered by Campaign so these arrays line up with ec_* above */
proc sql noprint;
    create table _email_name as
    select Campaign_Code as Campaign length=8,
           max(Campaign_Name) as Campaign_Name length=100
    from _optimise_rows
    group by Campaign_Code;
quit;

proc sql noprint;
    select coalesce(n.Campaign_Name, v.Campaign)
    into :ec_dispname_1 - :ec_dispname_99
    from OV_FUNNEL v left join _email_name n on v.Campaign = n.Campaign
    order by v.Campaign;
quit;

/* pre-compute segment counts + percentages in a forgiving data step,
   aligned to OV_FUNNEL's campaign order, then pull plain strings */
proc sql noprint;
  create table _email_seg as
  select v.Campaign,
         coalesce(g.Sent,0)         as Sent,
         coalesce(g.Sent_NTB,0)     as Sent_NTB,
         coalesce(g.Sent_ETB,0)     as Sent_ETB,
         coalesce(g.Sent_Unknown,0) as Sent_Unknown
  from OV_FUNNEL v
  left join _ov_sends g on v.Campaign = g.Campaign_Code
  order by v.Campaign;
quit;

/* bring Target_RAG in so we can derive the campaign-type label here
   (Monitored vs Finite), avoiding any %if logic inside the email data step */
proc sql noprint;
  create table _email_seg as
  select s.*, coalesce(t.Target_RAG,'') as Target_RAG length=20
  from _email_seg s
  left join OV_TARGET t on s.Campaign = t.Campaign
  order by s.Campaign;
quit;

data _email_seg;
  set _email_seg;
  length ntb_c etb_c unk_c $14  ntb_p etb_p unk_p $7;
  ntb_c = strip(put(Sent_NTB,     comma12.));
  etb_c = strip(put(Sent_ETB,     comma12.));
  unk_c = strip(put(Sent_Unknown, comma12.));
  if Sent > 0 then do;
     ntb_p = strip(put(round(Sent_NTB    /Sent*100,0.1), 5.1));
     etb_p = strip(put(round(Sent_ETB    /Sent*100,0.1), 5.1));
     unk_p = strip(put(round(Sent_Unknown/Sent*100,0.1), 5.1));
     /* integer cell widths for the HTML mini-bar; Unknown is the remainder
        so the three always sum to exactly 100 (no rounding gap in the bar) */
     ntb_w = round(Sent_NTB/Sent*100);
     etb_w = round(Sent_ETB/Sent*100);
     unk_w = 100 - ntb_w - etb_w;
     if unk_w < 0 then unk_w = 0;
  end;
  else do; ntb_p='0.0'; etb_p='0.0'; unk_p='0.0'; ntb_w=0; etb_w=0; unk_w=0; end;

  /* campaign-type label, computed here (not in the email step) */
  length ctype $10;
  if strip(Target_RAG) = 'Monitoring' then ctype = 'Monitored';
  else ctype = 'Finite';

  length ntb_ws etb_ws unk_ws $3;
  ntb_ws = strip(put(ntb_w, 3.));
  etb_ws = strip(put(etb_w, 3.));
  unk_ws = strip(put(unk_w, 3.));
run;

proc sql noprint;
  select ntb_c, etb_c, unk_c, ntb_p, etb_p, unk_p,
         ctype, ntb_ws, etb_ws, unk_ws
  into :ec_ntb_1    - :ec_ntb_99,
       :ec_etb_1    - :ec_etb_99,
       :ec_unk_1    - :ec_unk_99,
       :ec_ntbp_1   - :ec_ntbp_99,
       :ec_etbp_1   - :ec_etbp_99,
       :ec_unkp_1   - :ec_unkp_99,
       :ec_ctype_1  - :ec_ctype_99,
       :ec_ntbw_1   - :ec_ntbw_99,
       :ec_etbw_1   - :ec_etbw_99,
       :ec_unkw_1   - :ec_unkw_99
  from _email_seg
  order by Campaign;
quit;

/* per-campaign Updated flag (blank or 'Updated'), aligned to OV_FUNNEL order */
proc sql noprint;
  select coalesce(c.Updated,'')
  into :ec_upd_1 - :ec_upd_99
  from OV_FUNNEL v
  left join _camp_cmp c on v.Campaign = c.Campaign
  order by v.Campaign;
quit;

