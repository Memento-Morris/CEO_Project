/* ============================================================================
   QA DIAGNOSTIC — Verify QA scores exist for current OBR period
   Run this AFTER the main script has built: Periods, Service_QA_Raw, QA_Score,
   QA_FINAL, and COMP/LOC_SER_Monthly_Earn_PreQA
   ============================================================================ */

%let OBR_Month_start_date          = '24FEB2026'd;
%let current_obr_period_start_date = '02MAR2026'd;
%let current_obr_period_end_date   = '30MAR2026'd;


/* ----------------------------------------------------------------------------
   STEP 1: What QA_Period values exist in the Periods table for our window?
   Expected: should show the MAR2026 period row
   ---------------------------------------------------------------------------- */
%put === STEP 1: Periods table — OBR window ===;
proc sql;
    select  QA_Period       format date9.,
            Start_Date      format date9.,
            End_Date        format date9.,
            character_month
    from    Periods
    where   QA_Period between &current_obr_period_start_date
                          and &current_obr_period_end_date;
quit;


/* ----------------------------------------------------------------------------
   STEP 2: Raw QA stamps — are there any date_stamp records in our period?
   Expected: rows with date_stamp falling between Start_Date and End_Date above
   ---------------------------------------------------------------------------- */
%put === STEP 2: Service_QA_Raw — records in period ===;
proc sql;
    select  a.Employee_number,
            a.date_stamp    format date9.,
            a.Score_M,
            a.Evaluations,
            a.Evaluations2,
            b.QA_Period     format date9.,
            b.Start_Date    format date9.,
            b.End_Date      format date9.
    from    Service_QA_Raw a
    inner join Periods b
        on (a.date_stamp between b.Start_Date and b.End_Date)
    where   b.QA_Period between &current_obr_period_start_date
                            and &current_obr_period_end_date
    order by a.Employee_number, a.date_stamp;
quit;

/* How many raw QA records matched? */
proc sql;
    select count(*) as raw_qa_records_in_period
    from Service_QA_Raw a
    inner join Periods b
        on (a.date_stamp between b.Start_Date and b.End_Date)
    where b.QA_Period between &current_obr_period_start_date
                          and &current_obr_period_end_date;
quit;


/* ----------------------------------------------------------------------------
   STEP 3: QA_Score — did the aggregation produce rows for our period?
   Expected: one row per employee for the MAR2026 QA_Period
   ---------------------------------------------------------------------------- */
%put === STEP 3: QA_Score — aggregated rows for period ===;
proc sql;
    select  Employee_number,
            QA_Period       format date9.,
            Start_Date      format date9.,
            End_Date        format date9.,
            QA_Score,
            QA_Evaluations,
            QA_Score_Perc
    from    QA_Score
    where   QA_Period between &current_obr_period_start_date
                          and &current_obr_period_end_date
    order by Employee_number;
quit;

proc sql;
    select count(*) as qa_score_rows_in_period
    from QA_Score
    where QA_Period between &current_obr_period_start_date
                        and &current_obr_period_end_date;
quit;


/* ----------------------------------------------------------------------------
   STEP 4: QA_FINAL — did the factor join work?
   Expected: Incentive_Factor_To_Be_Paid should be populated (not null)
   ---------------------------------------------------------------------------- */
%put === STEP 4: QA_FINAL — factor join result ===;
proc sql;
    select  Employee_number,
            QA_Period               format date9.,
            QA_Score_Perc,
            Incentive_Factor_To_Be_Paid,
            Start_Date              format date9.,
            End_Date                format date9.,
            QA_Evaluations
    from    QA_FINAL
    where   QA_Period between &current_obr_period_start_date
                          and &current_obr_period_end_date
    order by Employee_number;
quit;

/* How many have a null factor — means QA factor table didn't match */
proc sql;
    select count(*) as missing_factor_rows
    from QA_FINAL
    where QA_Period between &current_obr_period_start_date
                        and &current_obr_period_end_date
      and Incentive_Factor_To_Be_Paid is null;
quit;


/* ----------------------------------------------------------------------------
   STEP 5: QA_Period type check — compare how QA_Period is stored in each
   table. If TYPE differs (1=numeric, 2=character) OR formatted values differ,
   that is the join breaking in %Final_Earn.
   ---------------------------------------------------------------------------- */
%put === STEP 5a: QA_Period type — COMP_SER_Monthly_Earn_PreQA ===;
proc contents data=COMP_SER_Monthly_Earn_PreQA varnum;
    ods select Variables;
run;

%put === STEP 5b: QA_Period type — QA_FINAL ===;
proc contents data=QA_FINAL varnum;
    ods select Variables;
run;

/* Also print the distinct QA_Period values from each table so you can
   visually confirm they are the same date */
%put === STEP 5c: Distinct QA_Period values — COMP_SER_Monthly_Earn_PreQA ===;
proc sql;
    select distinct QA_Period format date9.
    from COMP_SER_Monthly_Earn_PreQA;
quit;

%put === STEP 5d: Distinct QA_Period values — QA_FINAL ===;
proc sql;
    select distinct QA_Period format date9.
    from QA_FINAL;
quit;


/* ----------------------------------------------------------------------------
   STEP 6: Employee_Number overlap — which agents appear in both tables?
   Any agent in PreQA but NOT in QA_FINAL will get null QA columns.
   ---------------------------------------------------------------------------- */
%put === STEP 6: Employee_Number overlap — COMP ===;
proc sql;
    /* Agents in COMP earn but missing from QA_FINAL for the period */
    select  a.Employee_Number,
            a.Full_Name,
            a.QA_Period     format date9.
    from    COMP_SER_Monthly_Earn_PreQA a
    where   strip(a.Employee_Number) not in (
                select strip(Employee_Number)
                from QA_FINAL
                where QA_Period between &current_obr_period_start_date
                                    and &current_obr_period_end_date
            )
    order by a.Employee_Number;
quit;

%put === STEP 6: Employee_Number overlap — LOC ===;
proc sql;
    select  a.Employee_Number,
            a.Full_Name,
            a.QA_Period     format date9.
    from    LOC_SER_Monthly_Earn_PreQA a
    where   strip(a.Employee_Number) not in (
                select strip(Employee_Number)
                from QA_FINAL
                where QA_Period between &current_obr_period_start_date
                                    and &current_obr_period_end_date
            )
    order by a.Employee_Number;
quit;


/* ----------------------------------------------------------------------------
   STEP 7: Summary — quick pass/fail overview
   ---------------------------------------------------------------------------- */
%put === STEP 7: Summary counts ===;
proc sql;
    select 'Periods rows in window'         as check, count(*) as result
    from Periods
    where QA_Period between &current_obr_period_start_date and &current_obr_period_end_date
    union all
    select 'Raw QA records in period',       count(*)
    from Service_QA_Raw a
    inner join Periods b on (a.date_stamp between b.Start_Date and b.End_Date)
    where b.QA_Period between &current_obr_period_start_date and &current_obr_period_end_date
    union all
    select 'QA_Score rows in period',        count(*)
    from QA_Score
    where QA_Period between &current_obr_period_start_date and &current_obr_period_end_date
    union all
    select 'QA_FINAL rows in period',        count(*)
    from QA_FINAL
    where QA_Period between &current_obr_period_start_date and &current_obr_period_end_date
    union all
    select 'QA_FINAL rows missing factor',   count(*)
    from QA_FINAL
    where QA_Period between &current_obr_period_start_date and &current_obr_period_end_date
      and Incentive_Factor_To_Be_Paid is null
    union all
    select 'COMP PreQA agents missing QA',   count(*)
    from COMP_SER_Monthly_Earn_PreQA a
    where strip(a.Employee_Number) not in (
        select strip(Employee_Number) from QA_FINAL
        where QA_Period between &current_obr_period_start_date and &current_obr_period_end_date)
    union all
    select 'LOC PreQA agents missing QA',    count(*)
    from LOC_SER_Monthly_Earn_PreQA a
    where strip(a.Employee_Number) not in (
        select strip(Employee_Number) from QA_FINAL
        where QA_Period between &current_obr_period_start_date and &current_obr_period_end_date);
quit;
