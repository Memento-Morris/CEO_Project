   SECTION 16: FINAL JOIN - OPTIMISE + ADOBE
   ============================================================ */

proc sql;
create table joining as
select *
from campaigns_to_adobe_renamed a
left join adobe_final_table_clients b
  on  a.cust_no              = b.cust_no2
  and a.product_code_to_adobe = b.product_code
  and (a.date_to_adobe between b.date_loaded and b.date_loaded - 5);
quit;

data APNS_DATA (drop=Time Product_code mucn ucn mucn_to_adobe
                     success_to_adobe drop_to_adobe);
  set joining;
  if Cust_no2 = "" and Optimize = "Sent"
    then Adobe = "Not loaded into Adobe within 5 days";
  if cust_no2 = "" and Optimize = "Sent"
    and intck('day', date_to_adobe, today()) <= 5
    and Date_loaded = ""d
    then Adobe = "Sending to Adobe";
  date_Diff = intck('day', date_to_adobe, date_loaded);
run;

proc sort data=APNS_DATA;
  by descending date_loaded Date_to_adobe;
run;

proc sql;
create table APNS_Data_Final as
select *
from APNS_DATA a
inner join (
  select cust_no, product_code_to_adobe, date_to_adobe,
         min(date_loaded) as min_date_loaded format date9.
  from APNS_DATA
  where date_to_adobe ne date_loaded
  group by cust_no, product_code_to_adobe, date_to_adobe) as b
  on  a.date_to_adobe           = b.date_to_adobe
  and a.date_loaded              = b.min_date_loaded
  and a.cust_no                  = b.cust_no
  and a.product_code_to_adobe    = b.product_code_to_adobe;
quit;

data APNS_DATA;
  set APNS_Data_Final;
