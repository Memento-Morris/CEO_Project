PROC SQL ;
     CONNECT TO ODBC as WORKFLOW_ (DATASRC="FNBHA" USER=FNBLFELDA PASS='@n8lf3lda' );


     create table FNB400_AYH_Workflow as 
     select * 
     from connection to WORKFLOW_
                ( 

	select a.*,b.name as Status_Name,c.name as Queue_Name,d.name as Worktype_Name,
     f.Created_Date as Comments_Created_Date, f.id as COMMENTS_ID,f.COMMENT,
     f.BEGIN_DATE as Comments_Begin_Date, f.END_DATE as Comments_End_Date, 
     g.name as Comments_Status_Name,h.name as Comments_Queue_Name,i.name as Comments_Worktype_Name
     from workflow.Workflow_Item a
     left join workflow.Status b on
     a.status_id = b.id
     left join workflow.Queue c on
     a.queue_id = c.id
     left join workflow.Worktype d on
     a.worktype_id = d.id
     left join workflow.WORKFLOW_ITEM_WORKFLOW_COMMENT e on
     a.id = e.WORKFLOW_ITEM_ID
     left join workflow.workflow_comment f on
     e.COMMENTS_ID = f.id
     left join workflow.Status g on
     f.status_id = g.id
     left join workflow.Queue h on
     f.queue_id = h.id
     left join workflow.Worktype i on
     f.worktype_id = i.id
/*where upper(Queue_Name) in ('SHORT TERM SERVICING','PRE-QA','END') */
where a.ASSIGNED_TO in &Agents
and upper(c.name) in ('LOCSERVICING','LOCPERSERVICING','LOCBUSSERVICING','SHORT TERM SERVICING','PRE-QA','END')

);
disconnect from WORKFLOW_;
quit;



