           count(*)                         as Row_Count,
           min(Date_loaded) format=date9.   as First_Send,
           max(Date_loaded) format=date9.   as Last_Send
    from APNS_sends_campaigns
    group by product_code
    order by product_code;
quit;
title;


/* ============================================================
   SECTION 10B : FIX 1 — MATCH ADOBE SENDS TO OPTIMISE
                  USING CAMPAIGN_NAME + PRODUCT_CODE + DATE
   -------------------------------------------------------
   WHY: When two campaigns share the same product code
   (e.g. "Ebucks" and "Personal Ebucks" both using V02M07),
   a product-code-only join gives every Optimise row ALL
   Adobe sends for that code, inflating counts.

   HOW: We inner-join from the Optimise master (passed
   records only — Optimize = "Sent") so Adobe sends are
   attributed to exactly one campaign per batch.

   Fix 14: Validate that Campaign_Name exists in the Adobe
   sends table before relying on it for the join. If it is
   absent, issue a clear WARNING so the inflation risk is
   visible in the log — the job continues but counts may be
   overstated for campaigns that share a product code.
   ============================================================ */

/* Fix 14: check Campaign_Name column exists in adobe sends table */
proc sql noprint;
    select count(*) into :has_campaign_name trimmed
    from dictionary.columns
    where libname = "APNS"
      and memname = upcase("apn_sends_and_feedback")
      and upcase(name) = "CAMPAIGN_NAME";
quit;

%if &has_campaign_name = 0 %then %do;
    %put WARNING: Fix 14 — APNS.apn_sends_and_feedback does not contain a Campaign_Name column.;
    %put WARNING: Fix 1 (campaign-scoped Adobe send attribution) will not work correctly.;
    %put WARNING: Adobe sends will be joined on Product_Code only, which may inflate counts;
    %put WARNING: for any campaigns that share the same product code.;
    %put WARNING: Contact the Adobe data team to confirm whether Campaign_Name is available.;
%end;

proc sql;
    create table APNS_sends_matched as
    select
        b.*,
        a.Campaign_Name                    as Campaign_Name_match,
        a.date_to_adobe                    as opt_batch_date
    from
        /* Optimise master: unique campaign + product + batch combinations */
        (select distinct
             cust_no,
             product_code,
             Campaign_Name,
             date_to_adobe
         from CAMPAIGNS_TO_ADOBE
         where drop_reason = ''           /* Passed records only */
        ) a
    inner join APNS_sends_campaigns b
        on  a.cust_no      = b.cust_no
        and a.product_code = b.product_code
        and (b.date_loaded between a.date_to_adobe
                               and a.date_to_adobe + &adobe_load_window.);
quit;

proc sql noprint;
    select count(*) into :matched_sends trimmed
    from APNS_sends_matched;
quit;

%put Adobe sends after Campaign_Name match: &matched_sends;

/* ============================================================
   FIX 5 — MANY-TO-MANY JOIN GUARD
   If one Optimise record matched more than one Adobe send
   inside the window, log how many such cases exist.
   This does not abort — it informs; dedup downstream handles it.
   ============================================================ */

proc sql noprint;
    create table diag_join_duplicates as
    select cust_no, product_code, opt_batch_date,
           count(*) as join_count
    from APNS_sends_matched
    group by cust_no, product_code, opt_batch_date
    having count(*) > 1;

    select count(*) into :dup_join_count trimmed
    from diag_join_duplicates;
quit;

%put NOTE: Customers with multiple Adobe sends in the &adobe_load_window.-day window: &dup_join_count;

%if &dup_join_count > 0 %then %do;
    title "DIAGNOSTIC - Customers with Multiple Adobe Sends in Window (sample 50)";
    proc print data=diag_join_duplicates (obs=50) noobs; run;
    title;
%end;


/* ============================================================
   SECTION 11 : ADOBE DROP-OFFS
   Fix 19: Validate that the customer-number column in
   APNS.adobe_drop_offs_data exists and resolve its name before
   reading the table. The column may be named ucn, cust_no, UCN,
   or CustomerNumber depending on environment. The resolved name
   is stored in &ucn_col; if no recognised name is found the job
   aborts with a clear diagnostic rather than producing a table
   with all-missing cust_no values.
   ============================================================ */

%macro validate_ucn_col;
    %global ucn_col;
    %let ucn_col = ;

    proc sql noprint;
        select name into :ucn_col trimmed
        from dictionary.columns
        where libname = "APNS"
          and memname = upcase("adobe_drop_offs_data")
          and upcase(name) in ("UCN", "CUST_NO", "CUSTOMERNUMBER")
        order by
            case upcase(name)
                when "UCN"            then 1
                when "CUST_NO"        then 2
                when "CUSTOMERNUMBER" then 3
                else                       4
            end;
    quit;

    %if %length(&ucn_col) = 0 %then %do;
        %put ERROR: Fix 19 — APNS.adobe_drop_offs_data does not contain a recognisable;
        %put ERROR:           customer-number column (checked: ucn, cust_no, CustomerNumber).;
        %put ERROR:           Run: proc contents data=APNS.adobe_drop_offs_data; run;;
        %put ERROR:           Update %validate_ucn_col with the correct column name.;
        %abort cancel;
    %end;
    %else %do;
        %put NOTE: Fix 19 — Customer-number column in adobe_drop_offs_data resolved as: &ucn_col;
    %end;
%mend validate_ucn_col;
%validate_ucn_col;


data Adobe_recent_drops;
    set APNS.adobe_drop_offs_data;
    where product_code in (&product_list.)
      and datepart(Date_loaded) >= "&min_date."d;
    cust_no       = &ucn_col;   /* Fix 19: resolved column name, not hard-coded ucn */
    Date_loaded   = datepart(Date_loaded);
    format Date_loaded date9.;
    Time          = timepart(Date_loaded);
    format Time time9.;
    Brand         = substr(mucn, 1, 3);
    Delivery_code = "";
run;

proc sql noprint;
    select count(*) into :drops_rows trimmed
    from Adobe_recent_drops;
quit;

%put Adobe drop-offs: &drops_rows;

