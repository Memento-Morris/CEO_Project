/*=====================================================================
  OBR EMAIL DISTRIBUTION - TESTING PHASE
  ------------------------------------------------------------
  Sends 3 emails, ALL routed to Morris only while testing:

    1. Agent email   - one xlsx attached PER AGENT (their pack only,
                        so nobody's file shows anyone else's numbers)
    2. TL email      - TL coaching pack attached, roster run-down in body
    3. Manager email - manager overview pack attached, book run-down in body

  Each body is built from the data (top/bottom performer, averages,
  payout splits, weak component) via macro variables - not static text.

  DEPENDS ON: this must run in the same session AFTER
  OBR_View_Generation.sas, since it reuses AgentEarn_now, roster,
  comp_health, payout_desk, payout_rating, monthly_trend, TLEarn_all
  and MgmtEarn_all without recomputing them.

  TEST MODE: every %macro below sends only to &TEST_TO. When ready to
  go live, replace the TO= line inside each macro with the real
  distribution logic (search "TEST MODE" markers below).

  Author: Morris | Growth Analytics
=====================================================================*/

%LET TEST_TO   = Morris.Nkomo@fnb.co.za;
%LET AGENT_OUT = &OUT_PATH/Agents;

/* Make sure the per-agent output folder exists */
options dlcreatedir;
libname _mkdir "&AGENT_OUT";
libname _mkdir clear;

/*=====================================================================
  STEP 1 - ONE WORKBOOK PER AGENT (real file-level segregation)
=====================================================================*/

%MACRO agent_file(agent_fnum, agent_name);

    %GLOBAL agent_file_&agent_fnum;
    %LET agent_file_&agent_fnum = &AGENT_OUT/Agent_OBR_&agent_fnum._&RPT_LABEL..xlsx;

    ODS EXCEL FILE="&&agent_file_&agent_fnum"
        OPTIONS(SHEET_INTERVAL='NONE' EMBEDDED_TITLES='YES' FLOW='TABLES');

    /* --- This month summary --- */
    ODS EXCEL OPTIONS(SHEET_NAME='OBR Receipt');
    TITLE1 "OBR RECEIPT - &agent_name";
    TITLE2 "Employee ID: &agent_fnum   |   Period: %SYSFUNC(PUTN(&RPT_MONTH,MONYY7.))";

    PROC PRINT DATA=AgentEarn_now NOOBS LABEL
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
        WHERE Agent = "&agent_fnum";
        VAR Product Desk OverallScore RatingFull EarnRate CollectedGWP Earn;
        FORMAT OverallScore 5.2 EarnRate PERCENT8.0
               CollectedGWP Earn NLMNY16.2;
        LABEL OverallScore = 'Overall Score'
              RatingFull   = 'Rating'
              EarnRate     = 'Earn Rate'
              CollectedGWP = 'Collected GWP'
              Earn         = 'Earn (share)';
    RUN;

    /* --- Top row for the scorecard grid --- */
    PROC SQL NOPRINT;
        SELECT Product, Desk INTO :top_prod, :top_desk
        FROM AgentEarn_now
        WHERE Agent = "&agent_fnum"
        ORDER BY OverallScore DESC;
    QUIT;

    DATA scorecard_&agent_fnum.;
        SET AgentEarn_now;
        WHERE Agent = "&agent_fnum" AND Product = "&top_prod" AND Desk = "&top_desk";
        LENGTH RowLabel $22;
        RowLabel = 'Target';
        c_Effe = '100%'; c_Save = '50%/32%'; c_FC = '80%'; c_GWP = 'R160k/R120k';
        c_Comp = '0'; c_Effo = '90%'; c_QA = '90%'; c_Score = ''; c_Rating = '';
        OUTPUT;
        RowLabel = 'Weighting';
        c_Effe = '15%'; c_Save = '30%'; c_FC = '30%'; c_GWP = '25%';
        c_Comp = '10%'; c_Effo = '45%'; c_QA = '45%'; c_Score = ''; c_Rating = '';
        OUTPUT;
        RowLabel = 'Actual Result';
        c_Effe = PUT(Effectiveness, PERCENT9.2);
        c_Save = PUT(SaveRatio, PERCENT9.2);
        c_FC   = PUT(FirstCollPerc, PERCENT9.2);
        c_GWP  = CATS('R ', PUT(RetainedGWP, COMMA14.2));
        c_Comp = PUT(Complaints, BEST.);
        c_Effo = PUT(EffortScore, PERCENT9.2);
        c_QA   = PUT(QA, PERCENT9.2);
        c_Score = ''; c_Rating = '';
        OUTPUT;
        RowLabel = 'Points (1-5)';
        c_Effe = PUT(EffeScore, 1.);
        c_Save = PUT(SaveScore, 1.);
        c_FC   = PUT(FCScore,   1.);
        c_GWP  = PUT(GWPScore,  1.);
        c_Comp = PUT(CompScore, 1.);
        c_Effo = PUT(EffoScore, 1.);
        c_QA   = PUT(QAScore,   1.);
        c_Score = PUT(OverallScore, 5.2);
        c_Rating = RatingFull;
        OUTPUT;
        RowLabel = 'Contribution to Score';
        c_Effe = PUT(Effe_Contrib, 4.2);
        c_Save = PUT(Save_Contrib, 4.2);
        c_FC   = PUT(FC_Contrib,   4.2);
        c_GWP  = PUT(GWP_Contrib,  4.2);
        c_Comp = PUT(Comp_Contrib, 4.2);
        c_Effo = PUT(Effo_Contrib, 4.2);
        c_QA   = PUT(QA_Contrib,   4.2);
        c_Score = PUT(OverallScore, 5.2);
        c_Rating = '';
        OUTPUT;
        KEEP RowLabel c_:;
    RUN;

    TITLE3 "SCORECARD - &top_prod / &top_desk";
    PROC REPORT DATA=scorecard_&agent_fnum. NOWD
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
        COLUMN RowLabel c_Effe c_Save c_FC c_GWP c_Comp c_Effo c_QA c_Score c_Rating;
        DEFINE RowLabel / DISPLAY ' ' STYLE=[FONTWEIGHT=BOLD BACKGROUND=#F5E6DC];
        DEFINE c_Effe   / DISPLAY 'Effectiveness';
        DEFINE c_Save   / DISPLAY 'Save Ratio';
        DEFINE c_FC     / DISPLAY '1st Coll %';
        DEFINE c_GWP    / DISPLAY 'GWP Retained';
        DEFINE c_Comp   / DISPLAY 'Complaints';
        DEFINE c_Effo   / DISPLAY 'Effort Score';
        DEFINE c_QA     / DISPLAY 'QA';
        DEFINE c_Score  / DISPLAY 'Score';
        DEFINE c_Rating / DISPLAY 'Rating';
    RUN;

    /* --- Where you lost points --- */
    DATA reflect_&agent_fnum.;
        SET AgentEarn_now;
        WHERE Agent = "&agent_fnum" AND Product = "&top_prod" AND Desk = "&top_desk";
        LENGTH Component $18;
        Component = 'Effectiveness'; Points = EffeScore; Earned = Effe_Contrib;
        MaxPossible = Effe_MaxContrib; Gap = Effe_Lost; OUTPUT;
        Component = 'Save Ratio';    Points = SaveScore; Earned = Save_Contrib;
        MaxPossible = Save_MaxContrib; Gap = Save_Lost; OUTPUT;
        Component = '1st Collection';Points = FCScore;   Earned = FC_Contrib;
        MaxPossible = FC_MaxContrib;   Gap = FC_Lost;   OUTPUT;
        Component = 'GWP Retained';  Points = GWPScore;  Earned = GWP_Contrib;
        MaxPossible = GWP_MaxContrib;  Gap = GWP_Lost;  OUTPUT;
        Component = 'Complaints';    Points = CompScore; Earned = Comp_Contrib;
        MaxPossible = Comp_MaxContrib; Gap = Comp_Lost; OUTPUT;
        Component = 'Effort Score';  Points = EffoScore; Earned = Effo_Contrib;
        MaxPossible = Effo_MaxContrib; Gap = Effo_Lost; OUTPUT;
        Component = 'QA';            Points = QAScore;   Earned = QA_Contrib;
        MaxPossible = QA_MaxContrib;   Gap = QA_Lost;   OUTPUT;
        KEEP Component Points Earned MaxPossible Gap;
    RUN;

    DATA reflect_&agent_fnum.;
        SET reflect_&agent_fnum.;
        LENGTH CoachingNote $40;
        IF Points >= 5      THEN CoachingNote = 'Maxed. Hold this.';
        ELSE IF Points >= 4 THEN CoachingNote = 'Strong. One more push for max.';
        ELSE IF Points >= 3 THEN CoachingNote = 'On target. Room to improve.';
        ELSE IF Points >= 2 THEN CoachingNote = 'Below target. Focus area.';
        ELSE                     CoachingNote = 'Critical. Address first.';
    RUN;

    PROC SORT DATA=reflect_&agent_fnum.; BY DESCENDING Gap; RUN;

    TITLE3 'WHERE YOU STAND';
    PROC PRINT DATA=reflect_&agent_fnum. NOOBS LABEL
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
        VAR Component Points Earned MaxPossible Gap CoachingNote;
        FORMAT Earned MaxPossible Gap 4.2;
        LABEL Component='Component' Points='Your Points'
              Earned='You Earned' MaxPossible='Max Possible'
              Gap='Gap' CoachingNote='Coaching Note';
    RUN;

    /* --- Trend --- */
    PROC SQL;
        CREATE TABLE trend_&agent_fnum. AS
        SELECT CampaignMonth FORMAT=MONYY7. AS Month,
               MAX(OverallScore) AS BestScore FORMAT=5.2,
               PUT(MAX(OverallScore), ratingband.) AS Rating LENGTH=12,
               SUM(CollectedGWP) AS TotalGWP FORMAT=NLMNY16.2,
               SUM(Earn)         AS TotalEarn FORMAT=NLMNY16.2
        FROM AgentEarn_scored
        WHERE Agent = "&agent_fnum"
        GROUP BY CampaignMonth
        ORDER BY CampaignMonth;
    QUIT;

    TITLE3 'YOUR TREND (4 MONTHS)';
    PROC PRINT DATA=trend_&agent_fnum. NOOBS LABEL
        STYLE(HEADER)=[BACKGROUND=#B85042 COLOR=WHITE FONTWEIGHT=BOLD];
    RUN;

    TITLE;
    ODS EXCEL CLOSE;
%MEND;

/* Build the per-agent file list, same pattern as the sheet loop in
   OBR_View_Generation.sas, but now each call opens/closes its own file */
PROC SQL NOPRINT;
    SELECT DISTINCT CATS("%NRSTR(%agent_file)","(",Agent,",",Name,")")
    INTO :AgentFileCalls SEPARATED BY ';'
    FROM AgentEarn_now;
QUIT;
&AgentFileCalls.;

/* Collect the generated file paths into one space-separated, quoted
   list for the ATTACH= option, e.g. ("path1" "path2" "path3" ...) */
PROC SQL NOPRINT;
    SELECT DISTINCT CATS('"', "&AGENT_OUT", '/Agent_OBR_', Agent, '_', "&RPT_LABEL", '.xlsx"')
    INTO :AgentAttachList SEPARATED BY ' '
    FROM AgentEarn_now;
QUIT;
%LET AgentAttachList = (&AgentAttachList);


/*=====================================================================
  STEP 2 - RUN-DOWN STATS FOR EACH EMAIL BODY
=====================================================================*/

/* --- Agent-pack run-down --- */
PROC SQL NOPRINT;
    SELECT COUNT(DISTINCT Agent) INTO :n_agents FROM AgentEarn_now;

    SELECT Name, OverallScore FORMAT=5.2
        INTO :top_agent_name, :top_agent_score
        FROM AgentEarn_now ORDER BY OverallScore DESC;

    SELECT Name, OverallScore FORMAT=5.2
        INTO :low_agent_name, :low_agent_score
        FROM AgentEarn_now ORDER BY OverallScore;

    SELECT COUNT(DISTINCT Agent) INTO :n_below3
        FROM AgentEarn_now WHERE OverallScore < 3;

    SELECT PUT(MEAN(OverallScore),5.2) INTO :avg_score
        FROM (SELECT Agent, MAX(OverallScore) AS OverallScore
              FROM AgentEarn_now GROUP BY Agent);

    SELECT PUT(SUM(Earn),NLMNY16.2) INTO :total_agent_earn
        FROM AgentEarn_now;
QUIT;

/* --- TL-pack run-down (built off the roster/comp_health tables that
       already exist from OBR_View_Generation.sas) --- */
PROC SQL NOPRINT;
    SELECT CATX(', ', Name, PUT(Score,5.2))
        INTO :top3_agents SEPARATED BY ' | '
        FROM (SELECT * FROM roster ORDER BY Score DESC) (OBS=3);

    SELECT CATX(', ', Name, PUT(Score,5.2))
        INTO :bottom3_agents SEPARATED BY ' | '
        FROM (SELECT * FROM roster ORDER BY Score) (OBS=3);

    SELECT PUT(MEAN(Score),5.2) INTO :team_avg_score FROM roster;

    SELECT Component INTO :weakest_component
        FROM comp_health ORDER BY AvgPts;

    SELECT PUT(SUM(TotalEarn),NLMNY16.2) INTO :team_total_earn FROM roster;
QUIT;

/* --- Manager-pack run-down (payout_desk / payout_rating / monthly_trend
       already exist from OBR_View_Generation.sas) --- */
PROC SQL NOPRINT;
    SELECT Desk, PUT(TotalEarn,NLMNY16.2)
        INTO :top_desk_name, :top_desk_earn
        FROM payout_desk ORDER BY TotalEarn DESC;

    SELECT PUT(SUM(TotalEarn),NLMNY16.2) INTO :book_total_earn FROM payout_desk;

    SELECT CATX(': ', Rating, PUT(People,BEST.))
        INTO :rating_breakdown SEPARATED BY ' | '
        FROM payout_rating;
QUIT;

/* Month-on-month direction, off monthly_trend */
PROC SQL NOPRINT;
    SELECT COUNT(*) INTO :n_months FROM monthly_trend;
QUIT;
%IF &n_months >= 2 %THEN %DO;
    PROC SQL NOPRINT;
        SELECT AvgScore INTO :score_this_month
            FROM (SELECT * FROM monthly_trend ORDER BY Month DESC) (OBS=1);
        SELECT AvgScore INTO :score_last_month
            FROM (SELECT * FROM monthly_trend ORDER BY Month DESC) (OBS=1 FIRSTOBS=2);
    QUIT;
    %LET score_move = %SYSEVALF(&score_this_month - &score_last_month);
    %IF %SYSEVALF(&score_move >= 0) %THEN %LET trend_word = up;
    %ELSE %LET trend_word = down;
%END;
%ELSE %DO;
    %LET score_move  = 0;
    %LET trend_word  = flat (only one month of data so far);
%END;


