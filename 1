SELECT *
FROM [FNB_STI_Analytics].[Claims].[vw_Ops_Claims_Age] a
LEFT JOIN (
    SELECT *
    FROM [FNB_STI_Analytics].[Claims].[vw_OCR_Claims_Age]
    WHERE Investigate_Flag = '1'
) b
ON a.SubjectCode = b.SubjectCode  -- i.e. ClaimCode
LEFT JOIN [FNB_STI_Analytics].[Claims].[vw_OCR_Movement_Age] c
    ON a.SubjectCode = c.SubjectCode
ORDER BY ReportedMonth DESC;
