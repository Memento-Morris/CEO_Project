/* ============================================================
   SECTION 13: LOAD TO PRODUCTION - WITH ZERO-ROW SAFETY GATE
   ============================================================ */

%macro Loadtable(Table);
  %if %sysfunc(exist(&table.)) %then %do;

    proc sql noprint;
      select count(*) into :new_row_count trimmed
      from &Table.;
    quit;

    %if &new_row_count = 0 %then %do;
      %put ERROR: =====================================================;
      %put ERROR: &Table. has ZERO rows - aborting production load.;
      %put ERROR: STI_PBI.&Table. has NOT been updated.;
      %put ERROR: Check campaign config, date extraction and joins.;
      %put ERROR: =====================================================;
      data _null_;
        abort return 1;
      run;
    %end;
    %else %do;
      %put NOTE: &Table. has &new_row_count rows - loading to production.;
      proc sql;
        drop table STI_PBI.&Table.;
        create table STI_PBI.&Table. as
        select * from &Table.;
      quit;
    %end;

  %end;
  %else %do;
    %put ERROR: Work table &Table. does not exist - cannot load to production.;
  %end;
%mend;

