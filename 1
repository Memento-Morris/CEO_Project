/* ============================================================
   SECTION 6B : READ FULL OPPORTUNITY FROM CONFIG INPUT FILES
   -------------------------------------------------------
   Fix 13: %find_input_file searches four locations in priority
   order so the job never reads from the live incoming/ folder
   (where Optimise may hold a lock or have already moved the file).

   Priority order:
     1. passed_import  — file was imported successfully by Optimise
     2. dropped_import — file failed import (still worth tracking)
     3. archive        — older batches moved to archive
     4. incoming/in/   — last resort; only if file hasn't been moved
                          yet (e.g. job runs before Optimise does)

   The resolved path and status (PASSED/FAILED/ARCHIVED/INCOMING)
   are written to macro variables &resolved_path_&i and
   &import_status_&i for use in diagnostics.

   Fix 8 : CUST_NO rename handled post-import via PROC CONTENTS
            to accommodate any column-name casing from the source.
   Fix 9 : unique_id includes loop index to avoid _n_ collisions.
   ============================================================ */

/* Base paths — change here if the environment moves */
%let path_passed_import  = /data/fnb/clb/prod_data/4_import_validation/passed_import/;
%let path_dropped_import = /data/fnb/clb/prod_data/4_import_validation/dropped_import/;
%let path_archive        = /data/fnb/clb/archive/4_import_validation/passed_import/;
%let path_incoming       = /data/fnb/clb/incoming_files/4_import_validation/in/;

/* Fix 13: macro that resolves the correct file location */
%macro find_input_file(file_name=, idx=);
    /* Reset output macro variables */
    %global resolved_path_&idx import_status_&idx;
    %let resolved_path_&idx  = ;
    %let import_status_&idx  = NOT_FOUND;

    %if %sysfunc(fileexist(&path_passed_import.&file_name)) %then %do;
        %let resolved_path_&idx  = &path_passed_import.&file_name;
        %let import_status_&idx  = PASSED;
    %end;
    %else %if %sysfunc(fileexist(&path_dropped_import.&file_name)) %then %do;
        %let resolved_path_&idx  = &path_dropped_import.&file_name;
        %let import_status_&idx  = FAILED;
        %put WARNING: Input file for campaign at index &idx found in dropped_import.;
        %put WARNING: This means Optimise rejected the file. Full opportunity counts may be unreliable.;
    %end;
    %else %if %sysfunc(fileexist(&path_archive.&file_name)) %then %do;
        %let resolved_path_&idx  = &path_archive.&file_name;
        %let import_status_&idx  = ARCHIVED_PASSED;
    %end;
    %else %if %sysfunc(fileexist(&path_incoming.&file_name)) %then %do;
        %let resolved_path_&idx  = &path_incoming.&file_name;
        %let import_status_&idx  = INCOMING;
        %put WARNING: Input file for campaign at index &idx is still in the incoming folder.;
        %put WARNING: Optimise may not have processed it yet or may move it during this read.;
    %end;
    %else %do;
        %put ERROR: Input file [&file_name] not found in any of the four expected locations:;
        %put ERROR:   1. &path_passed_import;
        %put ERROR:   2. &path_dropped_import;
        %put ERROR:   3. &path_archive;
        %put ERROR:   4. &path_incoming;
    %end;
%mend find_input_file;


%macro read_full_opportunity;

    proc datasets library=work nolist;
        delete full_opp_raw_:;
    quit;

    %put NOTE: Reading full opportunity from &config_count input files.;

    %local i camp_code prod_code file_name file_type file_sheet full_path;

    %do i = 1 %to &config_count;

        /* Fix 6: select by row_num (explicit), not monotonic() */
        proc sql noprint;
            select Campaign_Code, Product_Code,
                   Input_File_Name, Input_File_Type, Input_File_Sheet
            into   :camp_code  trimmed, :prod_code   trimmed,
                   :file_name  trimmed, :file_type   trimmed,
                   :file_sheet trimmed
            from   Campaign_Config
            where  row_num = &i;
        quit;

        %put NOTE: Processing input file &i of &config_count: &camp_code -> &file_name;

        /* Fix 13: resolve the correct file path across four locations */
        %find_input_file(file_name=&file_name, idx=&i)

        %if %length(&&resolved_path_&i) > 0 %then %do;

            %let full_path = &&resolved_path_&i;
            %put NOTE: File resolved at [&&import_status_&i]: &full_path;

            /* ---- Import based on file type ---- */
            %if &file_type = EXCEL %then %do;
                proc import
                    datafile = "&full_path"
                    out      = _full_opp_import_&i
                    dbms     = xlsx
                    replace;
                    sheet    = "&file_sheet";
                    getnames = yes;
                run;
            %end;

            %else %if &file_type = CSV %then %do;
                proc import
                    datafile = "&full_path"
                    out      = _full_opp_import_&i
                    dbms     = csv
                    replace;
                    getnames = yes;
                run;
            %end;

            %else %if &file_type = SAS %then %do;
                data _full_opp_import_&i;
                    set "&full_path";
                run;
            %end;

            %else %do;
                %put WARNING: Unknown file type [&file_type] for &camp_code. Skipping.;
                %goto next_campaign;
            %end;

            /* Fix 8: post-import rename — handles any column-name casing */
            proc contents data=_full_opp_import_&i
                          out=_colcheck_&i (keep=name) noprint; run;

            proc sql noprint;
                select count(*) into :has_cust_no trimmed
                from _colcheck_&i
                where upcase(name) = "CUST_NO";
            quit;

            %if &has_cust_no > 0 %then %do;
                proc sql noprint;
                    select name into :cust_col trimmed
                    from _colcheck_&i
                    where upcase(name) = "CUST_NO";
                quit;

                data _full_opp_import_&i;
                    set _full_opp_import_&i
                        (rename=(&cust_col = cust_no));
                run;
            %end;
            %else %do;
                %put ERROR: Input file for &camp_code does not contain a CUST_NO column.;
                %put ERROR: Please check &full_path and ensure the customer number column is named CUST_NO.;
                %goto next_campaign;
            %end;

            /* Fix 9: unique_id includes loop index to prevent _n_ collision */
            data full_opp_raw_&i;
                set _full_opp_import_&i;
                length Campaign_Code  $50
                       Product_Code   $30
                       Input_File     $200
                       Import_Status  $20
                       unique_id      $100;
                Campaign_Code = "&camp_code";
                Product_Code  = "&prod_code";
                Input_File    = "&file_name";
                Import_Status = "&&import_status_&i";   /* Fix 13: location status */
                row_id        = _n_;
                unique_id     = cats("&camp_code", "_", "&prod_code", "_", &i, "_", row_id);

                flag_missing_product_code = (missing(Product_Code) or strip(Product_Code) = "");
                flag_missing_cust_no      = (missing(cust_no) or cust_no <= 0);
            run;

            proc datasets library=work nolist;
                delete _full_opp_import_&i _colcheck_&i;
            quit;

        %end;
        /* else: %find_input_file already issued ERROR message — skip this campaign */

        %next_campaign:

    %end; /* end do i */

%mend read_full_opportunity;

%read_full_opportunity;


