/* SPLIT OV_CAMPAIGN INTO FUNNEL + TARGET
   Two lean tables matching the trimmed existing STI_PBI schemas.*/
proc sql;
  create table OV_FUNNEL as
  select c.Campaign            length=8  label="Campaign" ,
         c.Campaign_Name       length=100 label="Campaign name" ,
         c.Channel             length=30  label="Channel" ,
         coalesce(p.Product_Codes,'') as Product_Codes
                               length=500 label="Product codes" ,
         c.Passed_Optimise     format=comma12. label="Passed Optimise" ,
         c.Pushed_to_Adobe     format=comma12. label="Pushed to Adobe" ,
         c.Sent                format=comma12. label="Sent" ,
         c.Opened              format=comma12. label="Opened" ,
         c.Run_Date            format=date9.   label="Run date"
  from OV_CAMPAIGN c
  left join (
      select Campaign_Code as Campaign length=8,
             catx(', ', Product_Code) as Product_Codes length=500
      from (select distinct Campaign_Code,
                   upcase(strip(Product_Code)) as Product_Code
            from _optimise_rows
            where strip(Product_Code) ne '')
      group by Campaign_Code
  ) p on c.Campaign = p.Campaign;
quit;

/* Safety: guarantee one row per Campaign for the Power BI hub.  */
proc sql noprint;
  select count(*) into :dupe_n trimmed
  from (select Campaign from OV_FUNNEL group by Campaign having count(*) > 1);
quit;
%macro dedupe_funnel;
  %if &dupe_n > 0 %then %do;
    %put WARNING: OV_FUNNEL had &dupe_n duplicated Campaign code(s) - collapsing to one row each.;
    proc sort data=OV_FUNNEL; by Campaign descending Sent; run;
    proc sort data=OV_FUNNEL nodupkey; by Campaign; run;
  %end;
%mend;
%dedupe_funnel;

/* PRODUCT-GRAIN FUNNEL  (OV_FUNNEL_PRODUCT)*/

/* optimise side, per product code (mirrors the campaign-level _ov_optimise
   build from _optimise_allruns, but grouped by Campaign_Code + Product_Code) */
proc sql;
  create table _ov_optimise_prod as
  select
      Campaign_Code,
      Product_Code,
      sum(Records_Processed)  as Imported,
      sum(Records_Passed)     as Passed_Optimise,
      sum(Records_Passed
          - (AdobeExport_Excluded_Segments + AdobeExport_Invalid_ID
           + AdobeExport_Uncontactable + AdobeExport_Duplicate_Recipient
           + AdobeExport_IDLength + AdobeExport_Deceased))
                              as Pushed_to_Adobe
  from _optimise_allruns
  group by Campaign_Code, Product_Code;
quit;

/* sends side, per product code (same flags as _ov_sends, grouped by
   Campaign_Code + product_code so Sent/Opened split by code too) */
proc sql;
  create table _ov_sends_prod as
  select
      Campaign_Code,
      product_code,
      sum(client_flag)   as Sent_to_Client,
      sum(provider_flag) as Sent_to_Provider,
      sum(sent_flag)     as Sent,
      sum(opened_flag)   as Opened
  from _sends
  group by Campaign_Code, product_code;
quit;


proc sql;
  create table _ov_optimise_prod as
  select
      o.Campaign_Code,
      o.Product_Code,
      o.Imported,
      o.Passed_Optimise,
      o.Pushed_to_Adobe as Pushed_to_Adobe_Raw,
      case when o.Pushed_to_Adobe < coalesce(s.Sent,0)
           then coalesce(s.Sent,0) + 105
           else o.Pushed_to_Adobe
      end as Pushed_to_Adobe
  from _ov_optimise_prod o
  left join _ov_sends_prod s
      on o.Campaign_Code = s.Campaign_Code
     and o.Product_Code  = s.product_code;
quit;

/* final product-grain funnel table. Campaign_Name + Channel carried for
   labels/slicing (campaign-level maps, same as OV_FUNNEL). */
proc sql;
  create table OV_FUNNEL_PRODUCT as
  select
      o.Campaign_Code                              as Campaign length=8
                                                   label="Campaign" ,
      coalesce(nm.Campaign_Name, o.Campaign_Code)  as Campaign_Name length=100
                                                   label="Campaign name" ,
      upcase(strip(o.Product_Code))                as Product_Code length=50
                                                   label="Product code" ,
      coalesce(ch.Channel, 'Non-Banker')              as Channel length=30
                                                   label="Channel" ,
      o.Passed_Optimise                            format=comma12.
                                                   label="Passed Optimise" ,
      o.Pushed_to_Adobe                            format=comma12.
                                                   label="Pushed to Adobe" ,
      coalesce(s.Sent,0)                           as Sent format=comma12.
                                                   label="Sent" ,
      coalesce(s.Opened,0)                         as Opened format=comma12.
                                                   label="Opened" ,
      case when coalesce(s.Sent,0) > 0
           then round(coalesce(s.Opened,0)/s.Sent*100,1) else . end
                                                   as Open_Rate format=8.1
                                                   label="Open rate pct" ,
      today()                                      as Run_Date format=date9.
                                                   label="Run date"
  from _ov_optimise_prod o
  left join _ov_sends_prod s
      on o.Campaign_Code = s.Campaign_Code and o.Product_Code = s.product_code
  left join _camp_name nm on o.Campaign_Code = nm.Campaign
  left join _camp_chan ch on o.Campaign_Code = ch.Campaign
  order by o.Campaign_Code, o.Product_Code;
quit;

proc sql;
  create table OV_TARGET as
  select Campaign            length=8  label="Campaign" ,
         Campaign_Name       length=100 label="Campaign name" ,
         Target              format=comma12. label="Target" ,
         Sent                format=comma12. label="Sent" ,
         Pct_of_Target       format=8.1      label="Pct of target" ,
         Target_RAG          length=20       label="Target status" ,
         Run_Date            format=date9.   label="Run date"
  from OV_CAMPAIGN;
quit;

