%macro iterate_week_drop(count);

  proc sql;
    select count(distinct memname) into :count
    from uppend_weeek_campaigns;
  quit;

  proc datasets library=work nolist;
    delete TABLESdropweek_:;
  quit;

  %do i = 1 %to &count.;
    data TABLESdropweek_&i;
      set APN_DROP.&&tableweek&i.;

      /* FIX: Dynamic date/time extraction */
      %if %index(&&tableweek&i.., _) > 0 %then %do;
        _date_raw = scan("&&tableweek&i..", -2, '_');
        _time_raw = scan("&&tableweek&i..", -1, '_');
        Date_to_adobe = input(_date_raw, YYMMDD8.);
        format Date_to_adobe date9.;
        Time_created_to_adobe = input(cats(substr(_time_raw,1,2),':',
                                           substr(_time_raw,3,2),':00'),
                                      HHMMSS8.);
        format Time_created_to_adobe time9.;
        drop _date_raw _time_raw;
      %end;
      %else %do;
        _date_raw = substr("&&tableweek&i..", 16, 8);
        _time_raw = substr("&&timetablewk&i..", 9, 8);
        Date_to_adobe = input(_date_raw, YYMMDD10.);
        format Date_to_adobe date9.;
        Time_created_to_adobe = input(_time_raw, HHMMSS.);
        format Time_created_to_adobe time9.;
        drop _date_raw _time_raw;
      %end;

    run;
  %end;

%mend;
%iterate_week_drop(count)


