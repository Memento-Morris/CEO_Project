    select product_code,
           count(*)                         as Row_Count,
           min(Date_loaded) format=date9.   as First_Drop,
           max(Date_loaded) format=date9.   as Last_Drop
    from Adobe_recent_drops
    group by product_code
    order by product_code;
quit;
