/* ============================================================
   SECTION 4: HELPER MACRO - DYNAMIC DATE/TIME EXTRACTION
   FIX: Replaces fixed substr(memname,16,8) with scan() logic
        that works on both old format (CMA02369YYYYMMDD) and
        new format (CMA09654V02M03_20260417_1238).

   Logic:
     - If the name contains an underscore, date = second-to-last
       token, time = last token (new format).
     - If no underscore, fall back to substr at position 16
       (old format, kept for backward compatibility).
   ============================================================ */

%macro extract_date_time(memname_val, crdate_val, date_var, time_var);

  /* Check if new format (contains underscore) */
  %if %index(&memname_val., _) > 0 %then %do;
    /* NEW FORMAT: CMA09654V02M03_20260417_1238 */
    &date_var._raw  = scan("&memname_val.", -2, '_');
    &time_var._raw  = scan("&memname_val.", -1, '_');
    &date_var.      = input(&date_var._raw, YYMMDD8.);
    format &date_var. date9.;
    /* Time token is HHMM - convert to HH:MM:SS */
    &time_var.      = input(cats(substr(&time_var._raw,1,2),':',
                                 substr(&time_var._raw,3,2),':00'),
                            HHMMSS8.);
    format &time_var. time9.;
    drop &date_var._raw &time_var._raw;
  %end;
  %else %do;
    /* OLD FORMAT: CMA02369YYYYMMDD - kept for backward compatibility */
    &date_var._raw  = substr("&memname_val.", 16, 8);
    &time_var._raw  = substr("&crdate_val.",   9, 8);
    &date_var.      = input(&date_var._raw, YYMMDD10.);
    format &date_var. date9.;
    &time_var.      = input(&time_var._raw, HHMMSS.);
    format &time_var. time9.;
    drop &date_var._raw &time_var._raw;
  %end;

%mend extract_date_time;


