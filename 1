/* ============================================================
   SECTION 7: ADOBE SENDS
   Reads push notification sends from the Adobe tracking view,
   filtered to the configured product codes and to dates on or
   after the earliest Optimise date (so we only look forward).
   ============================================================ */

libname APNS "/data/fnb/clb/prod_data/7_tracking_views/Reporting_views";

proc sql noprint;
  select min(Date_to_adobe) into :min_date trimmed
  from CAMPAIGNS_TO_ADOBE;
quit;
%put Minimum Optimise date: &min_date;

data APNS_sends (keep=cust_no ucn mucn product_code Date_loaded Time
                      Drop_reason Brand Delivery_code);
  set APNS.apn_sends_and_feedback;
  where product_code in (&product_codes.)
    and datepart(Distribution_date) >= "&min_date."d;

  Brand         = substr(mucn, 1, 3);
  Drop_reason   = "";
  Date_loaded   = datepart(Distribution_date);
  Time          = timepart(Distribution_date);
  Delivery_code = upcase(Delivery_code);

  format Date_loaded date9. Time time9.;
run;


/* ============================================================
   SECTION 8: ADOBE DROP-OFFS
   ============================================================ */

data Adobe_drops;
  set APNS.adobe_drop_offs_data;
  where product_code in (&product_codes.)
    and datepart(Date_loaded) >= "&min_date."d;

  Date_loaded   = datepart(Date_loaded);
  Time          = timepart(Date_loaded);
  Brand         = substr(mucn, 1, 3);
  Delivery_code = "";

  format Date_loaded date9. Time time9.;
run;


/* ============================================================
   SECTION 9: COMBINE ADOBE DATA AND FLAG TEST RECORDS
   ============================================================ */

data Adobe_combined;
  set Adobe_drops APNS_sends;

  /* Determine whether this row was actually sent or dropped */
  if upcase(strip(Delivery_code)) = "TEST" then do;
    Adobe  = "TEST";
    Client = "TEST";
  end;
  else if drop_reason = "" then do;
    Adobe  = "Loaded";
    Client = "Sent";
  end;
  else do;
    Adobe  = drop_reason;
    Client = drop_reason;
  end;

  /* Unify customer identifier: prefer cust_no, fall back to UCN */
  if strip(cust_no) = "" then cust_no = UCN;

  testindicator = ifc(upcase(strip(Delivery_code)) = "TEST", "TEST", "Actual");
run;


/* ============================================================
   SECTION 10: FINAL JOIN - OPTIMISE + ADOBE
   
   FIX: The original join had the BETWEEN range backwards.
   Correct logic: find Adobe loads that happened within 5 days
   AFTER the Optimise date (date_to_adobe).
   
   We keep only the earliest Adobe load date per
   (cust_no, product_code, date_to_adobe) to avoid fan-out.
   ============================================================ */

proc sql noprint;
  create table APNS_DATA as
  select
    a.cust_no,
    a.sub_segment,
    a.product_code          as product_code_to_adobe,
    a.Drop_reason           as Drop_reason_to_adobe,
    a.Campaign_name,
    a.Date_to_adobe,
    a.Time_created_to_adobe,
    a.optimize,
    a.success_to_adobe,
    a.drop_to_adobe,
    b.Date_loaded,
    b.Time,
    b.Adobe,
    b.Client,
    b.testindicator,
    b.brand,
    intck('day', a.Date_to_adobe, b.Date_loaded) as date_diff

  from CAMPAIGNS_TO_ADOBE a

  left join (
    /* Pre-aggregate Adobe: one row per customer/product/date_to_adobe -
       the earliest load date within the 5-day window.             */
    select
      cust_no, ucn, product_code, Date_loaded, Time,
      Adobe, Client, testindicator, brand, drop_reason
    from Adobe_combined
  ) b
    on  ( a.cust_no      = b.cust_no
       or a.cust_no      = b.ucn )         /* handle UCN/cust_no mismatch */
    and a.product_code      = b.product_code
    /* FIX: load must happen on or after optimise date, within 5 days */
    and b.Date_loaded between a.Date_to_adobe and (a.Date_to_adobe + 5)
  ;
quit;

/* For customers who were "Sent" but have no Adobe match, classify appropriately */
data APNS_DATA;
  set APNS_DATA;

  if Date_loaded = . and optimize = "Sent" then do;
    if intck('day', Date_to_adobe, today()) > 5
      then Adobe = "Not loaded into Adobe within 5 days";
    else
      Adobe = "Sending to Adobe";
  end;
run;

/* Deduplicate: keep only the earliest Adobe load per key */
proc sort data=APNS_DATA;
  by cust_no product_code_to_adobe Date_to_adobe Date_loaded;
run;

proc sort data=APNS_DATA nodupkey
          out=APNS_DATA (drop=success_to_adobe drop_to_adobe);
  by cust_no product_code_to_adobe Date_to_adobe;
run;

proc sql noprint;
  select count(*) into :final_rows trimmed from APNS_DATA;
quit;
%put APNS_DATA final row count: &final_rows;


/* ============================================================
   SECTION 11: LOAD TO PRODUCTION - WITH ZERO-ROW SAFETY GATE
   ============================================================ */

%macro Loadtable(Table);

  %if %sysfunc(exist(&Table)) %then %do;

    proc sql noprint;
      select count(*) into :new_row_count trimmed from &Table;
    quit;

    %if &new_row_count = 0 %then %do;
      %put ERROR: =====================================================;
      %put ERROR: &Table has ZERO rows - aborting production load.;
      %put ERROR: STI_PBI.&Table has NOT been updated.;
      %put ERROR: Check campaign config, date extraction and joins.;
      %put ERROR: =====================================================;
      %abort cancel;
    %end;
    %else %do;
      %put NOTE: &Table has &new_row_count rows - loading to production.;
      proc sql;
        drop table STI_PBI.&Table;
        create table STI_PBI.&Table as select * from &Table;
      quit;
    %end;

  %end;
  %else %do;
    %put ERROR: Work table &Table does not exist - cannot load to production.;
    %abort cancel;
  %end;

%mend;

%Loadtable(APNS_DATA)


