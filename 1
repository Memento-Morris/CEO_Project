proc sql;
Create Table OLDEST_ITEM_STEP as 
select distinct id,intnx("month",&date,0,"end") as Month format date9.
,ASSIGNED_TO,max(datepart(Comments_Begin_Date)) as Oldest_Item format date9.,&date-max(datepart(Comments_Begin_Date)) as No_Days format 8.,
count(distinct ID) as number_of_items_in_queue
from Workflow_Yest
group by ID,ASSIGNED_TO;
quit;

proc sql;
create table SERVICE_OLDEST_ITEM_FINAL as
select distinct Month, ASSIGNED_TO, min(Oldest_Item) as Oldest_Item format date9., max(No_Days) as No_Days, sum(number_of_items_in_queue) as number_of_items_in_queue
from OLDEST_ITEM_STEP
group by ASSIGNED_TO;
quit;



/*SLA*/
proc sql;
create table Items as
select distinct ID, Created_Date, Assigned_To, Policy_Number, upcase(Status_Name) as Status_Name, min(Comments_Created_Date) format datetime20. as min_Comments_Created_Date, 
max(Comments_Created_Date) format datetime20. as max_Comments_Created_Date
from FNB400_AYH_WORKFLOW2
group by ID, Assigned_To, Policy_Number
;quit;

PROC sql;
create table Items_step as
select * 
,CASE WHEN Status_Name in ("DONE","DUPLICATE","RETAINED","UNCONTACTABLE","NO ACTION REQUIRED") THEN "CLOSED"
ELSE "OPEN"
END AS Indicator
from Items
;quit;

%let date = today();



data SERVICE_ITEMS_FINAL;
set Items_step;
min_Created_Day_of_Week = weekday(datepart(min_comments_created_date));
max_Created_Day_of_Week = weekday(datepart(max_comments_created_date));
if min_Created_Day_of_Week in (2,3,4) then close_Target = min_Comments_Created_Date + 48*60*60;
else if min_Created_Day_of_Week in (5,6) then close_Target = min_Comments_Created_Date + 96*60*60;
else if min_Created_Day_of_Week = 7 then close_Target = dhms(datepart(min_Comments_Created_Date)+2,8,0,0) + 48*60*60;
else if min_Created_Day_of_Week = 1 then close_Target = dhms(datepart(min_Comments_Created_Date)+1,8,0,0) + 48*60*60;
format close_Target datetime20.;

if Indicator = "CLOSED" and max_Comments_Created_Date > close_Target then SLA = 'Outside SLA';
else if Indicator = "OPEN" and &date > datepart(close_Target) then SLA = 'Outside SLA';
else SLA = 'In SLA';

Duration = &date - datepart(close_Target);

if Indicator = "CLOSED" then Assigned_Date = datepart(max_comments_created_date);
else if Indicator = "OPEN" then Assigned_Date = &date-1;
format Assigned_Date date10.;

run;

proc sql;

create table Out_of_SLA_File as
select *
from SERVICE_ITEMS_FINAL
where Indicator = "OPEN" 
and SLA = "Outside SLA"
;quit;


/* importing active employees*/

proc sql;
create table Open_Items_Out_of_SLA as
select  b.*,a.* 
from Out_of_SLA_File a
left join Servicing b
on a.ASSIGNED_TO = b.EmployeeNumber
where b.active = 1;
run;



