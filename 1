/* ============================================================
   CAMPAIGN STATUS LOOKUP
   Instructions: Change the campaign code below and run.
   ============================================================ */

%let campaign_code = CMA02369;   /* <-- CHANGE THIS */

/* ============================================================
   STEP 1: Pull passed leads (6 months archive + last 7 days)
   ============================================================ */

libname Pass6   "/data/fnb/clb/archive/5_optimise/passed_phase1";
libname APN_Pass "/data/fnb/clb/prod_data/5_optimise/passed_phase1";
libname Drop6   "/data/fnb/clb/archive/5_optimise/dropped_phase1";
libname APN_Drop "/data/fnb/clb/prod_data/5_optimise/dropped_phase1";
libname APNS    "/data/fnb/clb/prod_data/7_tracking_views/Reporting_views";

/* Get all matching table names from each library */
proc sql noprint;
  select memname into :pass6_tables separated by ' '
  from dictionary.tables
  where libname = "PASS6" and memname like "%&campaign_code.%";

  select memname into :passweek_tables separated by ' '
  from dictionary.tables
  where libname = "APN_PASS" and memname like "%&campaign_code.%";

  select memname into :drop6_tables separated by ' '
  from dictionary.tables
  where libname = "DROP6" and memname like "%&campaign_code.%";

  select memname into :dropweek_tables separated by ' '
  from dictionary.tables
  where libname = "APN_DROP" and memname like "%&campaign_code.%";
quit;

%put Pass 6mo tables  : &pass6_tables;
%put Pass 7day tables : &passweek_tables;
%put Drop 6mo tables  : &drop6_tables;
%put Drop 7day tables : &dropweek_tables;

/* ============================================================
   STEP 2: Stack all matching tables into one dataset
   ============================================================ */

%macro stack_tables(libref, tablelist, outds);
  %let n = %sysfunc(countw(&tablelist));
  %if &n = 0 %then %do;
    %put WARNING: No tables found in &libref for &campaign_code;
  %end;
  %else %do;
    data &outds;
      set
      %do i = 1 %to &n;
        &libref..%scan(&tablelist, &i)
      %end;
      (keep= cust_no product_code drop_reason sub_segment campaign_name brand mucn);
    run;
  %end;
%mend;

%stack_tables(PASS6,   &pass6_tables,   passed_6mo)
%stack_tables(APN_PASS,&passweek_tables, passed_week)
%stack_tables(DROP6,   &drop6_tables,   dropped_6mo)
%stack_tables(APN_DROP,&dropweek_tables, dropped_week)

/* Combine all into one */
data all_leads;
  set
  %if %sysfunc(exist(passed_6mo))   %then passed_6mo;
  %if %sysfunc(exist(passed_week))  %then passed_week;
  %if %sysfunc(exist(dropped_6mo))  %then dropped_6mo;
  %if %sysfunc(exist(dropped_week)) %then dropped_week;
  ;
  if drop_reason = "" then status = "Passed";
                      else status = "Dropped";
run;

/* ============================================================
   STEP 3: Summary report
   ============================================================ */

title "Campaign Status Report: &campaign_code";

/* Total leads */
proc sql;
  select
    count(*)                              as Total_Leads     format comma10.,
    sum(status = "Passed")                as Total_Passed    format comma10.,
    sum(status = "Dropped")               as Total_Dropped   format comma10.,
    round(sum(status="Passed")/count(*)*100, 0.1) as Pass_Rate_Pct  format 8.1
  from all_leads;
quit;

/* Breakdown by drop reason */
title2 "Drop reason breakdown";
proc sql;
  select
    drop_reason                           as Drop_Reason,
    count(*)                              as Count           format comma10.,
    round(count(*)/
      (select count(*) from all_leads where status="Dropped")*100, 0.1) as Pct_of_Drops format 8.1
  from all_leads
  where status = "Dropped"
  group by drop_reason
  order by count(*) desc;
quit;

/* Breakdown by sub-segment */
title2 "Sub-segment breakdown";
proc sql;
  select
    sub_segment,
    count(*)                              as Total           format comma10.,
    sum(status = "Passed")                as Passed          format comma10.,
    sum(status = "Dropped")               as Dropped         format comma10.,
    round(sum(status="Passed")/count(*)*100, 0.1) as Pass_Rate     format 8.1
  from all_leads
  group by sub_segment
  order by total desc;
quit;

/* Adobe send status */
title2 "Adobe delivery status";
proc sql;
  select
    upcase(delivery_code)                 as Delivery_Code,
    count(*)                              as Count           format comma10.
  from APNS.apn_sends_and_feedback
  where product_code like "%&campaign_code.%"
  group by upcase(delivery_code)
  order by count(*) desc;
quit;

title;
