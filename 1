/* ============================================================
   SECTION 17: LOAD TO PRODUCTION - WITH ZERO-ROW SAFETY GATE
   FIX: Prevents empty table from overwriting production data
        if upstream processing fails silently.
   ============================================================ */

%macro Loadtable(Table);
  %if %sysfunc(exist(&table.)) %then %do;

    /* Safety check - count rows before writing to production */
    proc sql noprint;
      select count(*) into :new_row_count trimmed
      from &Table.;
    quit;

    %if &new_row_count = 0 %then %do;
      %put ERROR: =======================================================;
      %put ERROR: &Table. has ZERO rows - aborting production load.;
      %put ERROR: Production table STI_PBI.&Table. has NOT been updated.;
      %put ERROR: Check upstream campaign discovery and date extraction.;
      %put ERROR: =======================================================;
      /* Force a SAS error so the scheduler flags the job as failed */
      data _null_;
        abort return 1;
      run;
    %end;
    %else %do;
      %put NOTE: &Table. has &new_row_count rows - proceeding with production load.;
      proc sql;
        drop table STI_PBI.&Table.;
        create table STI_PBI.&Table. as
        select * from &Table.;
      quit;
    %end;

  %end;
  %else %do;
    %put ERROR: Work table &Table. does not exist - cannot load to production.;
  %end;
%mend;

%Loadtable(APNS_DATA);


