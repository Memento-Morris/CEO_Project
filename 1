  set adobe_final;
  if testindicator ne "     TEST     " or testindicator = "             "
    then testindicator = "Actual";
  else testindicator = testindicator;
  if testindicator = "TEST" then Adobe  = testindicator;
  else adobe = adobe;
  if testindicator = "TEST" then Client = testindicator;
  else client = client;
  rename cust_no = cust_no2;
run;


