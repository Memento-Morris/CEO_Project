/* ---------------------------------------------------------------------------
   FIX: Removed +7 and +1 date offsets.
   Previously: on (A.run_date between b.Start_Date+7 and b.End_date+1)
   This was shifting the join window forward by 7 days, causing the macro to
   pull run dates from the wrong (prior) period — making QA read Feb instead
   of Mar. Removed the 3rd macro parameter (QA_Periods) which was never passed
   in the macro calls and served no purpose.
   --------------------------------------------------------------------------- */
%macro ALL_OFFICE_MONTHLY_EARN(Office_Name, From_Office_Remm);
proc sql;
    create table &Office_Name as
    select      a.Full_Name,
                a.line,
                a.Employee_Number,
                round(avg(ScoreCard), 0.01)  as Monthly_Score,
                sum(a.Earn_before_QA)        as Monthly_Earn_before_QA,
                a.active,
                b.QA_Period
    from        &From_Office_Remm a
    inner join  Periods b
        on (a.run_date between b.Start_Date and b.End_date)   /* FIX: no +7 / +1 */
    group by    a.Full_Name, a.Employee_Number, a.line, a.active, b.QA_Period;
quit;
%mend;
%ALL_OFFICE_MONTHLY_EARN(LOC_SER_Monthly_Earn_PreQA, LOC_Servicing_Earn);
%ALL_OFFICE_MONTHLY_EARN(COMP_SER_Monthly_Earn_PreQA, COMP_Servicing_Earn);


/* ---------------------------------------------------------------------------
   Calculating QA scores
   --------------------------------------------------------------------------- */

/* QA scores from scorecard run */
%macro QA(Tablename, from);
data &Tablename;
    set &from;
    Evaluations2 = Evaluations;
    by descending Date_stamp;
    if score = . then evaluations = 0;
run;
%mend;
%QA(Service_QA_Raw, sti_pbi.Service_QA_Final)

proc sort data=Service_QA_Raw;
    by employee_number;
run;

/* Calculating QA for scorecard period */
proc sql;
    create table QA_Score as
    select      a.Employee_number,
                b.QA_Period,
                b.Start_Date,
                b.End_date,
                SUM(Score_M)                            as QA_Score,
                sum(Evaluations2)                       as QA_Evaluations,
                round(SUM(Score_M) / sum(Evaluations), 0.01) as QA_Score_Perc
    from        Service_QA_Raw a
    inner join  Periods b
        on (a.date_stamp between b.Start_Date and b.End_date)
    group by    a.Employee_number, b.QA_Period, b.Start_Date, b.End_date;
quit;

/* Join QA score with the incentive multiplication factors */
proc sql;
    create table QA_FINAL as
    select *
    from        QA_Score a
    left join   QA_factors b
        on  (a.QA_Score_Perc between b.LB_QA and b.UP_QA)
        and (a.End_date between b.Start_date and b.End_date)
    order by a.End_date desc;
quit;

/* Fix conditions for those without a QA score percentage — assign 100 */
data QA_FINAL;
    set QA_FINAL;
    if QA_Score_Perc = . then do;
        QA_Score_Perc              = 100;
        Incentive_Factor_To_Be_Paid = 1;
    end;
run;


/* ---------------------------------------------------------------------------
   Calculating Earn: After QA
   --------------------------------------------------------------------------- */
%macro Final_Earn(Earn_Table, from_earn, QA);
proc sql;
    create table &Earn_Table as
    select      a.*,
                b.start_date,
                b.end_date,
                b.QA_Evaluations,
                b.QA_Score_Perc,
                b.Incentive_Factor_To_Be_Paid,
                a.Monthly_Earn_before_QA * b.Incentive_Factor_To_Be_Paid as Monthly_Earn_after_QA
    from        &from_earn a
    left join   &QA b
        /* FIX: strip() guards against trailing spaces in Employee_Number.
                input(put(...,date9.),date9.) forces both QA_Period values to a
                plain numeric date regardless of how each table stored the format,
                preventing silent mismatches that leave start_date/end_date/
                QA_Evaluations empty in the output. */
        on  strip(a.Employee_Number) = strip(b.Employee_Number)
        and input(put(a.QA_Period, date9.), date9.)
          = input(put(b.QA_Period, date9.), date9.)
    order by a.QA_Period desc;
quit;
%mend;
%Final_Earn(COMP_Final_Monthly_Earn, COMP_SER_Monthly_Earn_PreQA, QA_FINAL);
%Final_Earn(LOC_Final_Monthly_Earn,  LOC_SER_Monthly_Earn_PreQA,  QA_FINAL);

