ALTER PROCEDURE [dbo].[spdwhAssetsUnderAdvice_Fund_LevelWithFPMM_Fix]  
AS  
BEGIN 

TRUNCATE TABLE [PharosDataWarehouse].[dbo].[vAssetsUnderAdvice_Fund_LevelWithFPMM_Fix]

INSERT INTO [PharosDataWarehouse].[dbo].[vAssetsUnderAdvice_Fund_LevelWithFPMM_Fix]
SELECT DISTINCT
	[Period] = MarketValue.YearMonth
	, [Brand] = COALESCE(StaffDetails.Company, ClientDetails.Company)
	, [Region] = COALESCE(sp.ReportRegion, 'x-unallocated')
	--COALESCE(Region.Region, 'Unknown')
	,[Channel] = ''
	--, [Channel] = COALESCE(Umbr.Channel collate SQL_Latin1_General_CP1_CI_AS,StaffDetails.Office, ClientDetails.Office)
	, BrokerEntityID = PortfolioAssetSplit.BrokerEntityID
	, [Manager] = StaffDetails.FirstNames + ' ' + StaffDetails.Surname
	, FNumber = UPPER(REPLACE(StaffDetails.WindowsLogin,'FNBJNB01\',''))
	, StaffRole = CASE WHEN StaffDetails.FirstNames + ' ' + StaffDetails.Surname = 'Fpas Fpas Conservation' THEN 'Financial Adviser' ELSE sr.StaffRole END 
	, [ClientStartDate] = ClientDetails.CreatedDate
	, [ClientBrand] = ClientDetails.Company
	, [ClientChannel] = ClientDetails.Office
	, [Split] = PortfolioAssetSplit.SplitPercentage
	, [CoManager1] = CoManager.CoManager1
	, [CoManager2] = CoManager.CoManager2
	, [CountryOfRegistration] = ClientDetails.CountryOfRegistration
	, [ClientNumber] = ClientDetails.UserFriendlyCode
	, UCN = ClientDetails.UCN
	, [Client] = ClientDetails.EntityName
	, [FirstNames] = ClientDetails.FirstNames
	, [Surname] = ClientDetails.Surname
	, [EntityType] = ClientDetails.EntityType
	, [IDOrRegNumber] = CASE WHEN ClientDetails.EntityTypeL = 6 AND LEN(ClientDetails.SouthAfricanIDNumber) > 0 THEN ClientDetails.SouthAfricanIDNumber  
							 WHEN ClientDetails.EntityTypeL <> 6 THEN ClientDetails.RegistrationNumber 
						ELSE ClientDetails.PassportNumber END
	, [FeeMandateGroup] = CASE WHEN PortfolioDetails.[FeeMandate] IN ('Cash', 'Cash Mandate - SA IB Money Market(0.15%)', 'Cash Mandate - SA IB Short term(0.25%)', 'Cash Mandate - SA MA Income(0.45%)') THEN 'Cash'
							   WHEN PortfolioDetails.[FeeMandate] IN ('Discretionary Mandate', 'Discretionary Mandate (New)', 'Negotiated Fees 0.4%', 'Negotiated Fees 0.4%', 'Negotiated Fees 0.5%', 'Negotiated Fees 0.6%') THEN 'Discretionary'
							   WHEN PortfolioDetails.[FeeMandate] IS NULL THEN 'Broker Appointment'	ELSE 'x - unallocated' END
	, [FeeMandate] = PortfolioDetails.[FeeMandate]
	, ProductType = Product.InstrumentType
	, [ProductSupplier] = Product.InstrumentSupplier
	, [ProductSupplierCountry] = ProductSupplier.InstrumentSupplierCountry
	, [ContractNumber] = PortfolioDetails.ReferenceNumber
	, [InitialContributionAmount] = PortfolioDetails.InitialContributionAmount
	, [ProductName] = Product.InstrumentName
	, [FundSupplier] = Fund.InstrumentSupplier
	, [FundSupplierCountry] = FundSupplier.InstrumentSupplierCountry
	, [FundFamily] = COALESCE(Fund.InstrumentFamily, Fund.InstrumentName)
	, [ISIN] = Fund.ISINCode
	, [FundRegion] = CASE WHEN Fund.BaseCurrency = 'ZAR' THEN 'Domestic' ELSE 'Non Domestic' END
	, [FundCurrency] = Fund.BaseCurrency
	, [FundName] = Fund.InstrumentName
	, [FundBaseCurrency] = Fund.BaseCurrency
	, [ValueDate] = MarketValue.DateApplicable
	, [MarketValue] =  CASE WHEN Product.InstrumentType='Investment' THEN ( MarketValue.AmountConverted * COALESCE(PortfolioAssetSplit.SplitPercentage, 100) / 100 ) ELSE 0 END  
	, [MarketValueOriginalCurrency] = CASE WHEN Product.InstrumentType='Investment' THEN  ( (MarketValue.AmountConverted*MarketValue.ExchangeRate) * COALESCE(PortfolioAssetSplit.SplitPercentage, 100) / 100) ELSE 0 END  
	, [ExchangeRate] = CASE WHEN Product.InstrumentType='Investment' THEN MarketValue.ExchangeRate ELSE 0 END  
	, [Pricing] = FundPrice.FundCommissionPercentage
	, [PortfolioEntryID] = PortfolioDetails.PortfolioEntryID
	, [RootPortfolioEntryID] = PortfolioDetails.RootPortfolioEntryID
	, [EntityID] = PortfolioDetails.EntityID
	, [ManagerID] = StaffDetails.EntityID
	, [ProductSupplierID] = Product.InstrumentSupplierL
	, [ProductIntrumentCategory] = Product.InstrumentCategory
	, [FundInstrumentCategory] = Fund.InstrumentCategory
	, [Mandate] = PortfolioDetails.InvestmentMandate
	, [InceptionDate] = PortfolioDetails.DateBegin
	, [MaturityDate] = PortfolioDetails.DateEnd
	, [ProductID] = Product.InstrumentID
	, [FundID] = Fund.InstrumentID
	, [FundSupplierID] = Fund.InstrumentSupplierL
	, [JSECode] = Fund.JSECode
	, [HouseView] = CASE WHEN s.IsHouseview = 1 THEN 'HV'
						 WHEN s.IsHouseView = 0 THEN 'Non HV'
						 ELSE 'x-unallocated' END
	, [GroupOrThirdParty] = COALESCE(s.GroupOr3rdParty, 'x-unallocated')
	, [CashOrSolution] = COALESCE(s.CashOrSolution, 'x-unallocated')
	, [MasterFundName] = COALESCE(s.SecurityGroupName, 'x-unallocated')
	, [HouseViewGroup] = COALESCE(s.[HVvsNonHVvsTerminalvsLegacy], 'x-unallocated')
	, [LocalvsOffshore] = COALESCE(s.[LocalvsOffshore], 'x-unallocated')
	, [DateApplicable] = MarketValue.DateApplicable
	, [FeeGroupID] = fg.FeeGroupID
	, [FeeGroupMemberStartDate] = fg.CreatedDate
	, [PortfolioCreatedDate] = PortfolioDetails.CreatedDate
	, Int_Retail_Model_Desc= segs.Int_retail_model_Desc
	, Main_Banked = segs.Main_Banked
	, Household_Key = segs.Household_Key
	, Rundate  = getdate()
	----INTO dbo.AssetsUnderAdvice_Fund_LevelWithFPMMTemp 
FROM
	dbo.tempPortfolioDetails AS PortfolioDetails
	-- Product Details:
	----------------------------------------------------------------------------------------------------------------------------------
	LEFT JOIN
		dbo.tempInstrumentDetails AS Product WITH (NOLOCK)
	ON
		PortfolioDetails.RootInstrumentID = Product.InstrumentID

	 LEFT JOIN [dbo].[InstrumentSupplier] AS ProductSupplier WITH (NOLOCK)
			ON Product.InstrumentSupplierL = ProductSupplier.InstrumentSupplierL
	--------------------------------------------------------------------------------------------------------------------------------
	-- Market Value:
	--------------------------------------------------------------------------------------------------------------------------------
	INNER JOIN
		PharosDataWarehouse.dbo.tempPortfolioValues AS MarketValue WITH (NOLOCK)
	ON
		PortfolioDetails.PortfolioEntryID = MarketValue.PortfolioEntryID
	AND
		MarketValue.InforceStatusL = 5 	--InForce Only:
	AND
		MarketValue.ManagedStatusL = 5 --Managed Only:
	AND
		MarketValue.InstrumentValueTypeL = 5 --MarketValue Only:
--	AND
--		MarketValue.YearMonth BETWEEN @rptDateBegin AND @rptDateEnd
	AND
		((MarketValue.AmountConverted <> 0 AND Product.InstrumentType='Investment') OR Product.InstrumentType IN ('Risk','Other products','Medical aid','Short term insurance'))
	AND
		((MarketValue.AmountConverted IS NOT NULL AND Product.InstrumentType='Investment') OR Product.InstrumentType IN ('Risk','Other products','Medical aid','Short term insurance'))
	---------------------------------------------------------------------------------------------------------------------------------
	-- Pricing:
	---------------------------------------------------------------------------------------------------------------------------------
	LEFT JOIN
		PharosDataWarehouse.dbo.tempCommissionPerMonth AS FundPrice WITH (NOLOCK)
	ON
		MarketValue.PortfolioEntryID = FundPrice.PortfolioEntryID
	AND
		MarketValue.YearMonth = FundPrice.YearMonth
	--------------------------------------------------------------------------------------------------------------------------------
	-- Portfolio Split:
	--------------------------------------------------------------------------------------------------------------------------------
	LEFT JOIN
		[PharosDataWarehouse].[dbo].[tempPortfolioAssetSplit_Test] AS PortfolioAssetSplit WITH (NOLOCK)
	ON
		MarketValue.RootPortfolioEntryID = PortfolioAssetSplit.RootPortfolioEntryID
	AND
		MarketValue.YearMonth = PortfolioAssetSplit.YearMonth
	AND
		PortfolioAssetSplit.SplitPercentage IS NOT NULL
	--------------------------------------------------------------------------------------------------------------------------------
	--Staff Details:
	--------------------------------------------------------------------------------------------------------------------------------
	LEFT JOIN
		PharosDataWarehouse.dbo.[tempStaffDetails] AS StaffDetails WITH (NOLOCK)
	ON
		PortfolioAssetSplit.BrokerEntityID = StaffDetails.EntityID

	LEFT JOIN ( SELECT RelatedStaffEntityID,MAX(StaffRole) AS StaffRole
				FROM [dbo].[tempClientStaffRelationNew]
				WHERE IsBrokerRole = 1
				GROUP BY RelatedStaffEntityID ) sr
	ON 	PortfolioAssetSplit.BrokerEntityID = sr.RelatedStaffEntityID

	--------------------------------------------------------------------------------------------------------------------------------
	--Client Details:
	--------------------------------------------------------------------------------------------------------------------------------
	INNER JOIN ( SELECT
					ClientDetails.EntityID
					, ClientDetails.Class
					, ClientDetails.UserFriendlyCode
					, ClientDetails.CompanyL
					, ClientDetails.Company
					, ClientDetails.OfficeL
					, ClientDetails.Office
					, ClientDetails.EntityName
					, ClientDetails.FirstNames
					, ClientDetails.Surname
					, ClientDetails.RegistrationNumber
					, ClientDetails.PassportNumber
					, ClientDetails.SouthAfricanIDNumber
					, ClientDetails.CountryOfRegistration
					, ClientDetails.EntityTypeL
					, ClientDetails.EntityType
					, ClientDetails.CreatedDate
					, YEAR(ClientDetails.CreatedDate)*100 + MONTH(ClientDetails.CreatedDate) AS [CreatedYearMonth]
					, UCN
				 FROM dbo.tempEntityDetails AS ClientDetails 
				 WHERE
					 --Exclude FNB Trust Services:
					 ClientDetails.CompanyL <> 7) AS ClientDetails
		ON
				PortfolioDetails.EntityID = ClientDetails.EntityID

				--Segments
	LEFT JOIN [WIM_FA_Staging].[StagingIS].[Customer_Monthly_Segmentation] as segs
	ON
			ClientDetails.UCN collate SQL_Latin1_General_CP1_CI_AS=segs.CUST_NO collate SQL_Latin1_General_CP1_CI_AS
			--and MarketValue.YearMonth=segs.Year_Month
	----------------------------------------------------------------------------------------------------------------------------------

	----------------------------------------------------------------------------------------------------------------------------------
	-- Fund Details:
	----------------------------------------------------------------------------------------------------------------------------------
	LEFT JOIN
		dbo.tempInstrumentDetails AS Fund WITH (NOLOCK)
	ON
		PortfolioDetails.InstrumentID = Fund.InstrumentID

	 LEFT JOIN [dbo].[InstrumentSupplier] AS FundSupplier WITH (NOLOCK)
			ON Fund.InstrumentSupplierL = FundSupplier.InstrumentSupplierL
	----------------------------------------------------------------------------------------------------------------------------------
	--Region:
	----------------------------------------------------------------------------------------------------------------------------------
	--LEFT JOIN
	--	PharosDatawarehouse.dbo.fnChannelToRegion() AS Region
	--ON
	--	StaffDetails.OfficeL = Region.ChannelL
	 LEFT JOIN Investment_Analytics.dbo.SalesPerson sp ON CONVERT(varchar(36), PortfolioAssetSplit.BrokerEntityID) = sp.SalesPersonID
	----------------------------------------------------------------------------------------------------------------------------------
	--CoManager:
	----------------------------------------------------------------------------------------------------------------------------------
	 LEFT JOIN PharosDataWarehouse.dbo.vCoManager  AS CoManager WITH (NOLOCK)
			ON ClientDetails.EntityID = CoManager.EntityID

	-----------------------------------------------------------------------------------------------------------------------------------
	-- Mapping
	----------------------------------------------------------------------------------------------------------------------------------
	LEFT JOIN [Investment_Analytics].[Mapping].[Security] s ON Fund.InstrumentID = s.SecurityID

		-------------
	--- 2025-02-18 Umbrella is decomissioned, removing the Channel updates for now until needed
	-------- 
		
	--LEFT JOIN (select PEriod, fnumber, Channel from PID_Umbrella.dbo.vw_Employee) as Umbr
	--on UPPER(REPLACE(StaffDetails.WindowsLogin,'FNBJNB01\','')) collate SQL_Latin1_General_CP1_CI_AS =upper(Umbr.fnumber) collate SQL_Latin1_General_CP1_CI_AS
	--and Umbr.Period =MarketValue.YearMonth 

	--------------------------------------------------------------------------------------------------------------------------------
	--- Fee Group
	--------------------------------------------------------------------------------------------------------------------------------
	OUTER APPLY ( SELECT TOP 1 * FROM [PharosDataWarehouse].[dbo].[FeeGroupMember] ff WHERE PortfolioDetails.EntityID = ff.EntityID AND ff.DateDeleted IS NULL) fg

	WHERE MarketValue.YearMonth >= CAST(LEFT(CONVERT(VARCHAR, DATEADD(YY,-5,GETDATE()),112),6) AS INT)
	

