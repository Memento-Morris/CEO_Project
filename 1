        put "<tr><td style=""border:1px solid #e6d3ce;padding:6px 12px;"">Total agent payout this month</td><td style=""border:1px solid #e6d3ce;padding:6px 12px;text-align:right;font-weight:600;"">&total_agent_earn</td></tr>";
        put '</table>';

        put "Kind Regards<br>Morris";
        put '</body></html>';
    run;

    filename myemail email;
%MEND;
%email_agents;


