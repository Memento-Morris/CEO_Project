/* ============================================================================
   PART 9: QA FALLBACK — CURRENT MONTH QA NOT YET AVAILABLE
   Average QA_Score_Perc from Nov 2025 to Jan 2026 used as proxy for Mar 2026.
   Incentive_Factor_To_Be_Paid is derived from the averaged score via
   QA_factors using only the score band (LB_QA / UP_QA) — no date filter
   applied since we are deliberately using a historical average outside the
   current period. Agents with no QA history in the fallback window default
   to QA_Score_Perc = 100 and factor = 1.

   KEY FIX: QA_FINAL_Perioded now stamps every agent with OBR_Month_start_date
   as QA_Period directly — no sub-select against Periods with SC date bounds
   that previously returned zero rows. The %Final_Earn join has also been
   simplified to match on Employee_Number only, removing the QA_Period
   comparison that was silently failing and nulling all QA columns.
   ============================================================================ */

/* Step 1: Load raw QA source */
data Service_QA_Raw;
    set sti_pbi.Service_QA_Final;
    Evaluations2 = Evaluations;
    if score = . then evaluations = 0;
run;

/* Step 2: Aggregate to per-agent average over Nov 2025 – Jan 2026 */
proc sql;
    create table QA_Fallback_Avg as
    select      Employee_number,
                round(sum(Score_M) / sum(Evaluations), 0.01) as QA_Score_Perc,
                sum(Evaluations2)                             as QA_Evaluations,
                &QA_Fallback_start  as Fallback_Start   format date9.,
                &QA_Fallback_end    as Fallback_End     format date9.
    from        Service_QA_Raw
    where       date_stamp between &QA_Fallback_start and &QA_Fallback_end
    group by    Employee_number;
quit;

%put === Agents with fallback QA score ===;
proc sql;
    select count(*) as agents_with_fallback_QA from QA_Fallback_Avg;
quit;

/* Diagnostic: print the QA_factors table so we can confirm score bands exist */
%put === QA_factors contents ===;
proc sql;
    select * from QA_factors order by LB_QA;
quit;

/* Step 3: Look up incentive factor using ONLY the score band — no date filter */
proc sql;
    create table QA_FINAL as
    select      a.Employee_number,
                a.QA_Score_Perc,
                a.QA_Evaluations,
                a.Fallback_Start                as start_date   format date9.,
                a.Fallback_End                  as end_date     format date9.,
                b.Incentive_Factor_To_Be_Paid,
                'NOV25-JAN26 Avg'               as QA_Source
    from        QA_Fallback_Avg a
    left join   QA_factors b
        on  (a.QA_Score_Perc between b.LB_QA and b.UP_QA);
quit;

/* Diagnostic: confirm factors are populating correctly */
%put === QA_FINAL after factor join — sample ===;
proc sql;
    select Employee_number, QA_Score_Perc, Incentive_Factor_To_Be_Paid, QA_Source
    from QA_FINAL
    order by Employee_number;
quit;

/* Check how many still have a null factor after the fix */
proc sql;
    select count(*) as still_null_factor
    from QA_FINAL
    where Incentive_Factor_To_Be_Paid is null;
quit;

/* Step 4: Default any agent missing from the fallback window to 100% / factor 1 */
proc sql;
    create table QA_FINAL_Missing as
    select      strip(a.Employee_Number) as Employee_number,
                100                      as QA_Score_Perc,
                0                        as QA_Evaluations,
                &QA_Fallback_start       as start_date   format date9.,
                &QA_Fallback_end         as end_date     format date9.,
                1                        as Incentive_Factor_To_Be_Paid,
                'Default 100%'           as QA_Source
    from        COMP_SER_Monthly_Earn_PreQA a
    where strip(a.Employee_Number) not in
              (select strip(Employee_number) from QA_FINAL)
    union
    select      strip(a.Employee_Number),
                100, 0,
                &QA_Fallback_start,
                &QA_Fallback_end,
                1,
                'Default 100%'
    from        LOC_SER_Monthly_Earn_PreQA a
    where strip(a.Employee_Number) not in
              (select strip(Employee_number) from QA_FINAL);
quit;

/* Step 5: Combine matched and defaulted records */
data QA_FINAL;
    set QA_FINAL QA_FINAL_Missing;
run;

proc sql; drop table QA_FINAL_Missing; quit;

/* -----------------------------------------------------------------------
   FIX (Step 6): Stamp QA_Period directly from OBR_Month_start_date.
   Previously this used a sub-select filtering Periods where QA_Period
   was BETWEEN current_obr_period_start_date and current_obr_period_end_date.
   Because QA_Period in the Periods table is stored as month-start (24FEB2026)
   and current_obr_period_start_date = 02MAR2026, the filter returned zero
   rows — making QA_FINAL_Perioded empty and silently nulling all QA columns
   in the final table.  We now stamp every row with the known OBR period date
   directly, which is guaranteed to exist in the Periods table.
   ----------------------------------------------------------------------- */
proc sql;
    create table QA_FINAL_Perioded as
    select  a.*,
            &OBR_Month_start_date as QA_Period format date9.
    from    QA_FINAL a;
quit;

%put === QA_FINAL_Perioded — row count (should match agent count) ===;
proc sql; select count(*) as total_rows from QA_FINAL_Perioded; quit;

/* Confirm period and scores look correct */
proc sql;
    select Employee_number,
           QA_Period                    format date9.,
           QA_Score_Perc,
           Incentive_Factor_To_Be_Paid,
           QA_Source
    from QA_FINAL_Perioded
    order by Employee_number;
quit;


/* ---------------------------------------------------------------------------
   Calculating Earn: After QA — using fallback QA scores

   FIX: Join is now on Employee_Number only.
   The previous double join (Employee_Number AND QA_Period) was failing
   because QA_Period in the monthly earn tables is set from the Periods
   table via run_date, which resolves to 24FEB2026, but minor format
   differences or value mismatches caused the join to produce no matches
   even after the input(put()) casting. Removing the QA_Period condition
   is safe here because every agent has exactly one fallback QA row —
   there is no multi-period ambiguity to protect against.
   --------------------------------------------------------------------------- */
%macro Final_Earn(Earn_Table, from_earn, QA);
proc sql;
    create table &Earn_Table as
    select      a.*,
                b.start_date,
                b.end_date,
                b.QA_Evaluations,
                b.QA_Score_Perc,
                b.Incentive_Factor_To_Be_Paid,
                b.QA_Source,
                a.Monthly_Earn_before_QA * b.Incentive_Factor_To_Be_Paid
                    as Monthly_Earn_after_QA
    from        &from_earn a
    left join   &QA b
        on  strip(a.Employee_Number) = strip(b.Employee_number)
    order by a.QA_Period desc;
quit;
%mend;
%Final_Earn(COMP_Final_Monthly_Earn, COMP_SER_Monthly_Earn_PreQA, QA_FINAL_Perioded);
%Final_Earn(LOC_Final_Monthly_Earn,  LOC_SER_Monthly_Earn_PreQA,  QA_FINAL_Perioded);

data Sum_Earns_With_QA;
    set COMP_Final_Monthly_Earn LOC_Final_Monthly_Earn;
