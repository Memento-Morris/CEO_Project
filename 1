/* ============================================================
   SECTION 12 : COMBINE ADOBE DATA
   Uses APNS_sends_matched (campaign-scoped) instead of the
   original APNS_sends_campaigns to prevent cross-campaign bleed.
   ============================================================ */

data adobe_to_clients_step;
    length mucn                $28
           product_code        $29
           drop_reason         $50
           distribution_status $43
           answer              $815;
    set Adobe_recent_drops
        APNS_sends_matched;     /* FIX 1: matched sends, not raw sends */
run;

data adobe_to_clients_final (drop=etl_source_data etl_date daymonth);
    set adobe_to_clients_step;
    if drop_reason  = "" then success = 1; else success = 0;
    if drop_reason ne "" then drop    = 1; else drop    = 0;
run;


/* ============================================================
   SECTION 13 : OPTIMISE STEP
   ============================================================ */

data campaigns_to_adobe_step
    (keep=Optimize sub_segment Drop_reason product_code
          cust_no Date_to_adobe Time_created_to_adobe
          Campaign_Name mucn success_to_adobe drop_to_adobe);
    set CAMPAIGNS_TO_ADOBE;
    if drop_reason ne "" then optimize = drop_reason; else optimize = "Sent";
    if drop_reason  = "" then success_to_adobe = 1;   else success_to_adobe = 0;
    if drop_reason ne "" then drop_to_adobe    = 1;   else drop_to_adobe    = 0;
run;

data campaigns_to_adobe_renamed;
    set campaigns_to_adobe_step;
    rename Drop_Reason   = Drop_reason_to_adobe;
    rename mucn          = mucn_to_adobe;
    rename product_code  = product_code_to_adobe;
    rename Campaign_Name = Campaign_Name_to_adobe;
run;


/* ============================================================
   SECTION 14 : ADOBE CLASSIFICATION
   ============================================================ */

data adobe_to_clients_step2 (drop=success drop);
    length Adobe         $50
           Client        $50
           testindicator $6;
    set adobe_to_clients_final;
    if upcase(delivery_code) = "TEST"
        then Adobe = "TEST";
    else if delivery_code ne ""
        then Adobe = "Loaded";
    else
        Adobe = drop_reason;

    if upcase(delivery_code) = "TEST"
        then Client = "TEST";
    else if upcase(distribution_status) = "SENT"
        then Client = "Sent to Client";
    else if upcase(distribution_status) = "SENT TO THE SERVICE PROVIDER"
        then Client = "Sent to Provider";
    else if upcase(distribution_status) = "PENDING"
        then Client = "Pending";
    else if upcase(distribution_status) = "DELIVERY CANCELED"
        then Client = "Delivery Canceled";
    else
        Client = drop_reason;
run;

proc sql;
    create table adobe_delivery_test as
    select distinct cust_no, date_loaded, product_code,
                    "TEST" as testindicator
    from adobe_to_clients_step2
    where upcase(delivery_code) = "TEST";
quit;

proc sql;
    create table adobe_final_new as
    select a.*, b.testindicator
    from adobe_to_clients_step2 a
    left join adobe_delivery_test b
        on  a.cust_no      = b.cust_no
        and a.date_loaded  = b.date_loaded
        and a.product_code = b.product_code;
quit;

data adobe_final_table_clients;
    length testindicator $6;
    set adobe_final_new;
    if strip(testindicator) = "TEST" then do;
        testindicator = "TEST";
        Adobe         = "TEST";
        Client        = "TEST";
    end;
    else testindicator = "Actual";
    rename cust_no = cust_no2;
run;

proc sql noprint;
    select count(*) into :final_rows trimmed
    from adobe_final_table_clients;
quit;

%put Adobe final table rows: &final_rows;


/* ============================================================
   SECTION 15 : FINAL JOIN — OPTIMISE + ADOBE
   Optimise is the LEFT (master) table.
   Adobe enriches; it never adds rows.
   ============================================================ */

proc sql;
    create table joining as
    select *
    from campaigns_to_adobe_renamed a
    left join adobe_final_table_clients b
        on  a.cust_no               = b.cust_no2
        and a.product_code_to_adobe  = b.product_code
        and (b.date_loaded between a.date_to_adobe
                               and a.date_to_adobe + &adobe_load_window.);
quit;

data APN_POT_Step1
    (drop=Time product_code mucn mucn_to_adobe
          success_to_adobe drop_to_adobe);
    length Adobe  $50
           Client $50;
    set joining;

    if missing(cust_no2) and Optimize = "Sent"
        then Adobe = "Not loaded into Adobe within &adobe_load_window. days";
    if missing(cust_no2) and Optimize = "Sent"
        and intck('day', date_to_adobe, today()) <= &adobe_load_window.
        and missing(Date_loaded)
        then Adobe = "Sending to Adobe";

    date_Diff = intck('day', date_to_adobe, date_loaded);
run;

proc sort data=APN_POT_Step1;
    by cust_no product_code_to_adobe date_to_adobe descending date_loaded;
run;

proc sort data=APN_POT_Step1 nodupkey
    out=APN_POT_Final;
    by cust_no product_code_to_adobe date_to_adobe;
run;

data APN_POT;
    set APN_POT_Final;
run;

proc sql noprint;
    select count(*) into :pot_rows trimmed
    from APN_POT;
quit;

%put APN_POT rows: &pot_rows;

title "DEBUG 5 - APN_POT: Distribution by Campaign and Status";
proc sql;
    select Campaign_Name_to_adobe   as Campaign,
           Optimize,
           Adobe,
           Client,
           count(*) as Row_Count
    from APN_POT
    group by Campaign_Name_to_adobe, Optimize, Adobe, Client
    order by Campaign_Name_to_adobe, Optimize, Row_Count desc;
quit;
title;


/* ============================================================
   FIX 3 — DROPPED-BUT-LOADED DIAGNOSTIC
   -------------------------------------------------------
   Customers who were dropped by Optimise but still reached
   Adobe (Loaded) represent a process exception. This block
   quantifies them and — if they exceed the configured
   threshold — aborts the load.

   Set %let dropped_loaded_threshold = 0; for strict mode
   (any dropped-but-loaded record aborts).
   Set a positive number to allow a tolerance before aborting.
   ============================================================ */

proc sql noprint;
    create table diag_dropped_loaded as
    select
        Campaign_Name_to_adobe,
        product_code_to_adobe,
        Optimize                           as Optimise_Drop_Reason,
        Adobe,
        Client,
        count(*)                           as Record_Count
    from APN_POT
    where Optimize not in ("Sent")         /* Dropped by Optimise */
      and Adobe     in ("Loaded")          /* But still in Adobe  */
    group by 1, 2, 3, 4, 5
    order by Record_Count desc;

    select coalesce(sum(Record_Count), 0)
    into   :dropped_loaded_count trimmed
    from   diag_dropped_loaded;
quit;

%put NOTE: Dropped-but-Loaded records detected: &dropped_loaded_count;

%if &dropped_loaded_count > 0 %then %do;
    title "DIAGNOSTIC FIX 3 - Dropped by Optimise but Loaded into Adobe";
    proc print data=diag_dropped_loaded noobs; run;
    title;
%end;

%if &dropped_loaded_count > &dropped_loaded_threshold %then %do;
    %put ERROR: &dropped_loaded_count dropped-but-loaded records exceed threshold (&dropped_loaded_threshold).;
    %put ERROR: Review diag_dropped_loaded before proceeding.;
    %put ERROR: If these are expected (e.g. Adobe loaded before Optimise flagged), increase dropped_loaded_threshold.;
    %abort cancel;
%end;


/* ============================================================
   SECTION 15B : DISTINCT CUSTOMERS LOADED INTO ADOBE
   Scoped to Adobe="Loaded" rows only (Fix 2).
   This prevents the count bleeding onto dropped rows in
   the summary table.
   ============================================================ */

proc sql;
    create table cust_loaded_summary as
    select
        Campaign_Name_to_adobe,
        product_code_to_adobe,
        date_to_adobe                                       as Batch_Date,
        Optimize,
        Adobe,
        Client,
        count(distinct cust_no) as Loaded_Adobe
                                label = "Distinct Customers Loaded into Adobe"
    from APN_POT_Final
    where Adobe = "Loaded"                   /* FIX 2: only "Loaded" rows */
    group by Campaign_Name_to_adobe, product_code_to_adobe,
             date_to_adobe, Optimize, Adobe, Client;
quit;


/* ============================================================
   SECTION 15C : COMPLETE FUNNEL — FULL OPPORTUNITY TO OPEN
   -------------------------------------------------------
   Fix 15: The join from FULL_OPPORTUNITY to Optimise uses
   Product_Code as the primary anchor (most reliable), with
   Campaign_Code as a secondary filter applied via the
   product_campaign_map lookup built from config. Free-text
   Campaign_Name from SharePoint is too fragile to join on
   directly; product codes are controlled and unique per batch.

   Fix 10: All percentage calculations guarded against
   division-by-zero.

   Fix 16: Pre-Optimise orphan count (records in the input
   file that never reached Optimise) is included as a funnel
   stage so stakeholders can see the full drop-off picture.

   Fix 17: The Optimise product code in the left join subquery
   is normalised to match &product_code_strategy. If the input
   file uses BASE codes (<=8 chars) the Optimise code is
   truncated to 8 chars so both sides compare at the same
   level. This prevents silent join failures when stakeholders
   supply base codes rather than full variation+message codes.

   Fix 18: The Pre_Optimise_Orphans column previously used a
   correlated subquery that re-executed for every GROUP BY
   combination, stamping the same product-level count on every
   row and potentially double-counting. Replaced with a
   pre-aggregated table (orphan_counts) joined once on
   Product_Code — faster and logically correct.
   ============================================================ */

/* Fix 18: pre-aggregate orphan counts once before the funnel query */
proc sql;
    create table orphan_counts as
    select Product_Code,
           count(*) as Orphan_Count
    from FULL_OPPORTUNITY_ORPHANS
    group by Product_Code;
quit;

proc sql;
    create table COMPLETE_FUNNEL as
    select
        /* Use config-controlled Campaign_Code as the funnel label.
           Fall back to whatever Optimise recorded if no config match. */
        coalesce(m.Campaign_Code, b.Campaign_Name_to_adobe) as Campaign
                 length = 100 label = "Campaign",
        coalesce(a.Product_Code,  b.product_code_to_adobe)  as Product_Code
                 length = 29  label = "Product Code",

        /* Stage 0: Full upstream opportunity (stakeholder input file) */
        count(distinct a.unique_id)                          as Full_Opportunity
                 label = "Full Opportunity (Input File)",

        /* Pre-Optimise drop-off: Fix 18 — joined from pre-aggregated table,
           not a correlated subquery, to avoid per-row re-execution and
           incorrect repeated counts in a grouped result set.              */
        coalesce(o.Orphan_Count, 0)                          as Pre_Optimise_Orphans
                 label = "Pre-Optimise Drop-Off",

        /* Stage 1: Passed Optimise */
        count(distinct b.cust_no)                            as Passed_Optimise
                 label = "Passed Optimise",

        /* Stage 2: Loaded to Adobe */
        count(distinct c.cust_no2)                           as Loaded_to_Adobe
                 label = "Loaded to Adobe",

        /* Stage 3: Sent to Client */
        count(distinct
            case when d.Client = "Sent to Client"
                 then d.cust_no2 end)                        as Sent_to_Client
                 label = "Sent to Client",

        /* Stage 4: Opened */
        count(distinct
            case when d.answer is not null
                  and strip(d.answer) ne ""
                 then d.cust_no2 end)                        as Opened
                 label = "Opened",

        /* Import quality */
        sum(case when a.flag_missing_product_code = 1
                 then 1 else 0 end)                          as Import_Missing_Product
                 label = "Import: Missing Product Code",

        /* Fix 10: Division-by-zero-safe percentages */
        case when count(distinct a.unique_id) > 0
             then (count(distinct b.cust_no) /
                   count(distinct a.unique_id)) * 100
             else . end                                      as Pct_Passed_Optimise
                 format = 5.1 label = "% Passed Optimise",

        case when count(distinct b.cust_no) > 0
             then (count(distinct c.cust_no2) /
                   count(distinct b.cust_no)) * 100
             else . end                                      as Pct_Loaded_to_Adobe
                 format = 5.1 label = "% Loaded to Adobe",

        case when count(distinct c.cust_no2) > 0
             then (count(distinct
                       case when d.Client = "Sent to Client"
                            then d.cust_no2 end) /
                   count(distinct c.cust_no2)) * 100
             else . end                                      as Pct_Sent_to_Client
                 format = 5.1 label = "% Sent to Client",

        case when count(distinct
                        case when d.Client = "Sent to Client"
                             then d.cust_no2 end) > 0
             then (count(distinct
                       case when d.answer is not null
                             and strip(d.answer) ne ""
                            then d.cust_no2 end) /
                   count(distinct
                       case when d.Client = "Sent to Client"
                            then d.cust_no2 end)) * 100
             else . end                                      as Pct_Opened
                 format = 5.1 label = "% Opened"

    from FULL_OPPORTUNITY a

    /* Fix 15: join config map on Product_Code for a reliable Campaign_Code lookup */
    left join product_campaign_map m
        on  a.Product_Code = m.Product_Code

    /* Fix 18: join pre-aggregated orphan counts — one row per Product_Code */
    left join orphan_counts o
        on  coalesce(a.Product_Code, "") = coalesce(o.Product_Code, "")

    /* Left join to Optimise passed records.
       Fix 17: Optimise product code normalised to &product_code_strategy level
       so base-code input files match full-code Optimise records correctly.   */
    left join (
        select distinct cust_no,
            %if &product_code_strategy = BASE %then %do;
                upcase(strip(substr(product_code_to_adobe, 1, 8))) as product_code,
            %end;
            %else %do;
                upcase(strip(product_code_to_adobe))               as product_code,
            %end;
                        upcase(strip(Campaign_Name_to_adobe)) as Campaign_Name_to_adobe
        from campaigns_to_adobe_renamed
        where optimize = "Sent"
    ) b
        on  a.cust_no      = b.cust_no
        and a.Product_Code = b.product_code

    /* Left join to Adobe loaded records */
    left join (
        select distinct cust_no2,
                        upcase(strip(product_code)) as product_code
        from adobe_final_table_clients
        where Adobe = "Loaded"
    ) c
        on  coalesce(a.cust_no, b.cust_no) = c.cust_no2
        and coalesce(a.Product_Code, b.product_code) = c.product_code

    /* Left join to full client status */
    left join adobe_final_table_clients d
        on  coalesce(a.cust_no, b.cust_no) = d.cust_no2
        and coalesce(a.Product_Code, b.product_code) = d.product_code

    group by coalesce(m.Campaign_Code, b.Campaign_Name_to_adobe),
             coalesce(a.Product_Code,  b.product_code_to_adobe),
             coalesce(o.Orphan_Count, 0);
quit;

/* Human-readable funnel summary */
data COMPLETE_FUNNEL;
    set COMPLETE_FUNNEL;
    length Funnel_Summary $600;

    Drop_Off_Pre_Optimise    = Full_Opportunity - Passed_Optimise;
    Drop_Off_Before_Send     = Passed_Optimise  - Sent_to_Client;

    Funnel_Summary = cats(
        "Of ", Full_Opportunity, " leads: ",
        Pre_Optimise_Orphans, " never reached Optimise; ",
        Passed_Optimise, " (", put(Pct_Passed_Optimise, 5.1), "%) passed Optimise; ",
        Loaded_to_Adobe, " (", put(Pct_Loaded_to_Adobe, 5.1), "%) loaded to Adobe; ",
        Sent_to_Client, " (", put(Pct_Sent_to_Client, 5.1), "%) sent to client; ",
        Opened, " (", put(Pct_Opened, 5.1), "%) opened."
    );
run;

