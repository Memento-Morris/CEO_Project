sas/* Step 5: Append only the missing weeks using data step instead of INSERT INTO */
proc sql noprint;
    create table Kendall_Missing as
    select * from Kendall_Mismatch
    where run_date not in (select distinct run_date
                           from Servicing_Scores
                           where upcase(full_name) like '%KENDALL%MOHAMM%');
quit;

proc append base=Servicing_Scores data=Kendall_Missing force;
run;

proc sql; drop table Kendall_Missing; quit;
