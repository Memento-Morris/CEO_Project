/* ============================================================================
   KENDALL — VIEW ALL RECORDS ACROSS BOTH NAME SPELLINGS
   ============================================================================ */

proc sql;
    select EmployeeNumber, full_name, run_date, scorecard
    from STI_SC.Servicing_Scores
    where upcase(full_name) like '%KENDALL%'
      and run_date between &current_obr_period_start_date
                       and &current_obr_period_end_date
      and weekday(run_date) = 2
    order by full_name, run_date;
quit;
